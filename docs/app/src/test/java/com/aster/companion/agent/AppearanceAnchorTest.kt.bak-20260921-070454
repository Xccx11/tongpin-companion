package com.aster.companion.agent

import org.junit.Assert.assertEquals
import org.junit.Assert.assertTrue
import org.junit.Test

/**
 * 外貌锚点必须**一字不改**拼在提示词最前面。
 *
 * 为什么要用代码拼：krea2 要英文提示词，pass2 就得把用户的中文外貌档案译写一遍，
 * 而译写必然丢细节——实测 254 的出图里「22 岁」写成 `28-year-old`、整段妆容消失、腰肢/胸/臀全丢。
 */
class AppearanceAnchorTest {

    private val anchor = "一位22岁左右的东亚少女，鹅蛋脸，淡淡的腮红，淡润微红唇。"

    @Test
    fun `外貌原文拼在最前面且一字不改`() {
        val prompt = "She lies on a messy bed, soft light from the window."

        val composed = AppearanceAnchor.prepend(prompt, anchor)

        assertTrue(composed.startsWith(anchor))
        assertTrue(composed.endsWith(prompt))
        assertTrue(composed.contains("\n"))
    }

    @Test
    fun `已经拼过就不再重复`() {
        val once = AppearanceAnchor.prepend("She lies on a bed.", anchor)

        assertEquals(once, AppearanceAnchor.prepend(once, anchor))
    }

    @Test
    fun `外貌为空时原样返回`() {
        assertEquals("She lies on a bed.", AppearanceAnchor.prepend("She lies on a bed.", ""))
        assertEquals("", AppearanceAnchor.prepend("", ""))
    }

    @Test
    fun `提示词为空时只返回外貌`() {
        assertEquals(anchor, AppearanceAnchor.prepend("", anchor))
    }
}
