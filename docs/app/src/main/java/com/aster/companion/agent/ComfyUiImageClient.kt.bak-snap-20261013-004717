package com.aster.companion.agent

import android.content.Context
import android.net.Uri
import android.util.Log
import com.aster.R
import com.aster.companion.data.ModelProfileEntity
import dagger.hilt.android.qualifiers.ApplicationContext
import java.io.IOException
import java.util.UUID
import java.util.concurrent.TimeUnit
import javax.inject.Inject
import javax.inject.Singleton
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.delay
import kotlinx.coroutines.withContext
import kotlinx.serialization.json.Json
import kotlinx.serialization.json.JsonElement
import kotlinx.serialization.json.JsonObject
import kotlinx.serialization.json.JsonPrimitive
import kotlinx.serialization.json.buildJsonObject
import kotlinx.serialization.json.jsonObject
import kotlinx.serialization.json.jsonPrimitive
import kotlinx.serialization.json.put
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.MultipartBody
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody

/** Runs a selected, app-owned ComfyUI workflow without changing the Qwen workflow graph. */
@Singleton
class ComfyUiImageClient @Inject constructor(
    private val http: OkHttpClient,
    @ApplicationContext private val context: Context
) {
    data class Submission(val promptId: String)

    suspend fun generate(
        profile: ModelProfileEntity,
        prompt: String,
        identityReferenceUri: String? = null,
        styleReferenceUri: String? = null,
        existingPromptId: String? = null,
        onTaskCreated: suspend (String) -> Unit = {},
        shouldCancel: suspend () -> Boolean = { false }
    ): Result<String> = withContext(Dispatchers.IO) {
        runCatching {
            val submittedAt = System.currentTimeMillis()
            val promptId = if (existingPromptId != null) {
                existingPromptId
            } else {
                val submittedPromptId = submit(profile, prompt, identityReferenceUri, styleReferenceUri)
                    .getOrThrow()
                    .promptId
                onTaskCreated(submittedPromptId)
                submittedPromptId
            }
            Log.i(TAG, "stage=comfy_submit duration_ms=${System.currentTimeMillis() - submittedAt}")
            val renderStartedAt = System.currentTimeMillis()
            awaitOutput(profile, promptId, shouldCancel).getOrThrow().also {
                Log.i(TAG, "stage=comfy_render duration_ms=${System.currentTimeMillis() - renderStartedAt}")
            }
        }
    }

    /** Returns only after ComfyUI has accepted the prompt, so callers can persist its ID before polling. */
    suspend fun submit(
        profile: ModelProfileEntity,
        prompt: String,
        identityReferenceUri: String? = null,
        styleReferenceUri: String? = null
    ): Result<Submission> = withContext(Dispatchers.IO) {
        runCatching {
            val identityImage = identityReferenceUri?.takeIf(String::isNotBlank)?.let { uploadReference(profile, it) }
            val styleImage = styleReferenceUri?.takeIf(String::isNotBlank)?.let { uploadReference(profile, it) }
            val workflow = configuredWorkflow(profile, prompt, identityImage, styleImage)
            val payload = buildJsonObject {
                put("client_id", UUID.randomUUID().toString())
                put("prompt", workflow)
            }.toString()
            val request = Request.Builder()
                .url(ComfyUiProtocol.promptEndpoint(profile))
                .post(payload.toRequestBody(JSON))
                .build()
            val promptId = imageHttp(profile).newCall(request).execute().use { response ->
                val body = response.body?.string().orEmpty()
                check(response.isSuccessful) { error(response.code, body) }
                ComfyUiProtocol.promptId(body)
            }
            Submission(promptId)
        }
    }

    suspend fun awaitOutput(
        profile: ModelProfileEntity,
        promptId: String,
        shouldCancel: suspend () -> Boolean = { false }
    ): Result<String> = withContext(Dispatchers.IO) {
        runCatching { awaitOutputInternal(profile, promptId, shouldCancel) }
    }

    suspend fun cancel(profile: ModelProfileEntity, promptId: String): Result<Unit> = withContext(Dispatchers.IO) {
        runCatching {
            val payload = "{\"delete\":[\"$promptId\"]}"
            val request = Request.Builder()
                .url(ComfyUiProtocol.queueEndpoint(profile))
                .post(payload.toRequestBody(JSON))
                .build()
            imageHttp(profile).newCall(request).execute().use { response ->
                val body = response.body?.string().orEmpty()
                check(response.isSuccessful) { error(response.code, body) }
            }
        }
    }

    suspend fun test(profile: ModelProfileEntity): Result<String> = withContext(Dispatchers.IO) {
        runCatching {
            val request = Request.Builder().url(profile.baseUrl.trimEnd('/') + "/system_stats").get().build()
            imageHttp(profile).newCall(request).execute().use { response ->
                val body = response.body?.string().orEmpty()
                check(response.isSuccessful) { error(response.code, body) }
                "ComfyUI connected"
            }
        }
    }

    private fun uploadReference(profile: ModelProfileEntity, referenceUri: String): String {
        val uri = Uri.parse(referenceUri)
        val bytes = requireNotNull(context.contentResolver.openInputStream(uri)) { "Reference image is unavailable" }
            .use { it.readBytes() }
        val mime = context.contentResolver.getType(uri)?.takeIf { it.startsWith("image/") } ?: "image/png"
        val filename = "tongpin-reference-${UUID.randomUUID()}.png"
        val multipart = MultipartBody.Builder().setType(MultipartBody.FORM)
            .addFormDataPart("image", filename, bytes.toRequestBody(mime.toMediaType()))
            .addFormDataPart("overwrite", "false")
            .build()
        val request = Request.Builder().url(ComfyUiProtocol.uploadEndpoint(profile)).post(multipart).build()
        return imageHttp(profile).newCall(request).execute().use { response ->
            val body = response.body?.string().orEmpty()
            check(response.isSuccessful) { error(response.code, body) }
            Json.parseToJsonElement(body).jsonObject["name"]?.jsonPrimitive?.content
                ?: throw IllegalStateException("ComfyUI did not return an uploaded image name")
        }
    }

    private suspend fun awaitOutputInternal(
        profile: ModelProfileEntity,
        promptId: String,
        shouldCancel: suspend () -> Boolean
    ): String {
        // A queued ComfyUI prompt is durable. Never turn a slow sampler or a busy GPU
        // queue into a failed task just because the Android caller has waited a while.
        var transientFailures = 0
        while (true) {
            if (shouldCancel()) {
                cancel(profile, promptId)
                throw ImageTaskCancelledException(promptId)
            }
            delay(POLL_INTERVAL_MS)
            val history = try {
                val request = Request.Builder().url(ComfyUiProtocol.historyEndpoint(profile, promptId)).get().build()
                pollingHttp().newCall(request).execute().use { response ->
                    val body = response.body?.string().orEmpty()
                    check(response.isSuccessful) { error(response.code, body) }
                    body
                }.also {
                    transientFailures = 0
                }
            } catch (failure: Throwable) {
                if (!failure.isTransientPollFailure()) throw failure
                transientFailures += 1
                Log.w(TAG, "stage=comfy_poll_retry prompt_id=$promptId attempt=$transientFailures", failure)
                delay(ImagePollingRetryPolicy.retryDelayMillis(transientFailures - 1))
                continue
            }
            runCatching { ComfyUiProtocol.outputImageUrl(profile, promptId, history) }.getOrNull()?.let { return it }
            check(!ComfyUiProtocol.isFailed(promptId, history)) { "ComfyUI image task failed" }
        }
    }


    private fun configuredWorkflow(
        profile: ModelProfileEntity,
        prompt: String,
        identityImage: String?,
        styleImage: String?
    ): JsonObject {
        val selectedWorkflow = ComfyUiProtocol.workflow(profile)
        val resourceId = when (selectedWorkflow) {
            ComfyUiWorkflow.QWEN_IMAGE_EDIT -> R.raw.comfy_qwen_image_edit_2509
            ComfyUiWorkflow.ILLUSTRIOUS_XL_REFERENCE -> R.raw.comfy_illustrious_xl_reference
        }
        val template = context.resources.openRawResource(resourceId)
            .bufferedReader().use { Json.parseToJsonElement(it.readText()).jsonObject }
        var configured = template.replaceInput("435", "value", JsonPrimitive(prompt))
        if (selectedWorkflow == ComfyUiWorkflow.QWEN_IMAGE_EDIT) {
            val identity = identityImage ?: throw IllegalStateException("Qwen Image Edit requires a reference image")
            configured = configured.replaceInput("78", "image", JsonPrimitive(identity))
            configured = if (styleImage == null) {
                configured.removeInput("433:110", "image2").removeInput("433:111", "image2")
            } else {
                configured
                    .replaceInput("79", "image", JsonPrimitive(styleImage))
                    .replaceInput("433:110", "image2", imageLink("79"))
                    .replaceInput("433:111", "image2", imageLink("79"))
            }
        } else if (identityImage == null) {
            configured = configured
                .removeNode("78")
                .removeNode("80")
                .removeNode("10")
                .removeNode("79")
                .removeNode("94")
                .removeNode("95")
                .replaceInput("3", "model", imageLink("4"))
                .replaceInput("3", "denoise", JsonPrimitive(1.0))
                .addEmptyLatent("empty_latent", width = 768, height = 1024)
                .replaceInput("3", "latent_image", imageLink("empty_latent"))
        } else {
            configured = configured.replaceInput("78", "image", JsonPrimitive(identityImage))
            configured = if (styleImage == null) {
                configured
                    .replaceInput("3", "model", imageLink("4"))
                    .removeNode("95")
                    .removeNode("94")
                    .removeNode("79")
            } else {
                configured.replaceInput("79", "image", JsonPrimitive(styleImage))
            }
        }
        return configured
    }

    private fun imageLink(nodeId: String): JsonElement = Json.parseToJsonElement("[\"$nodeId\",0]")

    private fun JsonObject.replaceInput(nodeId: String, inputName: String, value: JsonElement): JsonObject {
        val node = get(nodeId)?.jsonObject ?: throw IllegalStateException("ComfyUI workflow node $nodeId is missing")
        val inputs = node["inputs"]?.jsonObject?.toMutableMap()
            ?: throw IllegalStateException("ComfyUI workflow node $nodeId has no inputs")
        inputs[inputName] = value
        val updatedNode = node.toMutableMap().apply { put("inputs", JsonObject(inputs)) }
        return toMutableMap().apply { put(nodeId, JsonObject(updatedNode)) }.let(::JsonObject)
    }

    private fun JsonObject.removeInput(nodeId: String, inputName: String): JsonObject {
        val node = get(nodeId)?.jsonObject ?: throw IllegalStateException("ComfyUI workflow node $nodeId is missing")
        val inputs = node["inputs"]?.jsonObject?.toMutableMap()
            ?: throw IllegalStateException("ComfyUI workflow node $nodeId has no inputs")
        inputs.remove(inputName)
        val updatedNode = node.toMutableMap().apply { put("inputs", JsonObject(inputs)) }
        return toMutableMap().apply { put(nodeId, JsonObject(updatedNode)) }.let(::JsonObject)
    }

    private fun JsonObject.removeNode(nodeId: String): JsonObject =
        toMutableMap().apply { remove(nodeId) }.let(::JsonObject)

    private fun JsonObject.addEmptyLatent(nodeId: String, width: Int, height: Int): JsonObject =
        toMutableMap().apply {
            put(
                nodeId,
                buildJsonObject {
                    put("inputs", buildJsonObject {
                        put("width", width)
                        put("height", height)
                        put("batch_size", 1)
                    })
                    put("class_type", "EmptyLatentImage")
                }
            )
        }.let(::JsonObject)

    private fun imageHttp(profile: ModelProfileEntity): OkHttpClient = http.newBuilder()
        // Submission/upload calls may be slow; render duration is handled by pollingHttp().
        .readTimeout(profile.timeoutSeconds.coerceIn(300, 600).toLong(), TimeUnit.SECONDS)
        .writeTimeout(profile.timeoutSeconds.coerceIn(300, 600).toLong(), TimeUnit.SECONDS)
        .build()

    private fun pollingHttp(): OkHttpClient = http.newBuilder()
        .connectTimeout(POLL_CONNECT_TIMEOUT_MS, TimeUnit.SECONDS)
        .readTimeout(POLL_READ_TIMEOUT_MS, TimeUnit.SECONDS)
        .writeTimeout(POLL_READ_TIMEOUT_MS, TimeUnit.SECONDS)
        .build()

    private fun Throwable.isTransientPollFailure(): Boolean =
        this is IOException || ImagePollingRetryPolicy.isTransientMessage(message)

    private fun error(code: Int, body: String): String = when (code) {
        400 -> "ComfyUI rejected the unchanged workflow or input image"
        404 -> "ComfyUI address or API endpoint was not found"
        else -> "ComfyUI HTTP $code"
    }

    private companion object {
        val JSON = "application/json; charset=utf-8".toMediaType()
        const val POLL_INTERVAL_MS = 1_000L
        const val POLL_CONNECT_TIMEOUT_MS = 8L
        const val POLL_READ_TIMEOUT_MS = 10L
        const val TAG = "TongpinImageTiming"
    }
}
