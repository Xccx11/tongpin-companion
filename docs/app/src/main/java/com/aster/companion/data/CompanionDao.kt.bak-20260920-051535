    @Transaction
    suspend fun deleteThreadAndAssociatedData(threadId: String) {
        deleteGroupDerivedSemanticMemories(threadId)
        deleteGroupDerivedMemoryLinks(threadId)
        deleteFamilyGroupFacts(threadId)
        deleteGroupMemberStates(threadId)
        deleteGroupSettings(threadId)
        deleteGroupPrivateFollowUpUses(threadId)
        deleteMessages(threadId)
        deleteThreadMemories(threadId)
        deleteThreadDiaryPhotos(threadId)
        deleteAgentTurnsForThread(threadId)
        deletePendingActionsForThread(threadId)
        deleteThreadTimeline(threadId)
        deleteThreadSemanticMemories(threadId)
        deleteThreadDurableTasks(threadId)
        deleteThreadAgentRuns(threadId)
        deleteThreadSharedWorld(threadId)
        deleteParticipants(threadId)
        deleteThread(threadId)
    }

    @Transaction
    suspend fun deletePrivateFriendAndAssociatedData(threadId: String, characterId: String?) {
        deleteThreadAndAssociatedData(threadId)
        if (characterId != null) {
            deleteCharacterMemories(characterId)
            deleteCharacterDiaryPhotos(characterId)
            deleteEventRecipientsForCharacter(characterId)
            deleteCharacterTimeline(characterId)
            deleteCharacterSemanticMemories(characterId)
            deleteCharacterDurableTasks(characterId)
            deleteCharacterAgentRuns(characterId)
            deleteCharacterWorldStates(characterId)
            deleteGroupPrivateFollowUpUsesForCharacter(characterId)
            deleteCharacterParticipants(characterId)
            deleteCharacter(characterId)
        }
        deleteOrphanThreads()
    }

    @Transaction
    suspend fun clearThreadConversationContext(threadId: String, clearedAt: Long) {
        deleteGroupDerivedSemanticMemories(threadId)
        deleteGroupDerivedMemoryLinks(threadId)
        deleteFamilyGroupFacts(threadId)
        deleteGroupMemberStates(threadId)
        deleteGroupPrivateFollowUpUses(threadId)
        consumePendingRecipientsForThread(threadId, clearedAt)
        deleteMessages(threadId)
        deleteThreadMemories(threadId)
        deleteThreadDiaryPhotos(threadId)
        deleteAgentTurnsForThread(threadId)
        deletePendingActionsForThread(threadId)
        deleteThreadTimeline(threadId)
        deleteThreadSemanticMemories(threadId)
        deleteThreadDurableTasks(threadId)
        deleteThreadAgentRuns(threadId)
        deleteThreadSharedWorld(threadId)
        deleteThreadWorldStates(threadId)
        deleteThreadSummaries(threadId)
        resetThreadContext(threadId, clearedAt)
    }

    /**
     * 「清除聊天记录」：把角色的**状态类**数据一次清成全新状态，不只是「不记得对话」。
     * 性格推演、自主生活数值、目标、决策链、活动轨迹、互动请求、群内状态、未来时间线、
     * 朋友圈（含媒体/点赞/评论）、日记照片、世界状态、此刻状态全部归零。
     *
     * 刻意不动：`companion_characters`（角色本体）、`companion_messages` / `companion_threads`
     * （对话本身由 [clearThreadConversationContext] 处理）、`companion_relationships`
     * （她与其他角色的关系是别的角色的资产）、`companion_family_group_facts`（家庭事实）。
     */
    @Transaction
    suspend fun resetCharacterToFreshState(characterId: String) {
        deleteCharacterLifeState(characterId)
        deleteCharacterPersonality(characterId)
        deleteCharacterGoals(characterId)
        deleteCharacterDecisionChains(characterId)
        deleteCharacterActivities(characterId)
        deleteCharacterInteractionRequests(characterId)
        deleteCharacterGroupMemberStates(characterId)
        deleteCharacterFutureTimelines(characterId)
        // 先删帖子的子行，再删帖子本身。
        deleteCharacterMomentMedia(characterId)
        deleteCharacterMomentReactions(characterId)
        deleteCharacterMomentComments(characterId)
        deleteCharacterMomentPosts(characterId)
        deleteCharacterDiaryPhotos(characterId)
        deleteCharacterWorldStates(characterId)
        deleteCharacterLivingState(characterId)
    }

    @Transaction
    suspend fun deleteMomentPostAndAssociatedData(postId: String) {
        deleteMomentMedia(postId)
        deleteMomentReactions(postId)
        deleteMomentComments(postId)
        deleteMomentPost(postId)
    }

