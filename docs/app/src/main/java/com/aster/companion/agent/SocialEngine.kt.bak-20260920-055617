package com.aster.companion.agent

import com.aster.companion.data.CompanionDao
import com.aster.companion.data.InteractionRequestEntity
import com.aster.companion.domain.ActionLibrary
import com.aster.companion.domain.CharacterNeed
import com.aster.companion.domain.NeedEvaluator
import java.util.UUID
import javax.inject.Inject
import javax.inject.Singleton

/**
 * v2.1 社交行为引擎：需求 → 找目标 → 候选行为 → DeepSeek 决策 → 互动请求。
 * 代码负责候选与状态；DeepSeek 只从候选中选择（不创造剧情）。
 */
@Singleton
class SocialEngine @Inject constructor(
    private val dao: CompanionDao,
    private val client: OpenAiCompatibleClient,
    private val secretCipher: com.aster.companion.data.CompanionSecretCipher,
    private val cognitionEngine: CharacterCognitionEngine
) {
    /** 互动请求过期时长（30 分钟）。 */

    /**
     * 对单个角色跑一轮社交决策：有超阈值需求 → 找同家庭群成员 → 候选 → DeepSeek 选择 → 建请求。
     */
    suspend fun evaluateSocial(characterId: String, now: Long) {
        val character = dao.character(characterId) ?: return
        val life = dao.lifeState(characterId) ?: return
        val living = dao.livingState(characterId)
        // 睡眠/重要任务中不社交
        if (living?.sleepUntil?.let { now < it } == true) return
        val freeTime = living == null || !living.currentActivity.contains("工作") && !living.currentActivity.contains("学习")
        // 关系条件：读五维关系的亲密度 → 关系距离（affection 越高距离越近 → 越倾向社交）
        val familyIds = familyMemberIds(characterId)
        val relationshipDistance = familyIds.firstNotNullOfOrNull { targetId ->
            dao.relationship(characterId, targetId)?.let { rel -> (100 - rel.affection).coerceIn(0, 100) }
        } ?: 40
        val needs = NeedEvaluator.evaluate(
            state = life,
            relationshipDistance = relationshipDistance,
            freeTime = freeTime,
            familyNearby = familyIds.isNotEmpty()
        )
        val need = needs.firstOrNull() ?: return
        // 已有 pending 请求不重复
        if (dao.pendingInteractionRequests(now).any { it.senderCharacterId == characterId }) return
        val targets = familyIds
        val target = targets.firstOrNull() ?: return
        val candidates = ActionLibrary.candidatesFor(need.type)
        if (candidates.isEmpty()) return
        val result = cognitionEngine.cognize(
            characterId = characterId,
            candidates = candidates,
            triggerContext = "你产生了${need.type}需求（${need.reason}），家里${dao.character(target)?.name ?: "家人"}在附近。"
        )
        val decision = result?.let { Decision(it.action, it.finalReason) } ?: return
        // 记录心理摘要（不保存完整思考过程）
        runCatching { cognitionEngine.recordSummary(characterId, result, now) }
        dao.upsertInteractionRequest(
            InteractionRequestEntity(
                id = "interact:${UUID.randomUUID()}",
                senderCharacterId = characterId,
                receiverCharacterId = target,
                action = decision.action,
                reason = decision.reason,
                status = "pending",
                expireAt = now + REQUEST_TTL_MS,
                createdAt = now,
                updatedAt = now
            )
        )
    }

    private suspend fun familyMemberIds(characterId: String): List<String> {
        // 该角色所在家庭群的其他成员
        return dao.allThreads()
            .filter { it.type == com.aster.companion.domain.ConversationType.GROUP }
            .filter { dao.groupSettings(it.id)?.groupType == "FAMILY" }
            .filter { dao.participantIds(it.id).contains(characterId) }
            .flatMap { dao.participantIds(it.id) }
            .filter { it != characterId }
            .distinct()
    }

    private data class Decision(val action: String, val reason: String)

    companion object {
        const val REQUEST_TTL_MS = 30 * 60 * 1000L
    }
}
