/** Owns action confirmation and append-only redacted audit records. */
@Singleton
class CompanionActionCoordinator @Inject constructor(
    private val dao: CompanionDao,
    private val repository: CompanionRepository,
    private val shizuku: ShizukuFixedActionRouter,
    private val shizukuStatus: ShizukuStatusProvider,
    private val imageGeneration: ImageGenerationCoordinator,
    @ApplicationContext private val context: Context,
    private val timeline: CompanionTimelineRecorder,
    private val durableTasks: DurableTaskStore,
    private val imageQueue: GlobalImageGenerationQueue,
    private val groupReactions: GroupProactiveTurnCoordinator,
    private val notificationPublisher: CompanionNotificationPublisher
) {
    private companion object {
        const val TAG = "TongpinCrossChat"
    }

    private val backgroundScope = CoroutineScope(SupervisorJob() + Dispatchers.IO)

    /** Image generation is a long-running companion action and must not block the chat reply. */
    fun submitInBackground(eventId: String?, threadId: String?, request: AgentActionRequest) {
        backgroundScope.launch { submit(eventId, threadId, request) }
    }

    suspend fun submit(eventId: String?, threadId: String?, request: AgentActionRequest): String {
        val effectiveThreadId = if (request.capabilityId == "companion.propose_private_image") {
            val sourceGroup = if (threadId != null) dao.thread(threadId) else null
            val characterId = sourceGroup
                ?.takeIf { it.type == ConversationType.GROUP }
                ?.let { PrivateImageActionPolicy.targetCharacterId(request, dao.participantIds(it.id).toSet()) }
            if (characterId == null) {
                val error = "Character cannot send a private image from this conversation"
                audit("rejected", request.capabilityId, request.transport.name, request.confirmation.name, error)
                threadId?.let { appendVerifiedResult(it, request.capabilityId, request.arguments, ShizukuActionResult(false, error)) }
                return UUID.randomUUID().toString()
            }
            repository.ensurePrivateThread(characterId).id
        } else threadId
        ActionTransportPolicy.errorFor(request.capabilityId, request.transport, shizukuStatus.current(shizuku.isCommandChannelAlive).ready)?.let { error ->
            audit("rejected", request.capabilityId, request.transport.name, request.confirmation.name, error)
            effectiveThreadId?.let { appendVerifiedResult(it, request.capabilityId, request.arguments, ShizukuActionResult(false, error)) }
            return UUID.randomUUID().toString()
        }
        ActionRequestValidator.errorFor(request.capabilityId, request.arguments)?.let { error ->
            audit("rejected", request.capabilityId, request.transport.name, request.confirmation.name, error)
            effectiveThreadId?.let { appendVerifiedResult(it, request.capabilityId, request.arguments, ShizukuActionResult(false, error)) }
            return UUID.randomUUID().toString()
        }
        if (isImageGeneration(request.capabilityId) && effectiveThreadId != null && dao.thread(effectiveThreadId)?.type == ConversationType.GROUP &&
            run {
                val members = dao.participantIds(effectiveThreadId).toSet()
                val participants = GroupImagePromptPolicy.parseParticipantIds(request.arguments["participant_character_ids"], members)
                participants == null || GroupImagePromptPolicy.resolveMode(request.arguments["group_image_mode"], participants) == null
            }
        ) {
            val error = "Group image participants are invalid"
            audit("rejected", request.capabilityId, request.transport.name, request.confirmation.name, error)
            appendVerifiedResult(effectiveThreadId, request.capabilityId, request.arguments, ShizukuActionResult(false, error))
            return UUID.randomUUID().toString()
        }
        val action = PendingActionEntity(
            id = UUID.randomUUID().toString(), eventId = eventId, threadId = effectiveThreadId,
            capabilityId = request.capabilityId, transport = request.transport.name,
            argumentsJson = encodeArguments(request.arguments),
            state = "PENDING", createdAt = System.currentTimeMillis(), resolvedAt = null, resultSummary = null
        )
        if (request.confirmation == ConfirmationRequirement.REQUIRED) {
            dao.upsertPendingAction(action)
            return action.id
        }
        if (isImageGeneration(request.capabilityId)) {
            dao.upsertPendingAction(action.copy(state = ImageGenerationTaskState.RUNNING))
            durableTasks.enqueue("image_generation:${action.id}", threadId, request.arguments["character_id"], action.id)
            if (!ImageGenerationService.start(context, action.id)) runImageGeneration(action.id)
            return action.id
        }
        val result = execute(request.capabilityId, request.arguments, effectiveThreadId)
        recordToolResultSafely(effectiveThreadId, request.capabilityId, result.summary)
        auditSafely("agent", request.capabilityId, request.transport.name, "NONE", result.summary)
        effectiveThreadId?.let { appendVerifiedResultSafely(it, request.capabilityId, request.arguments, result) }
        return action.id
    }

    suspend fun approve(actionId: String) {
        val action = dao.pendingAction(actionId) ?: return
        val arguments = decodeArguments(action.argumentsJson)
        ActionRequestValidator.errorFor(action.capabilityId, arguments)?.let { error ->
            dao.resolvePendingAction(actionId, "FAILED", System.currentTimeMillis(), error)
            audit("rejected", action.capabilityId, action.transport, "REQUIRED", error)
            action.threadId?.let { threadId ->
                appendVerifiedResult(threadId, action.capabilityId, arguments, ShizukuActionResult(false, error))
            }
            return
        }
        if (isImageGeneration(action.capabilityId)) {
            dao.markPendingActionRunning(actionId, ImageGenerationTaskState.afterApproval())
            durableTasks.enqueue("image_generation:${action.id}", action.threadId, arguments["character_id"], action.id)
            if (!ImageGenerationService.start(context, actionId)) runImageGeneration(actionId)
            return
        }
        val result = execute(action.capabilityId, arguments, action.threadId, action.id)
        recordToolResultSafely(action.threadId, action.capabilityId, result.summary)
        dao.resolvePendingAction(actionId, if (result.success) "APPROVED" else "FAILED", System.currentTimeMillis(), result.summary)
        auditSafely("confirmed", action.capabilityId, action.transport, "REQUIRED", result.summary)
        action.threadId?.let { threadId -> appendVerifiedResultSafely(threadId, action.capabilityId, arguments, result) }
    }

    suspend fun reject(actionId: String) {
        val action = dao.pendingAction(actionId) ?: return
        dao.resolvePendingAction(actionId, "REJECTED", System.currentTimeMillis(), "Rejected by user")
        audit("rejected", action.capabilityId, action.transport, "REQUIRED", "Rejected by user")
    }

    /** Retries a terminal image task as a new provider request while preserving its chat context. */
    suspend fun retryImage(actionId: String) {
        restartImage(actionId) { ImageGenerationRetryPolicy.canRetry(it) }
    }

    /**
     * 「重新生成」：**正在生成中也允许** —— 用户按这个按钮的意思就是"这次不要了，重开一版"。
     *
     * 与 [cancelImage] 的区别（很重要，别合并）：
     * - **不**把 action 打成 CANCELLED：那是终态，`ImageGenerationCancellationPolicy` 里写死了
     *   "a cancelled image action is terminal and must never be revived by recovery"；
     * - **不**改写聊天里的占位消息（"已取消这次照片生成。" 是"取消"的语义，不是"重开"）；
     * - 先让供应商停掉当前这次、取消它的 durable task，再用**同一份请求**重跑一遍。
     */
    suspend fun regenerateImage(actionId: String) {
        val action = dao.pendingAction(actionId) ?: return
        if (!ImageGenerationRegeneratePolicy.canRegenerate(action)) return
        val now = System.currentTimeMillis()
        dao.durableTaskByType("image_generation:$actionId")?.let { durableTasks.cancel(it, now) }
        imageGeneration.cancelProviderTasks(action)
        // 等正在跑的这次真的收尾，再重开。
        // 原因：OpenAiCompatibleClient 对「同一 baseUrl + 尺寸 + 提示词」有一个复用闸
        // （submitImageOnce），旧的那次还没退出就重提，新提交会 await 到旧的（已取消的）结果，
        // 表现成"按了重新生成却什么都没发生"。图片轮询约 2 秒一拍，等它看到取消并把旧提交收掉。
        kotlinx.coroutines.delay(3_000L)
        restartImage(actionId) { ImageGenerationRegeneratePolicy.canRegenerate(it) }
    }

    /** retry / regenerate 的共同部分：清掉上一轮的供应商任务号，标回 RUNNING，重新入队并启动。 */
    private suspend fun restartImage(
        actionId: String,
        allowed: (com.aster.companion.data.PendingActionEntity) -> Boolean
    ) {
        val action = dao.pendingAction(actionId) ?: return
        if (!allowed(action)) return
        val arguments = ImageGenerationRetryPolicy.cleanArgumentsForRetry(decodeArguments(action.argumentsJson))
        dao.updatePendingActionArguments(actionId, encodeArguments(arguments))
        dao.markPendingActionRunning(actionId, ImageGenerationTaskState.RUNNING)
        durableTasks.enqueue("image_generation:${action.id}", action.threadId, arguments["character_id"], action.id)
        if (!ImageGenerationService.start(context, actionId)) runImageGeneration(actionId)
    }

    /** Cancels the durable action first, then asks the selected provider to stop any known task. */
    /** 生成流程兜底：标记任务失败（Service 捕获到未预期异常时调用，避免进程闪退）。 */
    suspend fun markImageGenerationFailed(actionId: String) {
        dao.resolvePendingAction(actionId, "FAILED", System.currentTimeMillis(), "生成过程发生异常，请重试")
    }

    suspend fun cancelImage(actionId: String) {
        val action = dao.pendingAction(actionId) ?: return
        if (!ImageGenerationCancellationPolicy.canCancel(action)) return
        val now = System.currentTimeMillis()
        dao.resolvePendingAction(actionId, "CANCELLED", now, "Cancelled by user")
        dao.durableTaskByType("image_generation:$actionId")?.let { durableTasks.cancel(it, now) }
        // 取消就**删掉**占位消息，不要改写成「已取消这次照片生成。」——用户要求取消后聊天里什么都别留。
        dao.imagePlaceholderMessages(actionId).forEach { message -> dao.deleteMessage(message.id) }
        if (ImageGenerationCancellationPolicy.shouldMarkMomentPostCancelled(action.capabilityId)) {
            val arguments = decodeArguments(action.argumentsJson)
            arguments["post_id"]?.takeIf(String::isNotBlank)?.let { postId ->
                repository.updateMoment(postId, arguments["body"].orEmpty(), com.aster.companion.domain.MomentActors.STATUS_FAILED)
            }
        }
        imageGeneration.cancelProviderTasks(action)
        auditSafely("image_generation", action.capabilityId, action.transport, "CANCELLED", "Cancelled by user")
    }

    /** Runs from the short-lived foreground service after the task is persisted. */
    suspend fun runImageGeneration(actionId: String) {
        val action = dao.pendingAction(actionId) ?: return
        if (!isImageGeneration(action.capabilityId) || !ImageGenerationCancellationPolicy.shouldResume(action.state)) return
        if (action.state == ImageGenerationTaskState.RETRYING) {
            val durableTask = dao.durableTaskByType("image_generation:$actionId")
            if (durableTask != null && durableTask.nextRunAt > System.currentTimeMillis()) return
        }
        imageQueue.run(actionId) {
            val durableTask = dao.durableTaskByType("image_generation:$actionId")
            durableTask?.let { durableTasks.markRunning(it) }
            val arguments = decodeArguments(action.argumentsJson)
            val result = try {
                execute(action.capabilityId, arguments, action.threadId, action.id)
            } catch (_: com.aster.companion.agent.ImageTaskCancelledException) {
                return@run
            }
            if (dao.pendingAction(actionId)?.state == "CANCELLED") return@run
            recordToolResultSafely(action.threadId, action.capabilityId, result.summary)
            val latestTask = dao.durableTaskByType("image_generation:$actionId")
            if (result.success) {
                dao.resolvePendingAction(actionId, "APPROVED", System.currentTimeMillis(), result.summary)
                latestTask?.let { durableTasks.complete(it) }
            } else {
                // 不自动重发：出图失败/超时就停在失败态，由用户手动重试。
                // 以前这里会置 RETRYING 交给 durable 调度器重跑，于是同一条生图提示词被反复提交。
                dao.resolvePendingAction(actionId, "FAILED", System.currentTimeMillis(), result.summary)
                latestTask?.let { durableTasks.complete(it) }
            }
            auditSafely("image_generation", action.capabilityId, action.transport, action.state, result.summary)
        }
    }

    suspend fun shouldContinueImageTracking(actionId: String): Boolean {
        val action = dao.pendingAction(actionId) ?: return false
        return isImageGeneration(action.capabilityId) && ImageGenerationCancellationPolicy.shouldResume(action.state)
    }

    /**
     * 关掉自动续跑：不再把"中断/失败"的出图任务自动重新跑一遍（只按用户当前这次请求来）。
     * 保留方法签名给调用方，行为是空操作。
     */
    @Suppress("UNUSED_PARAMETER")
    suspend fun resumeInterruptedImageActions() = Unit

    /** 同上：到期也不自动重跑出图任务。 */
    @Suppress("UNUSED_PARAMETER")
    suspend fun resumeDueImageActions(actionIds: List<String>) = Unit

    private suspend fun execute(capability: String, args: Map<String, String>, threadId: String?, actionId: String? = null): ShizukuActionResult {
        return when (capability) {
        "companion.send_private_message" -> {
            // 家庭模式禁止角色私聊
            val senderId = args["character_id"]
            val inFamily = !senderId.isNullOrBlank() && runCatching {
                dao.allThreads().any { group ->
                    group.type == com.aster.companion.domain.ConversationType.GROUP &&
                        dao.participantIds(group.id).contains(senderId) &&
                        dao.groupSettings(group.id)?.groupType == "FAMILY"
                }
            }.getOrDefault(false)
            if (inFamily) return ShizukuActionResult(false, "家庭模式禁止角色私聊")
            val sourceThread = threadId?.let { id -> dao.thread(id) }
                ?: return ShizukuActionResult(false, "Missing source group")
            val characterId = args["character_id"] ?: return ShizukuActionResult(false, "Missing character_id")
            val body = args["message"]?.trim()?.takeIf(String::isNotBlank)
                ?: return ShizukuActionResult(false, "Missing private message")
            if (sourceThread.type != ConversationType.GROUP || characterId !in dao.participantIds(sourceThread.id)) {
                return ShizukuActionResult(false, "Character cannot send a private message from this conversation")
            }
            val privateThread = repository.ensurePrivateThread(characterId)
            val message = com.aster.companion.data.MessageEntity(
                UUID.randomUUID().toString(), privateThread.id, characterId, body, null, false, System.currentTimeMillis()
            )
            dao.insertMessage(message)
            dao.touchThread(privateThread.id, message.createdAt)
            recordMessageSafely(message, "private")
            Log.i(TAG, "private_message delivered source=group target_private=true character_valid=true")
            ShizukuActionResult(true, "Private message sent")
        }
        "companion.send_group_message" -> {
            val sourceThread = threadId?.let { id -> dao.thread(id) }
                ?: return ShizukuActionResult(false, "Missing source private chat")
            val characterId = args["character_id"] ?: return ShizukuActionResult(false, "Missing character_id")
            val groupThreadId = args["group_thread_id"] ?: return ShizukuActionResult(false, "Missing group_thread_id")
            val body = args["message"]?.trim()?.takeIf(String::isNotBlank)
                ?: return ShizukuActionResult(false, "Missing group message")
            val targetGroup = dao.thread(groupThreadId)
            if (sourceThread.type != ConversationType.PRIVATE || targetGroup?.type != ConversationType.GROUP ||
                characterId !in dao.participantIds(sourceThread.id) || characterId !in dao.participantIds(groupThreadId)) {
                return ShizukuActionResult(false, "Character cannot send a group message to this conversation")
            }
            val message = com.aster.companion.data.MessageEntity(
                UUID.randomUUID().toString(), groupThreadId, characterId, body, null, false, System.currentTimeMillis()
            )
            dao.insertMessage(message)
            dao.touchThread(groupThreadId, message.createdAt)
            recordMessageSafely(message, "group")
            Log.i(TAG, "group_message delivered source=private target_group=true character_valid=true")
            backgroundScope.launch {
                runCatching { groupReactions.reactToCrossConversationMessage(groupThreadId, message.id) }
                    .onFailure { error -> Log.w(TAG, "group_message_reaction_failed", error) }
            }
            ShizukuActionResult(true, "Group message sent")
        }
        "companion.generate_moment_image" -> {
            val characterId = args["character_id"] ?: return ShizukuActionResult(false, "Missing character_id")
            val postId = args["post_id"] ?: return ShizukuActionResult(false, "Missing post_id")
            val post = dao.momentPost(postId) ?: return ShizukuActionResult(false, "Moment post unavailable")
            val scene = args["scene"]?.trim().orEmpty()
            if (scene.isBlank()) return ShizukuActionResult(false, "Missing moment scene")
            val result = imageGeneration.generateStandaloneImage(
                characterId,
                scene,
                actionId ?: UUID.randomUUID().toString(),
                args["size"]
            )
            result.fold(
                onSuccess = { uri ->
                    repository.addMomentMedia(postId, uri, MomentActors.SOURCE_GENERATED)
                    repository.updateMoment(postId, args["body"]?.ifBlank { post.body } ?: post.body, MomentActors.STATUS_PUBLISHED)
                    notificationPublisher.publishMoment(dao.character(characterId)?.name ?: "角色", post.body, postId)
                    ShizukuActionResult(true, "Moment image published")
                },
                onFailure = { error ->
                    repository.updateMoment(postId, args["body"]?.ifBlank { post.body } ?: post.body, MomentActors.STATUS_FAILED)
                    ShizukuActionResult(false, error.message ?: "Moment image failed")
                }
            )
        }
        "companion.generate_image", "companion.propose_image", "companion.propose_private_image", "companion.share_life_moment" -> {
            val characterId = args["character_id"] ?: return ShizukuActionResult(false, "Missing character_id")
            val targetThread = threadId ?: return ShizukuActionResult(false, "Missing conversation")
            // 归属校验：该角色必须属于目标线程（纵深防御，防 argumentsJson 被篡改）
            if (characterId.isNotBlank() && dao.participantIds(targetThread).none { it == characterId }) {
                return ShizukuActionResult(false, "Character does not belong to this conversation")
            }
            val targetType = dao.thread(targetThread)?.type
            val result = if (targetType == ConversationType.GROUP) {
                val participantIds = GroupImagePromptPolicy.parseParticipantIds(
                    args["participant_character_ids"],
                    dao.participantIds(targetThread).toSet()
                ) ?: return ShizukuActionResult(false, "Group image participants are invalid")
                val mode = GroupImagePromptPolicy.resolveMode(args["group_image_mode"], participantIds)
                    ?: return ShizukuActionResult(false, "Group image mode is invalid")
                imageGeneration.generateForGroup(
                    targetThread,
                    characterId,
                    participantIds,
                    args["scene"].orEmpty(),
                    actionId ?: UUID.randomUUID().toString(),
                    mode,
                    args["size"]
                )
            } else {
                imageGeneration.generateForCharacter(
                    targetThread,
                    characterId,
                    args["scene"].orEmpty(),
                    actionId ?: UUID.randomUUID().toString(),
                    args["size"]
                )
            }
            when (result) {
                is ImageGenerationResult.Generated -> ShizukuActionResult(true, "Image sent by character")
                ImageGenerationResult.ModelNotConfigured -> ShizukuActionResult(false, "Image model is not configured")
                is ImageGenerationResult.Failed -> ShizukuActionResult(false, result.reason)
            }
        }
        "device.read_battery" -> shizuku.readBattery()
        "device.read_foreground_app" -> shizuku.readForegroundApp()
        "device.set_alarm" -> shizuku.setAlarm(args["hour"]?.toIntOrNull() ?: -1, args["minute"]?.toIntOrNull() ?: -1)
        "app.open_known" -> {
            val packageName = args["package_name"] ?: return ShizukuActionResult(false, "Missing package_name")
            shizuku.openKnownApp(packageName)
        }
        "phone.dial" -> {
            val phoneNumber = args["phone_number"] ?: return ShizukuActionResult(false, "Missing phone_number")
            shizuku.dial(phoneNumber)
        }
        "sms.compose" -> {
            val phoneNumber = args["phone_number"] ?: return ShizukuActionResult(false, "Missing phone_number")
            shizuku.composeSms(phoneNumber)
        }
            else -> ShizukuActionResult(false, "Unsupported capability")
        }
    }

    private fun isImageGeneration(capabilityId: String): Boolean =
        capabilityId == "companion.generate_image" || capabilityId == "companion.propose_image" || capabilityId == "companion.propose_private_image" || capabilityId == "companion.generate_moment_image" || capabilityId == "companion.share_life_moment"

    private suspend fun audit(source: String, capability: String, transport: String, confirmation: String, summary: String) {
        dao.insertAudit(ActionAuditEntity(UUID.randomUUID().toString(), source, capability, transport, confirmation, summary.take(1_024), System.currentTimeMillis()))
    }

    /** A message that has reached its target conversation must never be reclassified as failed because observability failed. */
    private suspend fun recordMessageSafely(message: com.aster.companion.data.MessageEntity, direction: String) {
        runCatching { timeline.recordMessage(message) }
            .onFailure { error -> Log.w(TAG, "${direction}_message timeline_record_failed", error) }
    }

    private suspend fun recordToolResultSafely(threadId: String?, capabilityId: String, summary: String) {
        runCatching {
            timeline.recordToolResult(
                threadId,
                threadId?.let { dao.participantIds(it).firstOrNull() },
                capabilityId,
                summary
            )
        }.onFailure { error -> Log.w(TAG, "tool_result_record_failed capability=$capabilityId", error) }
    }

    private suspend fun auditSafely(source: String, capability: String, transport: String, confirmation: String, summary: String) {
        runCatching { audit(source, capability, transport, confirmation, summary) }
            .onFailure { error -> Log.w(TAG, "audit_record_failed capability=$capability", error) }
    }

    private suspend fun appendVerifiedResultSafely(
        threadId: String,
        capabilityId: String,
        arguments: Map<String, String>,
        result: ShizukuActionResult
    ) {
        runCatching { appendVerifiedResult(threadId, capabilityId, arguments, result) }
            .onFailure { error -> Log.w(TAG, "source_receipt_failed capability=$capabilityId success=${result.success}", error) }
    }

    private suspend fun appendVerifiedResult(
        threadId: String,
        capabilityId: String,
        arguments: Map<String, String>,
        result: ShizukuActionResult
    ) {
        val characterId = dao.participantIds(threadId).firstOrNull() ?: return
        val body = when (capabilityId) {
            "companion.send_private_message", "companion.send_group_message" -> {
                if (result.success) return
                CrossConversationMessageReceipt.failure(capabilityId)
            }
            "device.set_alarm" -> if (result.success) {
                val hour = arguments["hour"]?.padStart(2, '0') ?: "--"
                val minute = arguments["minute"]?.padStart(2, '0') ?: "--"
                "好了，$hour:$minute 的闹钟已经真的设好了。"
            } else CompanionActionMessagePolicy.failure(capabilityId)
            "app.open_known" -> if (result.success) "已经帮你打开了。" else CompanionActionMessagePolicy.failure(capabilityId)
            "phone.dial" -> if (result.success) "拨号界面已经打开了。" else CompanionActionMessagePolicy.failure(capabilityId)
            "sms.compose" -> if (result.success) "短信界面已经打开了。" else CompanionActionMessagePolicy.failure(capabilityId)
            "device.read_battery" -> if (result.success) DeviceReadResultFormatter.battery(result.summary) else "我刚才没有读到你这台手机的电量。"
            "device.read_foreground_app" -> if (result.success) DeviceReadResultFormatter.foregroundApp(result.summary) else "我刚才没有读到你当前正在用的应用。"
            "companion.generate_image", "companion.propose_image" -> if (result.success) return else CompanionActionMessagePolicy.failure(capabilityId)
            else -> return
        }
        val now = System.currentTimeMillis()
        val message = com.aster.companion.data.MessageEntity(UUID.randomUUID().toString(), threadId, characterId, body, null, false, now)
        dao.insertMessage(message)
        timeline.recordMessage(message)
        dao.touchThread(threadId, now)
    }

    private fun encodeArguments(arguments: Map<String, String>): String = buildJsonObject {
        arguments.forEach { (key, value) -> put(key, value) }
    }.toString()

    private fun decodeArguments(raw: String): Map<String, String> = runCatching {
        Json.parseToJsonElement(raw).jsonObject
            .mapNotNull { (key, value) ->
                val content: String? = value.jsonPrimitive.contentOrNull
                if (content == null) null else key to content
            }
            .toMap()
    }.getOrDefault(emptyMap())
}

private object DeviceReadResultFormatter {
    private val batteryLevel = Regex("(?m)^\\s*level:\\s*(\\d+)")
    private val batteryStatus = Regex("(?m)^\\s*status:\\s*(\\d+)")

    fun battery(raw: String): String {
        val level = batteryLevel.find(raw)?.groupValues?.getOrNull(1)
        val suffix = when (batteryStatus.find(raw)?.groupValues?.getOrNull(1)) {
            "2" -> "，正在充电"
            "5" -> "，已经充满"
            else -> ""
        }
        return if (level != null) "我刚看了，你这台手机现在是 $level%$suffix。" else "我刚读到了电量状态，但没能解析出具体百分比。"
    }

    fun foregroundApp(raw: String): String = "我刚读取了你当前手机的前台应用：${raw.lineSequence().firstOrNull { it.isNotBlank() }?.take(120) ?: "暂时无法识别"}"
}

/** Validates the fixed action schema before an action can reach the user confirmation queue. */
object ActionRequestValidator {
    fun errorFor(capabilityId: String, arguments: Map<String, String>): String? = when (capabilityId) {
        "device.read_battery", "device.read_foreground_app" -> null
        "companion.send_private_message" -> if (arguments["character_id"].isNullOrBlank() || arguments["message"].isNullOrBlank()) "Invalid private message" else null
        "companion.send_group_message" -> if (arguments["character_id"].isNullOrBlank() || arguments["group_thread_id"].isNullOrBlank() || arguments["message"].isNullOrBlank()) "Invalid group message" else null
        "app.open_known" -> if (arguments["package_name"]?.let(PackageNamePolicy::isAllowed) == true) null else "Invalid package_name"
        "phone.dial", "sms.compose" -> if (arguments["phone_number"]?.let(PhoneNumberPolicy::isAllowed) == true) null else "Invalid phone_number"
        "device.set_alarm" -> if (arguments["hour"]?.toIntOrNull() in 0..23 && arguments["minute"]?.toIntOrNull() in 0..59) null else "Invalid alarm time"
        "companion.generate_image", "companion.propose_image", "companion.propose_private_image", "companion.share_life_moment" -> if (arguments["scene"]?.let { it.isNotBlank() && it.length <= 4_000 && ComfyUiEnglishPromptPolicy.isAcceptable(it) } == true) null else "Invalid scene: non-empty prompt required"
        "companion.generate_moment_image" -> if (arguments["character_id"].isNullOrBlank() || arguments["post_id"].isNullOrBlank()) "Invalid moment target" else if (arguments["scene"]?.let { it.isNotBlank() && it.length <= 4_000 && ComfyUiEnglishPromptPolicy.isAcceptable(it) } == true) null else "Invalid scene: non-empty prompt required"
        else -> "Unsupported capability"
    }
}

/** Enforces the fixed routing table before a request can enter the confirmation queue. */
object ActionTransportPolicy {
    fun errorFor(capabilityId: String, transport: ActionTransport, shizukuReady: Boolean): String? {
        val expected = when (capabilityId) {
            "companion.send_private_message", "companion.send_group_message", "companion.generate_image", "companion.propose_image", "companion.propose_private_image", "companion.generate_moment_image", "companion.share_life_moment" -> ActionTransport.LOCAL
            "device.read_battery", "device.read_foreground_app", "device.set_alarm", "app.open_known", "phone.dial", "sms.compose" -> ActionTransport.SHIZUKU
            else -> return "Unsupported capability"
        }
        if (transport != expected) return "Invalid action transport"
        if (expected == ActionTransport.SHIZUKU && !shizukuReady) return "Shizuku is unavailable"
        return null
    }
}
