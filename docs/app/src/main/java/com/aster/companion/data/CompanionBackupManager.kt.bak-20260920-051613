package com.aster.companion.data

import androidx.room.withTransaction
import com.aster.companion.domain.ConversationType
import com.aster.companion.domain.MemoryKind
import com.aster.companion.media.CompanionPrivateImageStore
import android.util.Base64
import kotlinx.serialization.Serializable
import kotlinx.serialization.json.Json
import java.io.InputStream
import java.io.OutputStream
import javax.inject.Inject
import javax.inject.Singleton

@Serializable
private data class CompanionBackup(
    val version: Int = 2,
    val createdAt: Long,
    val characters: List<BackupCharacter>,
    val threads: List<BackupThread>,
    val participants: List<BackupParticipant>,
    val messages: List<BackupMessage>,
    val memories: List<BackupMemory>,
    val diaryPhotos: List<BackupDiaryPhoto> = emptyList(),
    val momentPosts: List<BackupMomentPost> = emptyList(),
    val momentMedia: List<BackupMomentMedia> = emptyList(),
    val momentReactions: List<BackupMomentReaction> = emptyList(),
    val momentComments: List<BackupMomentComment> = emptyList(),
    val assets: List<BackupAsset> = emptyList()
)

@Serializable private data class BackupCharacter(val id: String, val name: String, val avatarUri: String? = null, val personalityPrompt: String, val appearancePrompt: String, val referenceImageUri: String?, val createdAt: Long, val updatedAt: Long, val styleReferenceImageUri: String? = null, val relationshipPrompt: String = "")
@Serializable private data class BackupThread(val id: String, val type: String, val title: String, val createdAt: Long, val updatedAt: Long)
@Serializable private data class BackupParticipant(val threadId: String, val characterId: String, val ordinal: Int)
@Serializable private data class BackupMessage(val id: String, val threadId: String, val characterId: String?, val body: String, val imageUri: String?, val fromUser: Boolean, val createdAt: Long)
@Serializable private data class BackupMemory(val id: String, val characterId: String?, val threadId: String?, val kind: String, val content: String, val blockedFromMention: Boolean, val createdAt: Long, val updatedAt: Long)
@Serializable private data class BackupDiaryPhoto(val id: String, val characterId: String, val threadId: String, val imageUri: String, val createdAt: Long)
@Serializable private data class BackupMomentPost(val id: String, val authorType: String, val authorCharacterId: String?, val body: String, val visibility: String, val source: String, val status: String, val createdAt: Long, val updatedAt: Long)
@Serializable private data class BackupMomentMedia(val postId: String, val ordinal: Int, val imageUri: String, val source: String)
@Serializable private data class BackupMomentReaction(val postId: String, val actorType: String, val actorId: String, val kind: String, val createdAt: Long)
@Serializable private data class BackupMomentComment(val id: String, val postId: String, val authorType: String, val authorCharacterId: String?, val body: String, val replyToCommentId: String?, val createdAt: Long)
@Serializable private data class BackupAsset(val sourceUri: String, val contentType: String, val bytesBase64: String)

/** Exports only companion content. Model profiles and every API key are intentionally excluded. */
@Singleton
class CompanionBackupManager @Inject constructor(
    private val database: CompanionDatabase,
    private val dao: CompanionDao,
    private val cipher: CompanionBackupCipher = CompanionBackupCipher(),
    private val privateImageStore: CompanionPrivateImageStore
) {
    suspend fun export(output: OutputStream, password: String) {
        val imageUris = imageUrisForBackup()
        require(imageUris.size <= MAX_ASSETS) { "Backup contains too many images" }
        val assets = imageUris.map { sourceUri ->
            val image = privateImageStore.read(sourceUri).getOrThrow()
            BackupAsset(sourceUri, image.contentType, Base64.encodeToString(image.bytes, Base64.NO_WRAP))
        }
        val payload = CompanionBackup(
            createdAt = System.currentTimeMillis(),
            characters = dao.allCharacters().map { BackupCharacter(it.id, it.name, it.avatarUri, it.personalityPrompt, it.appearancePrompt, it.referenceImageUri, it.createdAt, it.updatedAt, it.styleReferenceImageUri, it.relationshipPrompt) },
            threads = dao.allThreads().map { BackupThread(it.id, it.type.name, it.title, it.createdAt, it.updatedAt) },
            participants = dao.allParticipants().map { BackupParticipant(it.threadId, it.characterId, it.ordinal) },
            messages = dao.allMessages().map { BackupMessage(it.id, it.threadId, it.characterId, it.body, it.imageUri, it.fromUser, it.createdAt) },
            memories = dao.allMemories().map { BackupMemory(it.id, it.characterId, it.threadId, it.kind.name, it.content, it.blockedFromMention, it.createdAt, it.updatedAt) },
            diaryPhotos = dao.allDiaryPhotos().map { BackupDiaryPhoto(it.id, it.characterId, it.threadId, it.imageUri, it.createdAt) },
            momentPosts = dao.allMomentPosts().map { BackupMomentPost(it.id, it.authorType, it.authorCharacterId, it.body, it.visibility, it.source, it.status, it.createdAt, it.updatedAt) },
            momentMedia = dao.allMomentMedia().map { BackupMomentMedia(it.postId, it.ordinal, it.imageUri, it.source) },
            momentReactions = dao.allMomentReactions().map { BackupMomentReaction(it.postId, it.actorType, it.actorId, it.kind, it.createdAt) },
            momentComments = dao.allMomentComments().map { BackupMomentComment(it.id, it.postId, it.authorType, it.authorCharacterId, it.body, it.replyToCommentId, it.createdAt) },
            assets = assets
        )
        output.use { it.write(cipher.encrypt(json.encodeToString(CompanionBackup.serializer(), payload).toByteArray(Charsets.UTF_8), password)) }
    }

    suspend fun import(input: InputStream, password: String) {
        val backup = json.decodeFromString(CompanionBackup.serializer(), cipher.decrypt(input.use { it.readBytes() }, password).toString(Charsets.UTF_8))
        require(backup.version in 1..2) { "Unsupported backup version" }
        require(backup.characters.size <= MAX_ITEMS && backup.threads.size <= MAX_ITEMS && backup.messages.size <= MAX_ITEMS * 100) { "Backup is too large" }
        require(backup.assets.size <= MAX_ASSETS) { "Backup contains too many images" }
        val restoredAssets = backup.assets.associate { asset ->
            val bytes = Base64.decode(asset.bytesBase64, Base64.DEFAULT)
            privateImageStore.save(bytes.inputStream(), asset.contentType).getOrThrow().let { asset.sourceUri to it }
        }
        fun resolve(uri: String?): String? = uri?.let { restoredAssets[it] ?: it }
        database.withTransaction {
            backup.characters.forEach { dao.upsertCharacter(CharacterEntity(it.id, it.name, resolve(it.avatarUri), it.personalityPrompt, it.appearancePrompt, resolve(it.referenceImageUri), it.createdAt, it.updatedAt, resolve(it.styleReferenceImageUri), it.relationshipPrompt)) }
            backup.threads.forEach { dao.upsertThread(ThreadEntity(it.id, ConversationType.valueOf(it.type), it.title, it.createdAt, it.updatedAt)) }
            backup.participants.forEach { dao.upsertParticipant(ThreadParticipantEntity(it.threadId, it.characterId, it.ordinal)) }
            backup.messages.forEach { dao.insertMessage(MessageEntity(it.id, it.threadId, it.characterId, it.body, resolve(it.imageUri), it.fromUser, it.createdAt)) }
            backup.memories.forEach { dao.upsertMemory(MemoryEntity(it.id, it.characterId, it.threadId, MemoryKind.valueOf(it.kind), it.content, it.blockedFromMention, it.createdAt, it.updatedAt)) }
            backup.diaryPhotos.forEach { dao.insertDiaryPhoto(DiaryPhotoEntity(it.id, it.characterId, it.threadId, resolve(it.imageUri) ?: it.imageUri, it.createdAt)) }
            backup.momentPosts.forEach { dao.upsertMomentPost(MomentPostEntity(it.id, it.authorType, it.authorCharacterId, it.body, it.visibility, it.source, it.status, it.createdAt, it.updatedAt)) }
            backup.momentMedia.forEach { dao.upsertMomentMedia(MomentMediaEntity(it.postId, it.ordinal, resolve(it.imageUri) ?: it.imageUri, it.source)) }
            backup.momentReactions.forEach { dao.upsertMomentReaction(MomentReactionEntity(it.postId, it.actorType, it.actorId, it.kind, it.createdAt)) }
            backup.momentComments.forEach { dao.insertMomentComment(MomentCommentEntity(it.id, it.postId, it.authorType, it.authorCharacterId, it.body, it.replyToCommentId, it.createdAt)) }
        }
    }

    private suspend fun imageUrisForBackup(): List<String> = buildList {
        dao.allCharacters().forEach { character ->
            listOfNotNull(character.avatarUri, character.referenceImageUri, character.styleReferenceImageUri).forEach(::add)
        }
        dao.allMessages().mapNotNullTo(this) { it.imageUri }
        dao.allDiaryPhotos().mapTo(this) { it.imageUri }
        dao.allMomentMedia().mapTo(this) { it.imageUri }
    }.filter(String::isNotBlank).distinct()

    private companion object {
        val json = Json { ignoreUnknownKeys = false }
        const val MAX_ITEMS = 10_000
        const val MAX_ASSETS = 2_000
    }
}
