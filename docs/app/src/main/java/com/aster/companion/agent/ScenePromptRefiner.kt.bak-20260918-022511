package com.aster.companion.agent

/**
 * Scene 递进细化（第 2、3 轮）的规则与提示词组装。
 *
 * 第 2 轮做的是**形态改写**：把第 1 轮那段画面描述改写成规则要求的提示词形态
 * （英文 Danbooru 标签串 / 自然语言长句），并在改写时把细节写得更**具体**
 * （材质、颜色、形状、尺寸、状态、角度、方向、质感）；第 3 轮在此基础上再细一层。
 * 人物、地点、动作、服饰、光线、风格、构图一律不许换，也不许新增或删掉画面元素。
 * 输出形态由 [system] 按 [ScenePromptFormat] 写死，改写不能把英文改成中文。
 */
object ScenePromptRefiner {

    /**
     * 单轮细化结果的字符数上限；超了按不合格处理，沿用上一轮。
     *
     * 留得宽是必须的：第 2 轮要把第 1 轮的叙述**改写成极度详细的 Danbooru 标签串**，
     * 上限卡在 1_500 时它必然超限被判 `too_long` 丢弃，出图只能退回第 1 轮的叙述——
     * 第 2 轮的规则写得再细也用不上。这个值必须**低于** `ComfyTagPromptPolicy.MAX_LENGTH`（最终入队校验），
     * 否则第 2 轮刚通过、末段校验又把它拦下来。
     */
    const val MAX_CHARS = 4_000

    /** 第 [pass] 轮（2 或 3）的规则：网关上取不到对应 key 时用这份内置默认。 */
    fun defaultRule(format: ScenePromptFormat, pass: Int): String = when (format) {
        ScenePromptFormat.NATURAL_LANGUAGE, ScenePromptFormat.ENGLISH_NATURAL,
        ScenePromptFormat.CHINESE_NATURAL ->
            if (pass <= 2) NATURAL_PASS2 else NATURAL_PASS3
        else -> if (pass <= 2) TAGS_PASS2 else TAGS_PASS3
    }

    data class Prompt(val system: String, val user: String)

    /**
     * [rule] 是这一轮用的细化规则（网关优先，见 [ImageGenerationRuleResolver.resolveSceneRefineRule]）。
     * [appearance] 是这个角色固定的长相描述——第 2 轮要以它为底，不许自己编长相。
     */
    fun prompt(
        previous: String,
        format: ScenePromptFormat,
        pass: Int,
        rule: String,
        appearance: String = ""
    ): Prompt = Prompt(
        system = system(rule, format, pass, appearance),
        user = user(previous, pass)
    )

    private fun system(
        rule: String,
        format: ScenePromptFormat,
        pass: Int,
        appearance: String
    ): String = buildString {
        appendLine(rule.trim().ifBlank { defaultRule(format, pass) })
        if (appearance.isNotBlank()) {
            appendLine()
            appendLine("**她的固定长相（以此为准，不许自己编、不许美化、不许换人）**：")
            appendLine(appearance.trim())
        }
        appendLine(formRequirement(format))
        appendLine("只输出提示词本体，不要输出 WHY 行、不要解释、不要 markdown。")
        appendLine("长度不超过 $MAX_CHARS 个字符。")
    }.trim()

    private fun user(previous: String, pass: Int): String = buildString {
        appendLine("下面这段是上一轮（第 ${pass - 1} 轮）给出的画面描述。把它改写成规则要求的那种提示词（形态按规则来，可以是标签串，也可以是分段长句）：")
        appendLine(previous.trim())
    }.trim()

    /** 形态硬约束：三轮都必须是同一种形态、同一种语言。 */
    private fun formRequirement(format: ScenePromptFormat): String = when (format) {
        ScenePromptFormat.ENGLISH_TAGS ->
            "**输出必须是英文 tag 串**：逗号分隔、全英文，整段不许出现任何中文字符。"
        ScenePromptFormat.ENGLISH_NATURAL ->
            "**输出必须是英文自然语言长句**：全英文，按模块分段、段间换行，整段不许出现任何中文字符。"
        // Krea 2 的编码器是 Qwen3-VL，要中文自然语言（和 z-image 一样按模块分段）。
        ScenePromptFormat.CHINESE_NATURAL ->
            "**输出必须是中文自然语言**：全中文，按模块分段、段间换行，不许输出英文 tag 串。"
        ScenePromptFormat.NATURAL_LANGUAGE ->
            "**输出必须是中文自然语言**：和上一轮同一种语言，不要改成英文 tag 串。"
    }

    private val TAGS_PASS2 = """
        把上面那段画面描述改写成英文逗号分隔的 Danbooru 标签串（Illustrious XL 用）。
        只做形态转换：人物、地点、动作、服饰、光线、风格、构图全部按原样搬过来，
        不许换人、不许换场景、不许换衣服，也不许新增或删掉画面元素。
        写得尽量细：每一项都补上看得见的修饰——材质、颜色、形状、尺寸、状态、位置、角度、方向。
        整段必须是英文 tag 串，逗号分隔，不许出现任何中文字符。
    """.trimIndent()

    private val TAGS_PASS3 = """
        把上面那段画面描述改写成英文逗号分隔的 Danbooru 标签串（Illustrious XL 用），并且比上一轮更细：
        肢体拆到手指、手腕、肩、胯、膝盖这些关节与朝向；
        布料写出褶皱、厚度、垂坠、贴身程度和光影落在哪一侧；皮肤、头发、眼神写出质感。
        仍然只做形态转换：人物、地点、动作、服饰、光线、风格、构图全部按原样搬过来，
        不许换人、不许换场景、不许换衣服，也不许新增或删掉画面元素。
        整段必须是英文 tag 串，逗号分隔，不许出现任何中文字符。
    """.trimIndent()

    private val NATURAL_PASS2 = """
        把上面那段画面描述改写成自然语言长句（语言按下面的形态要求来：英文形态写英文，中文形态写中文），
        按模块分段、段间换行。
        只做形态转换：人物、地点、动作、服饰、光线、风格、构图全部按原样搬过来，
        不许换人、不许换场景、不许换衣服，也不许新增或删掉画面元素。
        写得尽量细：每一处都补上材质、颜色、形状、尺寸、状态、位置、角度、方向这类看得见的细节，
        把笼统的说法拆成具体的画面。
    """.trimIndent()

    private val NATURAL_PASS3 = """
        把上面那段画面描述改写成自然语言长句（语言按下面的形态要求来：英文形态写英文，中文形态写中文），
        按模块分段、段间换行，并且比上一轮更细：
        肢体的关节角度与朝向、布料的褶皱厚度与垂坠、皮肤与头发的质感、
        光影的方向与软硬、景深与镜头距离都写到具体。
        仍然只做形态转换：人物、地点、动作、服饰、光线、风格、构图全部按原样搬过来，
        不许换人、不许换场景、不许换衣服，也不许新增或删掉画面元素。
    """.trimIndent()
}
