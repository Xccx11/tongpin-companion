data class ImagePromptDebugConfig(
    val enabled: Boolean = false,
    val globalInstructions: String = ""
) {
    companion object {
        /**
         * 默认生图规则：只补动作/表情/场景细节，融合进已有提示词，
         * 不新增画面元素、不删减、不加 photorealistic/masterpiece 等风格标签。
         */
        val DEFAULT_RULE = """
            You write the SCENE PART ONLY for a ComfyUI positive prompt.
            Output ONLY a comma-separated tag list in English.
            Every tag must be a concrete visible thing or attribute: pose, action, prop, clothing,
            setting, camera framing, gaze direction, lighting. The renderer cannot act on
            narrative phrases, so never write sentences like "aiming the lens at ..." — write the
            visible facts instead ("close-up, from above, looking away to the left").
            Viewpoint must be a HUMAN EYE, never a camera: it may be her own eyes or someone standing
            beside her looking at her, but it must never read as a photograph being taken. Never write
            selfie, holding phone, holding camera, camera, dslr, lens, viewfinder or mirror: no phone,
            camera, lens or viewfinder may appear in the frame. For her use looking at viewer / full body
            (full body is the default - drop to close-up only when the moment really is about a detail);
            for what she is looking at use pov / first person view.
            Do NOT add photorealistic, masterpiece, best quality, absurdres, or any style/quality tags.
            Do NOT add new scene elements, objects or locations that are not already in the context.
            Clothing is the exception: the appearance anchor no longer carries an outfit, so state
            what she has on right now — top, bottom, underwear or stockings if any — or state plainly
            that she is not wearing it. Decide from the moment itself: do not force clothing onto her,
            and do not force her nude either.
            Only add: character action, pose, expression, body language, camera angle, lighting.
            Only ADD to the existing prompt — never remove or rewrite any part of it.
            Subject rule: decide who or what this image is about before writing tags.
            If it is one detail of her (her hand, eyes, collarbone, legs, lips) and not her whole body,
            start with: close-up, cropped view, no face — and describe only that detail.
            If it is not her at all (a view out of the window, food on the table, a pet, an object),
            write only that subject's tags and add: no humans, scenery only — do not describe a person.
            No identity restatement. No sentences. No JSON. No Markdown. No Chinese. No [bracketed placeholders].
        """.trimIndent()

        /**
         * z-image / lumina 这类「文本编码器吃自然语言」的模型专用规则。
         *
         * 官方推荐的描述顺序：[主体] + [动作/姿势] + [环境/场景] + [光线] + [风格/媒介] + [技术细节] + [构图]。
         * [主体] 由 App 保存的人物锚点提供，所以这里不要求复述长相。
         */
        val DEFAULT_Z_IMAGE_RULE = """
            你为 z-image（中文自然语言模型）写画面描述。
            官方推荐顺序：[主体]+[动作/姿势]+[环境/场景]+[光线]+[风格/媒介]+[技术细节]+[构图]。
            输出 3-5 句中文自然语言，严格按这个顺序**把下面五部分都写出来**：
            1) 她在做什么：**动作必须拆到肢体**——哪只手、哪条腿在做什么，身体是什么姿势，和什么东西接触着。
               不许概括成「在换衣服」「在看书」「在收拾东西」，要写成「右手拉着肩带往上提，左手撑在床单上，上半身微微侧过来」。
               表情要写到具体的眉眼和嘴（不能只写「心虚」「害羞」）。
            2) 她身上是什么样子：**逐件说清楚**——每一件的款式 + 颜色 + 材质 + **此刻的状态**
               （穿好 / 半褪 / 只穿了一半 / 滑到哪儿 / 湿了 / 皱了）；没穿就直说没穿、哪里露着。
               不许概括成「白色吊带裙」「穿着睡衣」，要写成「白色棉质吊带裙，左边肩带滑到手肘，下摆堆在腰上」。
               贴身衣物、袜子、鞋也要交代清楚。
               穿不穿、穿多少由你按这张照片要拍什么自己判断，不用刻意给她加衣服。
            3) 她在哪：周围环境、地点、身边的东西、天气或季节感。地点要写明是什么房间/什么场所，不要写成「里只有…」这种没主语的话。
            4) 光线：什么时间、光从哪来、什么质感。
            5) 构图与视角：景别（全身/半身/特写）、角度、她看向哪里。
            [主体] 由已保存的人物锚点提供，所以**不要再写**她长什么样（脸型、五官、发色、瞳色、身材）。
            这五部分缺一不可：就算她的决定里只说了动作，服饰、环境、光线、构图也要补全。
            [风格/媒介] 只在上下文明确要求时写；不要自造 masterpiece、8k、杰作这类质量词。
            视角必须是**人的眼睛**，不是相机：她的眼睛，或者旁边某个人的眼睛都可以，
            但不能读起来像「有人在拍照」。画面里不要出现手机、相机、镜头、取景框、镜子。
            拍她自己就写「像有人正看着她」的样子，拍眼前的就写「她眼睛里的画面」，
            也不要用「自拍」这种相机语义的词。
            先想清楚这张画面**是谁/是什么**：
            - 如果是她的某个局部（手、眼睛、锁骨、腿、嘴唇）而不是整个人，就写成「特写：她的手…」，
              并说明画面里不出现脸、不出现全身；
            - 如果拍的**根本不是人**（窗外的雨、桌上的东西、食物、宠物），就只写那个东西或那个地方，
              说明画面里没有人，不要写成人物照。
            不要输出英文 tag 串、JSON、Markdown，也不要输出 [方括号占位符]、不要写对话或关系说明。
            示例：她盘腿坐在床上，右手压在摊开的书页上，左手撑着下巴，嘴角翘着笑了一下；上身是一件洗得发白的灰色棉质短袖T恤，下摆卷到腰间露出一点腰线，下身是宽松的深蓝色棉短裤，光着脚，脚趾蹭着床单；身后的卧室只开着一盏暖黄的床头灯，被子堆在一边，窗帘没拉严；灯光从侧面照过来，把她的侧脸和书页照得很柔；画面从头到脚都拍进去，脚也留在画面里，从她斜前方看过去。
        """.trimIndent()
    }
}

enum class ImagePromptDebugStage {
    ANALYSIS,
    DRAFT,
    REFINEMENT
}

/** Adds one owner-authored generation rule to every internal prompt pass. */
object ImagePromptDebugInstructionComposer {
    /**
     * Builds the App-side instruction used when the conversation model turns a live request into
     * the current image scene passed to the gateway. The saved rule is deliberately not a
     * renderer prompt: it must not leak chat history or relationship metadata into visual_brief.
     */
    fun forSceneModel(config: ImagePromptDebugConfig): String {
        val instruction = config.globalInstructions.trim()
        if (!config.enabled || instruction.isBlank()) return ""
        return buildString {
            appendLine("APP IMAGE GENERATION RULE (apply before writing any image tool call):")
            appendLine(instruction.take(MAX_DEBUG_INSTRUCTION_CHARS))
            appendLine("This rule is the authority for art style, medium, rendering, lighting and composition. The character appearance anchor only decides the character's looks (face/hair/build); it must never override the style demanded by this rule or by the user's explicit style request (for example 2.5D, anime, illustration, photoreal).")
            appendLine("When an image is requested, use the complete current context to resolve only the visible moment the user wants.")
            appendLine("The tool argument scene must contain only the current visible image scene: subject, appearance details needed for this moment, clothing, pose, expression, action, props, setting, composition, lighting, color, and rendering style.")
            appendLine("Do not include conversation history, relationship explanations, recipient or delivery details, planning steps, JSON, dialogue, captions, or explanations.")
            appendLine("Preserve every explicit visual requirement from the user and never replace it with a generic or unrelated scene.")
        }.trim()
    }

    fun forStage(
        basePrompt: String,
        stage: ImagePromptDebugStage,
        config: ImagePromptDebugConfig
    ): String {
        val instruction = config.globalInstructions.trim()
        if (!config.enabled || instruction.isBlank()) return basePrompt
        return buildString {
            append(basePrompt.trimEnd())
            append("\n\nOwner generation rule, mandatory at every stage:\n")
            append(instruction.take(MAX_DEBUG_INSTRUCTION_CHARS))
            append("\n\nNon-negotiable requirements: preserve the appearance anchor as the visual identity source of truth; honor the current requested scene whenever visually possible; keep normal human anatomy with exactly two arms, two hands, and five fingers on each visible hand; return only the requested stage output.")
        }
    }

    private const val MAX_DEBUG_INSTRUCTION_CHARS = 8_000
}

/** App-private single-rule controls for the three internal DeepSeek image prompt passes. */
@Singleton
class ImagePromptDebugSettings @Inject constructor(@ApplicationContext context: Context) {
    private val preferences = context.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
    private val _config = MutableStateFlow(read())

    val config: ImagePromptDebugConfig get() = _config.value
    val configFlow: StateFlow<ImagePromptDebugConfig> = _config

    fun save(config: ImagePromptDebugConfig) {
        val normalized = config.copy(
            globalInstructions = config.globalInstructions.take(MAX_SAVED_INSTRUCTION_CHARS)
        )
        preferences.edit()
            .putBoolean(KEY_ENABLED, normalized.enabled)
            .putString(KEY_GLOBAL, normalized.globalInstructions)
            .apply()
        _config.value = normalized
    }

    fun reset() = save(ImagePromptDebugConfig())

    private fun read(): ImagePromptDebugConfig {
        val migrated = listOf(
            preferences.getString(KEY_ANALYSIS, "").orEmpty(),
            preferences.getString(KEY_DRAFT, "").orEmpty(),
            preferences.getString(KEY_REFINEMENT, "").orEmpty()
        ).filter(String::isNotBlank).joinToString("\n\n")
        return ImagePromptDebugConfig(
            enabled = preferences.getBoolean(KEY_ENABLED, false),
            globalInstructions = preferences.getString(KEY_GLOBAL, "").orEmpty().ifBlank { migrated }
        )
    }

    private companion object {
        const val PREFERENCES_NAME = "tongpin_image_prompt_debug"
        const val KEY_ENABLED = "enabled"
        const val KEY_GLOBAL = "global_instructions"
        const val KEY_ANALYSIS = "analysis_instructions"
        const val KEY_DRAFT = "draft_instructions"
        const val KEY_REFINEMENT = "refinement_instructions"
        const val MAX_SAVED_INSTRUCTION_CHARS = 12_000
    }
}
