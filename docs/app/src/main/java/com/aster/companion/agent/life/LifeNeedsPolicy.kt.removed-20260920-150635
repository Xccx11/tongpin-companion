package com.aster.companion.agent.life

import com.aster.companion.data.CharacterLifeStateEntity
import com.aster.companion.domain.CharacterSchedule
import com.aster.companion.domain.NeedEvaluator
import kotlin.math.roundToInt

/**
 * 她的需求怎么随时间走。
 *
 * 这是「不排班」能成立的底层：**不是 18:30 到了该吃饭，而是她累了、饿了、孤单了才动**。
 * 数值全是代码算的（和产品里 v2.1 那套一致），模型只负责在数值说话时做一个决定。
 *
 * 数值范围都是 0..100：
 * - `energy` 精力：清醒时掉，睡觉时回。低了就想睡。
 * - `loneliness` 孤单：一个人待久了会涨。高了就想找人说说话。
 * - `stress` 压力：慢慢回落；被事情打断或者挤在一起时会涨。
 * - `socialNeed` 社交需求：和孤单同向，但涨得慢——它是「想和人待着」，不只是「不想一个人」。
 *
 * 纯函数，可以单测。
 */
object LifeNeedsPolicy {

    /**
     * 清醒时每小时掉多少精力（约 20 小时见底）。
     *
     * 数值**共用 `NeedEvaluator` 那一套**（产品里 v2.1 的需求系统），免得同一个数字
     * 在两处各写一遍、然后慢慢漂移。区别只是这里按**真实流逝的时间**推进，
     * 而且知道她到底在不在睡。
     */
    private val ENERGY_DRAIN_PER_HOUR = NeedEvaluator.ENERGY_DRAIN_PER_HOUR.toDouble()

    /** 睡觉时每小时回多少精力（约 8 小时回满），略低于掉的速度会让作息自然漂移。 */
    private const val ENERGY_RECOVER_PER_HOUR = 12.0

    /** 一个人待着时，孤单每小时涨多少。 */
    private val LONELINESS_PER_HOUR = NeedEvaluator.LONELINESS_GROW_PER_HOUR.toDouble()

    /** 社交需求涨得比孤单慢。 */
    private const val SOCIAL_NEED_PER_HOUR = 2.0

    /** 没什么事压着时，压力每小时回落多少。 */
    private val STRESS_DECAY_PER_HOUR = NeedEvaluator.STRESS_DECAY_PER_HOUR.toDouble()

    /** 精力掉到这个数以下就想睡。 */
    const val SLEEP_BELOW = 25

    /** 睡到精力回到这个数以上才想起。 */
    const val WAKE_ABOVE = 70

    /** 孤单涨到这个数以上，就会想主动找人。 */
    const val LONELY_ABOVE = 65

    /** 刚聊完天，孤单和社交需求各掉多少。 */
    private const val SOCIAL_CONTACT_RELIEF = 25.0

    /**
     * 按流逝的时间推进 [needs]。
     *
     * [sleeping] 由调用方给定（她已经睡着了）；[schedule] 只用来表达「她本来就是早睡还是晚睡型」——
     * 落在她自己的睡眠时段里，精力掉得更快，于是她会更自然地犯困。
     */
    fun advance(
        needs: CharacterLifeStateEntity,
        now: Long,
        sleeping: Boolean,
        schedule: CharacterSchedule = CharacterSchedule.DEFAULT
    ): CharacterLifeStateEntity {
        val elapsedMs = (now - needs.updatedAt).coerceAtLeast(0L)
        if (elapsedMs == 0L) return needs
        val hours = elapsedMs / 3_600_000.0

        val energy = if (sleeping) {
            needs.energy + ENERGY_RECOVER_PER_HOUR * hours
        } else {
            val inHerSleepWindow = schedule.isSleeping(needs.updatedAt)
            val drain = ENERGY_DRAIN_PER_HOUR * if (inHerSleepWindow) SLEEP_WINDOW_DRAIN_MULTIPLIER else 1.0
            needs.energy - drain * hours
        }

        return needs.copy(
            energy = energy.roundToInt().coerceIn(0, 100),
            loneliness = (needs.loneliness + LONELINESS_PER_HOUR * hours).roundToInt().coerceIn(0, 100),
            socialNeed = (needs.socialNeed + SOCIAL_NEED_PER_HOUR * hours).roundToInt().coerceIn(0, 100),
            stress = (needs.stress - STRESS_DECAY_PER_HOUR * hours).roundToInt().coerceIn(0, 100),
            updatedAt = now
        )
    }

    /** 刚和人说过话——孤单和社交需求都会掉一截。 */
    fun relievedByContact(needs: CharacterLifeStateEntity, now: Long): CharacterLifeStateEntity = needs.copy(
        loneliness = (needs.loneliness - SOCIAL_CONTACT_RELIEF).roundToInt().coerceIn(0, 100),
        socialNeed = (needs.socialNeed - SOCIAL_CONTACT_RELIEF).roundToInt().coerceIn(0, 100),
        updatedAt = now
    )

    /** 累到这个地步就该睡了。 */
    fun wantsSleep(needs: CharacterLifeStateEntity): Boolean = needs.energy <= SLEEP_BELOW

    /** 睡到精力回来了就该醒。 */
    fun shouldWake(needs: CharacterLifeStateEntity): Boolean = needs.energy >= WAKE_ABOVE

    /** 孤单到一定程度就会想主动找人。 */
    fun wantsContact(needs: CharacterLifeStateEntity): Boolean = needs.loneliness >= LONELY_ABOVE

    /**
     * 把数值翻成她自己的体感，喂给模型。
     *
     * 给的是**感受**而不是数字——「有点累」比「energy=28」更能让模型说出人话。
     */
    fun describe(needs: CharacterLifeStateEntity): String = buildList {
        add(
            when {
                needs.energy <= SLEEP_BELOW -> "很累，快撑不住了"
                needs.energy <= 45 -> "有点累"
                needs.energy >= 80 -> "精神很好"
                else -> "还行"
            }
        )
        when {
            needs.loneliness >= LONELY_ABOVE -> add("心里挺空的，想有人说话")
            needs.loneliness >= 45 -> add("有点闷")
            else -> Unit
        }
        when {
            needs.stress >= 65 -> add("心里压着事")
            needs.stress <= 20 -> add("挺放松的")
            else -> Unit
        }
        needs.currentGoal.takeIf { it.isNotBlank() }?.let { add("心里还惦记着「$it」") }
    }.joinToString(" · ")

    private const val SLEEP_WINDOW_DRAIN_MULTIPLIER = 2.5
}
