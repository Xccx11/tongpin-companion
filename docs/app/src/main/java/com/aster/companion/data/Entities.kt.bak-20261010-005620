/**
 * 会话状态：**结构化状态全文**（见 [com.aster.companion.agent.ConversationStateFormat]）。
 *
 * 以前这里存的是 300 字散文摘要；旧数据在读的时候会被判定为"不可用"，由状态更新器用最近一批消息重建，
 * 不做就地迁移——把一份已经被压过好几轮的散文"翻译"成结构化字段，只会把损失固化下来。
 */
@Entity(tableName = "companion_thread_summaries")
data class ThreadSummaryEntity(
    @PrimaryKey val threadId: String,
    val role: String,
    val summary: String,
    val summarizedUpToMessageId: String?,
    val updatedAt: Long,
    /** 成功更新次数（诊断用；也用于判断状态是否推进过）。 */
    val revision: Int = 0,
    /** 连续失败次数，成功后清零。 */
    val failureCount: Int = 0,
    /** 最后一次失败原因，成功后清空。连续失败到阈值会在设置页提示。 */
    val lastError: String? = null,
    /** 最后一次尝试时间，含失败的那次。 */
    val lastAttemptAt: Long = 0L
)

class CompanionConverters {
    @TypeConverter fun typeToString(value: ConversationType): String = value.name
    @TypeConverter fun stringToType(value: String): ConversationType = ConversationType.valueOf(value)
    @TypeConverter fun memoryToString(value: MemoryKind): String = value.name
    @TypeConverter fun stringToMemory(value: String): MemoryKind = runCatching { MemoryKind.valueOf(value) }.getOrDefault(MemoryKind.EVENT)
    @TypeConverter fun eventToString(value: EventState): String = value.name
    @TypeConverter fun stringToEvent(value: String): EventState = EventState.valueOf(value)
    @TypeConverter fun atmosphereToString(value: GroupAtmosphere): String = value.name
    @TypeConverter fun stringToAtmosphere(value: String): GroupAtmosphere = GroupAtmosphere.valueOf(value)
}
