package com.aster.companion.agent

import com.aster.companion.data.ModelProfileEntity
import kotlinx.serialization.json.Json
import kotlinx.serialization.json.buildJsonArray
import kotlinx.serialization.json.buildJsonObject
import kotlinx.serialization.json.contentOrNull
import kotlinx.serialization.json.jsonArray
import kotlinx.serialization.json.jsonObject
import kotlinx.serialization.json.jsonPrimitive
import kotlinx.serialization.json.put

/** DashScope's Qwen Image API is not part of its OpenAI-compatible endpoint. */
object QwenImageApi {
    private const val GENERATION_PATH = "/api/v1/services/aigc/multimodal-generation/generation"

    fun supports(profile: ModelProfileEntity): Boolean {
        return ImageProviderProtocolResolver.resolve(profile) == ImageProviderProtocol.QWEN_DASHSCOPE
    }

    fun generationEndpoint(profile: ModelProfileEntity): String = workspaceRoot(profile.baseUrl) + GENERATION_PATH

    fun taskEndpoint(profile: ModelProfileEntity, taskId: String): String =
        workspaceRoot(profile.baseUrl) + "/api/v1/tasks/$taskId"

    fun requestBody(model: String, prompt: String, referenceDataUrl: String? = null): String = buildJsonObject {
        put("model", model)
        put("input", buildJsonObject {
            put("messages", buildJsonArray {
                add(buildJsonObject {
                    put("role", "user")
                    put("content", buildJsonArray {
                        referenceDataUrl?.let { image ->
                            add(buildJsonObject { put("image", image) })
                        }
                        add(buildJsonObject { put("text", prompt) })
                    })
                })
            })
        })
        put("parameters", buildJsonObject {
            put("size", "1024*1024")
            put("n", 1)
            put("prompt_extend", true)
            put("watermark", false)
        })
    }.toString()

    fun taskId(responseBody: String): String? = runCatching {
        Json.parseToJsonElement(responseBody).jsonObject["output"]?.jsonObject
            ?.get("task_id")?.jsonPrimitive?.contentOrNull
    }.getOrNull()

    fun taskStatus(responseBody: String): String? = runCatching {
        Json.parseToJsonElement(responseBody).jsonObject["output"]?.jsonObject
            ?.get("task_status")?.jsonPrimitive?.contentOrNull
    }.getOrNull()

    fun completedImageUrl(responseBody: String): String {
        val output = Json.parseToJsonElement(responseBody).jsonObject["output"]?.jsonObject
            ?: throw IllegalStateException("Qwen image response has no output")
        output["results"]?.jsonArray?.firstOrNull()?.jsonObject?.let { result ->
            result["url"]?.jsonPrimitive?.contentOrNull?.let { return it }
        }
        output["choices"]?.jsonArray?.firstOrNull()?.jsonObject?.let { choice ->
            choice["message"]?.jsonObject?.get("content")?.jsonArray?.firstOrNull()?.jsonObject
                ?.get("image")?.jsonPrimitive?.contentOrNull?.let { return it }
        }
        throw IllegalStateException("Qwen image task completed without an image URL")
    }

    private fun workspaceRoot(baseUrl: String): String {
        val root = baseUrl.trim().trimEnd('/')
        return root
            .replace(Regex("/compatible-mode/v1$", RegexOption.IGNORE_CASE), "")
            .replace(Regex("/v1$", RegexOption.IGNORE_CASE), "")
            .trimEnd('/')
    }
}
