sealed interface ImageGenerationResult {
    data class Generated(val imageUrl: String) : ImageGenerationResult
    data object ModelNotConfigured : ImageGenerationResult
    data class Failed(val reason: String) : ImageGenerationResult
}

/**
 * Sends stable character identity and one fresh visual moment to the image gateway.
 * Identity is never rewritten; no auto-appended style tags.
 */
object ImageGenerationPromptPolicy {
    /**
     * 外貌锚点放在最前，scene 只补充当刻画面。
     * 不自动追加 photorealistic/masterpiece 等风格标签。
     *
     * 渲染器只吃**一行**：外貌与场景之间不换行，只用分隔符连起来。
     *
     * [format] 决定形态：英文 tag 模型用英文逗号拼 tag 串；自然语言模型（z-image）
     * 用中文逗号拼两句中文描述。
     *
     * 只有 scene 里已经**完整包含**整段外貌锚点时才会跳过拼接：以前的「前 40 字相同就跳过」
     * 会在 scene 恰好复述了开头时把整段锚点丢掉，出图就不像角色了。
     */
    fun forRenderer(
        appearance: String,
        scene: String,
        format: ScenePromptFormat = ScenePromptFormat.ENGLISH_TAGS
    ): String {
        val identity = singleLine(appearance, format)
        val sceneText = singleLine(scene, format)
        return when {
            identity.isEmpty() -> sceneText
            sceneText.isEmpty() -> identity
            sceneText.contains(identity) -> sceneText
            format.wantsChineseInstructions -> "$identity，$sceneText"
            else -> "$identity, $sceneText"
        }
    }

    /**
     * 规范提示词的行结构。
     * - 英文 tag 形态：换行变逗号，清掉重复逗号与首尾逗号；
     * - Krea 2 形态（ENGLISH_NATURAL）：纯文本按模块分段，**换行是分段标记，必须保留**——
     *   只把连续换行（`\r\n`、`\n\n` 一律）归一成一个 `\n`，并去掉每行首尾空白，**不合并行**；
     * - 其余自然语言形态（z-image）：只把换行和多余空白压成空格——那是句子不是 tag，**不能**按逗号切。
     */
    fun singleLine(
        text: String,
        format: ScenePromptFormat = ScenePromptFormat.ENGLISH_TAGS
    ): String = when {
        format == ScenePromptFormat.ENGLISH_NATURAL ||
            format == ScenePromptFormat.CHINESE_NATURAL -> text
            .replace(Regex("\\r\\n?"), "\n")
            .split('\n')
            .map { it.trim() }
            .filter { it.isNotEmpty() }
            .joinToString("\n")
        format.isNaturalLanguage -> text.replace(Regex("[\\r\\n]+"), " ")
            .replace(Regex("\\s{2,}"), " ")
            .trim()
        else -> text.replace(Regex("[\\r\\n]+"), ",")
            .replace(Regex("\\s*,\\s*(?:,\\s*)*"), ", ")
            .replace(Regex("[ \\t]{2,}"), " ")
            .trim()
            .trim(',')
            .trim()
    }

    /**
     * 外貌锚点能不能被本地 SDXL 真正读进去。返回 null 表示没问题。
     * 只提示、不代改：用户填的内容永远原样发送。
     * 自然语言形态（z-image / Krea 2）的中文编码器认得中文，不需要这条提醒。
     */
    fun anchorWarning(
        appearance: String,
        format: ScenePromptFormat = ScenePromptFormat.ENGLISH_TAGS
    ): String? {
        val identity = appearance.trim()
        if (identity.isEmpty()) return "还没填「外貌提示词」，出的图不会像她"
        if (format.allowsChinese) return null
        val cjk = identity.count { it.code in 0x3400..0x9FFF }
        return if (cjk > identity.length / 3) {
            "外貌提示词基本是中文，本地 SDXL 认不出中文，建议改成英文 tag"
        } else {
            null
        }
    }
}

/** Keeps a photo request alive while the user leaves the app, then sends it as a normal role message. */
@Singleton
class ImageGenerationCoordinator @Inject constructor(
    private val dao: CompanionDao,
    private val client: OpenAiCompatibleClient,
    private val comfyClient: ComfyUiImageClient,
    private val providerPool: ImageGenerationProviderPool,
    private val diaryPhotoStore: DiaryPhotoStore,
    private val privateImageStore: CompanionPrivateImageStore,
    private val renderPromptBuilder: CharacterRenderPromptBuilder,
    private val imageSizeStore: com.aster.companion.lite.LiteImageSizeStore,
    @ApplicationContext private val context: Context
) {
    private data class ImagePlanningContext(
        val groupTranscript: List<GroupImagePromptPlanningInput.Line>,
        val visualBrief: String = ""
    )

    /**
     * 出图结果 + 这次**真正送去渲染**的最终提示词。
     * 优先取网关回填的 revised_prompt；网关没给时退回 App 自己生成的那份（[providerPrompt]）。
     * LAST_SCENE 记的就是它（含详细穿着/场景/光线），不是 request 那份画面意图。
     */
    private data class ImageRequestOutcome(
        val imageUrl: String,
        val finalPrompt: String
    )

    /** Different durable actions may run concurrently; retries for one action stay ordered. */
    private val imageLanes = ImageGenerationLaneRegistry()

    fun isImageLaneBusy(): Boolean = imageLanes.isBusy()

    /** Generates a private image for a feed post without creating a chat message. */
    suspend fun generateStandaloneImage(characterId: String, request: String, actionId: String? = null, size: String? = null): Result<String> {
        return imageLanes.withLaneIfIdle(actionId) {
            generateStandaloneImageWhenLaneHeld(characterId, request, actionId, size)
        } ?: Result.failure(ImageLaneBusyException)
    }

    private suspend fun generateStandaloneImageWhenLaneHeld(characterId: String, request: String, actionId: String?, size: String?): Result<String> {
        val character = dao.character(characterId) ?: return Result.failure(IllegalArgumentException("Character unavailable"))
        val profile = dao.modelProfile(IMAGE_GENERATION_MODEL)
        val existingTaskId = providerTaskId(actionId, null)
        // 形态跟着当前图像模型走：z-image 系的主体用中文自然语言（缓存），tag 模型用原文。
        val visualBrief = renderPromptBuilder.compose(request.trim())
        val wakeLock = context.getSystemService(PowerManager::class.java)
            ?.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "tongpin:moment_image_generation")
        wakeLock?.acquire(MAX_WAKE_LOCK_MS)
        return try {
            val imageRequest = providerPool.useProvider(
                fallback = profile,
                preferredProviderId = providerTaskProviderId(actionId, null)
            ) { provider ->
                requestCharacterImage(provider, character, request, actionId, visualBrief = visualBrief, size = size)
            } ?: return Result.failure(IllegalStateException("Image generation model is not configured"))
            val outcome = imageRequest.getOrElse { return Result.failure(it) }
            if (!isImageActionRunning(actionId)) return Result.failure(ImageTaskCancelledException(actionId.orEmpty()))
            privateImageStore.persist(outcome.imageUrl)
        } catch (error: CancellationException) {
            throw error
        } catch (error: Throwable) {
            Result.failure(error)
        } finally {
            if (wakeLock?.isHeld == true) wakeLock.release()
        }
    }

    suspend fun generateForCharacter(
        threadId: String,
        characterId: String,
        request: String,
        actionId: String,
        size: String? = null
    ): ImageGenerationResult {
        return imageLanes.withLane(actionId) {
            val character = dao.character(characterId)
                ?: return@withLane ImageGenerationResult.Failed("Character unavailable")
            generateForCharactersWhenLaneHeld(threadId, character.id, listOf(character), request, actionId, size = size)
        }
    }

    suspend fun generateForGroup(
        threadId: String,
        senderCharacterId: String,
        participantCharacterIds: List<String>,
        request: String,
        actionId: String,
        mode: GroupImageMode = GroupImageMode.TOGETHER,
        size: String? = null
    ): ImageGenerationResult {
        return imageLanes.withLane(actionId) {
            val currentMembers = dao.participantIds(threadId).toSet()
            val selectedIds = GroupImagePromptPolicy.parseParticipantIds(
                participantCharacterIds.joinToString(","),
                currentMembers
            ) ?: return@withLane ImageGenerationResult.Failed("Group image participants are invalid")
            val characters = selectedIds.mapNotNull { id -> dao.character(id) }
            if (characters.size != selectedIds.size) {
                return@withLane ImageGenerationResult.Failed("Group image character is unavailable")
            }
            if (!GroupImagePromptPolicy.isValidMode(mode, selectedIds)) {
                return@withLane ImageGenerationResult.Failed("Group image mode does not match the selected characters")
            }
            val sender = senderCharacterId.takeIf { it in currentMembers } ?: selectedIds.first()
            if (mode == GroupImageMode.SEPARATE) {
                var lastResult: ImageGenerationResult = ImageGenerationResult.Failed("Group image character unavailable")
                for (selected in characters) {
                    lastResult = generateForCharactersWhenLaneHeld(
                        threadId = threadId,
                        messageCharacterId = selected.id,
                        characters = listOf(selected),
                        request = request,
                        actionId = actionId,
                        taskSlot = selected.id,
                        size = size
                    )
                    if (lastResult !is ImageGenerationResult.Generated) return@withLane lastResult
                }
                lastResult
            } else {
                val messageCharacterId = if (mode == GroupImageMode.SINGLE) characters.single().id else sender
                generateForCharactersWhenLaneHeld(threadId, messageCharacterId, characters, request, actionId, size = size)
            }
        }
    }

    /**
     * 取消时丢掉这次生成留下的临时占位行（「正在给你挑照片…」）。
     *
     * **已经送达的照片（有 imageUri）永远不删**：用户要的是"占位消失"，不是"聊天内容少一段"，
     * 删错一行就等于把用户眼里的对话删掉了。
     */
    private suspend fun discardPlaceholder(placeholderId: String) {
        if (dao.message(placeholderId)?.imageUri == null) dao.deleteMessage(placeholderId)
    }

    private suspend fun generateForCharactersWhenLaneHeld(
        threadId: String,
        messageCharacterId: String,
        characters: List<com.aster.companion.data.CharacterEntity>,
        request: String,
        actionId: String,
        taskSlot: String? = null,
        size: String? = null
    ): ImageGenerationResult {
        if (characters.isEmpty()) return ImageGenerationResult.Failed("Character unavailable")
        val character = characters.first()
        val characterId = messageCharacterId
        val contextVersion = dao.thread(threadId)?.contextVersion ?: return ImageGenerationResult.Failed("Conversation unavailable")
        val threadType = dao.thread(threadId)?.type
        val fallbackProfile = dao.modelProfile(IMAGE_GENERATION_MODEL)
        val placeholderId = buildString {
            append("image-message:")
            append(actionId)
            taskSlot?.takeIf(String::isNotBlank)?.let { append(":").append(it) }
        }
        val startedAt = System.currentTimeMillis()
        if (dao.message(placeholderId) == null) {
            dao.insertMessage(MessageEntity(placeholderId, threadId, characterId, "正在给你挑照片...", null, false, startedAt))
        } else {
            dao.updateMessageContent(placeholderId, "正在给你挑照片...", null)
        }
        dao.touchThread(threadId, startedAt)

        val wakeLock = context.getSystemService(PowerManager::class.java)
            ?.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "tongpin:image_generation")
        wakeLock?.acquire(MAX_WAKE_LOCK_MS)
        val providerStartedAt = System.currentTimeMillis()
        val imageUrlRequest = try {
            val existingTaskId = providerTaskId(actionId, taskSlot)
            // 「重新生成 / 重试」必须复用**同一份提示词**：这一版已经有真正渲染过的最终提示词时，
            // 原样再送一次 —— 网关按「模型 + 尺寸 + 同提示词」命中最近图缓存就把那一张秒回，
            // 没有才重新渲染。既不重跑写提示词的模型，也不会因为提示词被重写而变成另一张图。
            val lockedPrompt = renderedPrompt(actionId, taskSlot)
            val effectiveRequest = lockedPrompt ?: request
            if (lockedPrompt != null) Log.i(TAG, "stage=prompt_locked reuse_len=${lockedPrompt.length}")
            val planningContext = if (lockedPrompt == null && ImageTaskRecoveryPolicy.shouldPlanPrompt(existingTaskId)) {
                val baseContext = imagePlanningContextFor(threadId)
                baseContext.copy(
                    visualBrief = effectiveRequest.trim()
                )
            } else {
                ImagePlanningContext(emptyList())
            }
            providerPool.useProvider(
                fallback = fallbackProfile,
                preferredProviderId = providerTaskProviderId(actionId, taskSlot)
            ) { provider ->
                requestImageForCharacters(provider, characters, effectiveRequest, actionId, taskSlot, planningContext, size)
            } ?: return ImageGenerationResult.ModelNotConfigured
        } finally {
            if (wakeLock?.isHeld == true) wakeLock.release()
        }
        Log.i(TAG, "stage=provider duration_ms=${System.currentTimeMillis() - providerStartedAt} participants=${characters.size}")

        val outcome = imageUrlRequest.getOrElse { error ->
            if (!isImageActionRunning(actionId)) {
                // 取消就**删掉**这条占位消息，不要改写成「已取消……」：用户要求取消后聊天里什么都不留。
                discardPlaceholder(placeholderId)
                return ImageGenerationResult.Failed("Image generation cancelled")
            }
            if (error is ImageProviderTaskException && error.terminal) {
                clearProviderTask(actionId, taskSlot)
            }
            val reason = error.message?.take(120) ?: "Image generation failed"
            Log.w(TAG, "provider failed: ${error::class.simpleName}: ${error.message}", error)
            dao.updateMessageContent(placeholderId, "这次照片没拍成，我晚点再试给你。", null)
            return ImageGenerationResult.Failed(reason)
        }
        if (!isImageActionRunning(actionId)) {
            // 取消就**删掉**这条占位消息（同上）：用户要求取消后聊天里什么都不留。
            discardPlaceholder(placeholderId)
            return ImageGenerationResult.Failed("Image generation cancelled")
        }
        val imageUri = privateImageStore.persist(outcome.imageUrl).getOrElse { error ->
            val reason = error.message?.take(120) ?: "Unable to save image"
            dao.updateMessageContent(placeholderId, "这次照片没存好，我晚点再试给你。", null)
            return ImageGenerationResult.Failed(reason)
        }
        // Keep the provider task id until the private copy is complete. A CDN/network
        // failure must resume the existing task instead of submitting a second image.
        clearProviderTask(actionId, taskSlot)

        if (!isImageActionRunning(actionId)) {
            // 取消就**删掉**这条占位消息（同上）：用户要求取消后聊天里什么都不留。
            discardPlaceholder(placeholderId)
            return ImageGenerationResult.Failed("Image generation cancelled")
        }
        val currentThread = dao.thread(threadId)
        if (!ProactiveDeliveryGuard.canDeliver(dao.character(characterId) != null, currentThread != null) ||
            !ConversationContextVersion.isCurrent(contextVersion, currentThread?.contextVersion ?: -1)
        ) {
            return ImageGenerationResult.Failed("Conversation was removed")
        }
        dao.updateMessageContent(placeholderId, "给你发一张照片。", imageUri)
        val deliveredAt = System.currentTimeMillis()
        // 角色要记得自己发过什么：照片真正送达时才记，失败不会让她以为发过了。
        runCatching {
            dao.upsertWorldState(
                com.aster.companion.data.WorldStateEntity(
                    id = "last-photo:$characterId",
                    characterId = characterId,
                    threadId = threadId,
                    scope = "LAST_PHOTO",
                    content = request.trim().take(200),
                    updatedAt = deliveredAt
                )
            )
        }
        // 连拍一致性：记下这次真正送去出图的**最终渲染提示词**，场景生成那一步会读它，
        // 让这一张的穿着、所在场景、光线和上一张接得上（除非情境明确换了）。
        // 拿不到最终提示词时（复用已有出图任务的重试路径）不写，免得用空串盖掉上一张。
        if (outcome.finalPrompt.isNotBlank()) {
            runCatching {
                dao.upsertWorldState(
                    com.aster.companion.data.WorldStateEntity(
                        id = "last-scene:$characterId",
                        characterId = characterId,
                        threadId = threadId,
                        scope = "LAST_SCENE",
                        content = outcome.finalPrompt.trim().take(600),
                        updatedAt = deliveredAt
                    )
                )
            }
            // 「重新生成」的凭据：把这一版**真正送去渲染**的提示词按任务存下来，
            // 重新生成/重试时原样复用（见 [renderedPrompt]），绝不重跑写提示词的模型。
            rememberRenderedPrompt(actionId, taskSlot, outcome.finalPrompt)
        }
        runCatching { characters.forEach { selected -> diaryPhotoStore.archive(selected.id, threadId, imageUri, deliveredAt) } }
        runCatching { dao.touchThread(threadId, deliveredAt) }
        // 用户要求：角色发图只用聊天里那张「确认卡」，不要再发系统通知。
        // （原来这里会 publish(character.name, "给你发来一张图片", threadId)，是第三个"弹窗"。）
        return ImageGenerationResult.Generated(imageUri)
    }

    private suspend fun requestCharacterImage(
        provider: ImageGenerationProvider,
        character: com.aster.companion.data.CharacterEntity,
        request: String,
        actionId: String?,
        taskSlot: String? = null,
        visualBrief: String = "",
        size: String? = null
    ): Result<ImageRequestOutcome> {
        val existingTaskId = providerTaskId(actionId, taskSlot)
        if (!ImageTaskRecoveryPolicy.shouldPlanPrompt(existingTaskId)) {
            // 第一步：**拉取**同一份提示词那一次的产出 —— provider 任务还在就直接收它，
            // 不重提、不重写提示词（正在出的那张往往正是用户要的）。
            Log.i(TAG, "stage=image_pull task=${existingTaskId?.take(40)}")
            val pulled = if (ComfyUiProtocol.supports(provider.profile)) {
                comfyClient.generate(
                    profile = provider.profile,
                    prompt = "",
                    identityReferenceUri = null,
                    existingPromptId = existingTaskId,
                    onTaskCreated = { id -> rememberProviderTask(actionId, taskSlot, provider, id) },
                    shouldCancel = { !isImageActionRunning(actionId) }
                ).map { url -> ImageRequestOutcome(url, "") }
            } else {
                client.generateImage(
                    provider.profile,
                    provider.apiKey,
                    prompt = "",
                    existingTaskId = existingTaskId,
                    onTaskCreated = { id -> rememberProviderTask(actionId, taskSlot, provider, id) },
                    shouldCancel = { !isImageActionRunning(actionId) },
                    size = ImageGenerationRequestPolicy.normalizeSize(ImageGenerationRequestPolicy.resolveSize(size, imageSizeStore.size.value))
                ).map { generated -> ImageRequestOutcome(generated.image, generated.revisedPrompt) }
            }
            if (pulled.isSuccess) return pulled
            // 第二步：那一张真的没了（任务被清掉/过期/失败）→ 用**同一份提示词**重新提交。
            Log.i(TAG, "stage=image_pull miss task=${existingTaskId?.take(40)} -> resubmit same prompt")
            clearProviderTask(actionId, taskSlot)
        }
        val currentVisualBrief = visualBrief.trim().ifBlank { request.trim() }
        val sceneFormat = renderPromptBuilder.format()
        // **外貌原文由代码搬运**：用户写的外貌一个字都不许改，让模型转写/复述必然丢细节
        // （实测过 22 岁→28 岁、整段妆容消失、腰/臀/胸全丢；现在也还是会只留下一个脸型）。
        // Krea 2 的文本编码器（Qwen3-VL）认中文，所以直接把**用户原文**拼在最前面，零转写损失；
        // 只有不认中文的英文 tag 模型才退回"让模型写"这条路（它们的锚点由 ImageGenerationPromptPolicy 处理）。
        // [AppearanceAnchor.prepend] 幂等：场景生图那条路已经拼过就不会再拼第二遍。
        val providerPrompt = if (sceneFormat.allowsChinese) {
            AppearanceAnchor.prepend(currentVisualBrief, character.appearancePrompt.orEmpty())
        } else {
            currentVisualBrief
        }
        Log.i(TAG, "stage=prompt format=$sceneFormat scene_len=${currentVisualBrief.length} final_len=${providerPrompt.length} final_head=${providerPrompt.take(120)}")
        val gatewayContext = ComfyGatewayPromptContext(
            characterAppearance = currentVisualBrief,
            visualBrief = currentVisualBrief,
            requiredCharacterCount = 1
        )
        if (ComfyUiProtocol.supports(provider.profile)) {
            return comfyClient.generate(
                profile = provider.profile,
                prompt = providerPrompt,
                identityReferenceUri = null,
                styleReferenceUri = null,
                existingPromptId = providerTaskId(actionId, taskSlot),
                onTaskCreated = { id -> rememberProviderTask(actionId, taskSlot, provider, id) },
                shouldCancel = { !isImageActionRunning(actionId) }
            ).map { url -> ImageRequestOutcome(url, providerPrompt) }
        }
        return client.generateImage(
            provider.profile,
            provider.apiKey,
            prompt = providerPrompt,
            gatewayContext = gatewayContext.takeIf { ComfyGatewayTaskProtocol.supports(provider.profile) },
            existingTaskId = providerTaskId(actionId, taskSlot),
            onTaskCreated = { id -> rememberProviderTask(actionId, taskSlot, provider, id) },
            shouldCancel = { !isImageActionRunning(actionId) },
            size = ImageGenerationRequestPolicy.normalizeSize(ImageGenerationRequestPolicy.resolveSize(size, imageSizeStore.size.value))
        ).map { generated ->
            // 记进 LAST_SCENE 的优先用**网关回填的 revised_prompt**（真正送去渲染的那份）；
            // 网关没回填时退回 App 自己生成的那份，行为与以前一致。
            ImageRequestOutcome(generated.image, generated.revisedPrompt.ifBlank { providerPrompt })
        }
    }

    private suspend fun requestImageForCharacters(
        provider: ImageGenerationProvider,
        characters: List<com.aster.companion.data.CharacterEntity>,
        request: String,
        actionId: String?,
        taskSlot: String? = null,
        planningContext: ImagePlanningContext = ImagePlanningContext(emptyList()),
        size: String? = null
    ): Result<ImageRequestOutcome> {
        if (characters.size == 1) {
            return requestCharacterImage(
                provider,
                characters.first(),
                request,
                actionId,
                taskSlot,
                planningContext.visualBrief,
                size
            )
        }
        val anchors = characters.map { character ->
            GroupImageCharacterAnchor(character.id, character.name, character.appearancePrompt, character.referenceImageUri)
        }
        val existingTaskId = providerTaskId(actionId, taskSlot)
        if (!ImageTaskRecoveryPolicy.shouldPlanPrompt(existingTaskId)) {
            Log.i(TAG, "stage=prompt_plan skipped=true reason=existing_provider_task participants=${characters.size}")
            if (ComfyUiProtocol.supports(provider.profile)) {
                return comfyClient.generate(
                    profile = provider.profile,
                    prompt = "",
                    identityReferenceUri = null,
                    existingPromptId = existingTaskId,
                    onTaskCreated = { id -> rememberProviderTask(actionId, taskSlot, provider, id) },
                    shouldCancel = { !isImageActionRunning(actionId) }
                ).map { url -> ImageRequestOutcome(url, "") }
            }
            return client.generateImage(
                provider.profile,
                provider.apiKey,
                prompt = "",
                existingTaskId = existingTaskId,
                onTaskCreated = { id -> rememberProviderTask(actionId, taskSlot, provider, id) },
                shouldCancel = { !isImageActionRunning(actionId) },
                size = ImageGenerationRequestPolicy.normalizeSize(ImageGenerationRequestPolicy.resolveSize(size, imageSizeStore.size.value))
            ).map { generated -> ImageRequestOutcome(generated.image, generated.revisedPrompt) }
        }
        val planningInput = GroupImagePromptPlanningInput.create(
            anchors = anchors,
            currentScene = request,
            recentTranscript = planningContext.groupTranscript
        )
        val currentVisualBrief = planningContext.visualBrief.trim().ifBlank { planningInput.scene }
        val groupFormat = renderPromptBuilder.format()
        // 群聊不在 Lite 范围内：主体仍用锚点原文，这里只按形态决定拼接方式。
        val rendererPrompt = ImageGenerationPromptPolicy.forRenderer(
            planningInput.identityFacts,
            currentVisualBrief,
            groupFormat
        )
        // 与**单人路径保持一致**：认中文的形态（Krea 2 / Qwen 系）由代码把每个人的外貌原文一字不改
        // 拼在最前面；以前这里只走 forRenderer（把锚点塞进句子让模型转述），结果同一模型
        // 「单人图必拼原文、群图靠转述」两套策略相反——长相时有时无、有时还出现两遍。
        val providerPromptBase = if (groupFormat.allowsChinese) {
            characters.mapNotNull { it.appearancePrompt?.trim()?.takeIf(String::isNotBlank) }
                .takeIf { it.isNotEmpty() }
                ?.joinToString("\n")
                ?.let { anchors -> AppearanceAnchor.prepend(rendererPrompt, anchors) }
                ?: rendererPrompt
        } else {
            rendererPrompt
        }
        val providerPrompt = ImageProviderPromptPolicy.forProvider(provider.profile, currentVisualBrief, providerPromptBase)
        val gatewayContext = ComfyGatewayPromptContext(
            characterAppearance = planningInput.identityFacts,
            visualBrief = currentVisualBrief,
            requiredCharacterCount = planningInput.requiredCharacterCount
        )
        if (ComfyUiProtocol.supports(provider.profile)) {
            return comfyClient.generate(
                profile = provider.profile,
                prompt = providerPrompt,
                identityReferenceUri = null,
                styleReferenceUri = null,
                existingPromptId = providerTaskId(actionId, taskSlot),
                onTaskCreated = { id -> rememberProviderTask(actionId, taskSlot, provider, id) },
                shouldCancel = { !isImageActionRunning(actionId) }
            ).map { url -> ImageRequestOutcome(url, providerPrompt) }
        }
        return client.generateImage(
            provider.profile,
            provider.apiKey,
            prompt = providerPrompt,
            gatewayContext = gatewayContext.takeIf { ComfyGatewayTaskProtocol.supports(provider.profile) },
            existingTaskId = providerTaskId(actionId, taskSlot),
            onTaskCreated = { id -> rememberProviderTask(actionId, taskSlot, provider, id) },
            shouldCancel = { !isImageActionRunning(actionId) },
            size = ImageGenerationRequestPolicy.normalizeSize(ImageGenerationRequestPolicy.resolveSize(size, imageSizeStore.size.value))
        ).map { generated ->
            // 记进 LAST_SCENE 的优先用**网关回填的 revised_prompt**（真正送去渲染的那份）；
            // 网关没回填时退回 App 自己生成的那份，行为与以前一致。
            ImageRequestOutcome(generated.image, generated.revisedPrompt.ifBlank { providerPrompt })
        }
    }

    private suspend fun imagePlanningContextFor(threadId: String): ImagePlanningContext {
        val messages = dao.recentMessages(threadId, MAX_IMAGE_CONTEXT_MESSAGES).asReversed()
        val transcript = messages.map { message ->
            GroupImagePromptPlanningInput.Line(
                speakerName = if (message.fromUser) "User" else dao.character(message.characterId.orEmpty())?.name ?: "Character",
                fromUser = message.fromUser,
                body = message.body
            )
        }
        return ImagePlanningContext(transcript)
    }

    private fun Throwable.isUncertainImageRequest(): Boolean {
        if (this is ImageProviderTaskException) return true
        val detail = message.orEmpty().lowercase()
        return detail.contains("connection abort") ||
            detail.contains("connection reset") ||
            detail.contains("broken pipe") ||
            detail.contains("timeout")
    }

    private suspend fun providerTaskId(actionId: String?, taskSlot: String?): String? {
        if (actionId.isNullOrBlank()) return null
        val key = providerTaskKey(taskSlot)
        return dao.pendingAction(actionId)?.let { action ->
            runCatching {
                Json.parseToJsonElement(action.argumentsJson).jsonObject[key]?.jsonPrimitive?.contentOrNull
            }.getOrNull()
        }
    }

    private suspend fun providerTaskProviderId(actionId: String?, taskSlot: String?): String? {
        if (actionId.isNullOrBlank()) return null
        val key = providerTaskProviderKey(taskSlot)
        return dao.pendingAction(actionId)?.let { action ->
            runCatching {
                Json.parseToJsonElement(action.argumentsJson).jsonObject[key]?.jsonPrimitive?.contentOrNull
            }.getOrNull()
        }
    }

    private suspend fun rememberProviderTask(
        actionId: String?,
        taskSlot: String?,
        provider: ImageGenerationProvider,
        providerTaskId: String
    ) {
        if (actionId.isNullOrBlank()) return
        val action = dao.pendingAction(actionId) ?: return
        val key = providerTaskKey(taskSlot)
        val root = runCatching { Json.parseToJsonElement(action.argumentsJson).jsonObject }.getOrNull() ?: return
        val updated = buildJsonObject {
            root.forEach { (name, value) -> put(name, value) }
            put(key, providerTaskId)
            put(providerTaskProviderKey(taskSlot), provider.id)
        }
        dao.updatePendingActionArguments(actionId, updated.toString())
    }

    private suspend fun clearProviderTask(actionId: String?, taskSlot: String?) {
        if (actionId.isNullOrBlank()) return
        val action = dao.pendingAction(actionId) ?: return
        val key = providerTaskKey(taskSlot)
        val root = runCatching { Json.parseToJsonElement(action.argumentsJson).jsonObject }.getOrNull() ?: return
        val updated = buildJsonObject {
            root.filterKeys { it != key && it != providerTaskProviderKey(taskSlot) }.forEach { (name, value) -> put(name, value) }
        }
        dao.updatePendingActionArguments(actionId, updated.toString())
    }

    /**
     * 这一版**真正送去渲染**过的最终提示词；没有就返回 null。
     *
     * 「重新生成」= 重新生成**照片**：有这个就直接拿它重出（先拉同提示词那一张、拉不到再提交），
     * 绝不再跑一遍写提示词的模型——提示词一变，出的就不是同一张图。
     */
    private suspend fun renderedPrompt(actionId: String?, taskSlot: String?): String? {
        if (actionId.isNullOrBlank()) return null
        val key = renderedPromptKey(taskSlot)
        return dao.pendingAction(actionId)?.let { action ->
            runCatching {
                Json.parseToJsonElement(action.argumentsJson).jsonObject[key]?.jsonPrimitive?.contentOrNull
            }.getOrNull()
        }?.takeIf(String::isNotBlank)
    }

    /** 出图成功后按任务记下这份最终提示词，供「重新生成 / 重试」原样复用。 */
    private suspend fun rememberRenderedPrompt(actionId: String?, taskSlot: String?, prompt: String) {
        if (actionId.isNullOrBlank()) return
        val action = dao.pendingAction(actionId) ?: return
        val key = renderedPromptKey(taskSlot)
        val root = runCatching { Json.parseToJsonElement(action.argumentsJson).jsonObject }.getOrNull() ?: return
        val updated = buildJsonObject {
            root.forEach { (name, value) -> put(name, value) }
            put(key, prompt.trim())
        }
        dao.updatePendingActionArguments(actionId, updated.toString())
    }

    private fun renderedPromptKey(taskSlot: String?): String =
        if (taskSlot.isNullOrBlank()) {
            com.aster.companion.system.ImageGenerationRetryPolicy.RENDERED_PROMPT_KEY
        } else {
            "${com.aster.companion.system.ImageGenerationRetryPolicy.RENDERED_PROMPT_KEY}:$taskSlot"
        }

    private fun providerTaskKey(taskSlot: String?): String =
        if (taskSlot.isNullOrBlank()) PROVIDER_TASK_ID_KEY else "$PROVIDER_TASK_ID_KEY:$taskSlot"

    private fun providerTaskProviderKey(taskSlot: String?): String =
        if (taskSlot.isNullOrBlank()) PROVIDER_TASK_PROVIDER_ID_KEY else "$PROVIDER_TASK_PROVIDER_ID_KEY:$taskSlot"

    private suspend fun isImageActionRunning(actionId: String?): Boolean =
        actionId.isNullOrBlank() || dao.pendingAction(actionId)?.state == "RUNNING"

    /** Marks provider work as cancelled without allowing a late image to reach the conversation. */
    suspend fun cancelProviderTasks(action: com.aster.companion.data.PendingActionEntity) {
        val arguments = runCatching { Json.parseToJsonElement(action.argumentsJson).jsonObject }.getOrNull() ?: return
        val fallback = dao.modelProfile(IMAGE_GENERATION_MODEL)
        arguments.entries
            .filter { (key, _) -> key.startsWith(PROVIDER_TASK_ID_KEY) }
            .forEach { (taskKey, value) ->
                val taskId = value.jsonPrimitive.contentOrNull?.takeIf(String::isNotBlank) ?: return@forEach
                val suffix = taskKey.removePrefix(PROVIDER_TASK_ID_KEY)
                val providerId = arguments["$PROVIDER_TASK_PROVIDER_ID_KEY$suffix"]?.jsonPrimitive?.contentOrNull
                    ?: "legacy-image-model"
                val provider = providerPool.providerById(providerId, fallback) ?: return@forEach
                when {
                    ComfyUiProtocol.supports(provider.profile) -> comfyClient.cancel(provider.profile, taskId)
                    else -> client.cancelImageTask(provider.profile, provider.apiKey, taskId)
                }
            }
        // 纯 OpenAI 路径没有 provider task id：再按提示词内容让网关把正在跑/排队的那张真的掐掉，
        // 不然本地点了「取消」，电脑那边还在白跑一张。
        runCatching {
            val scene = arguments["scene"]?.jsonPrimitive?.contentOrNull?.takeIf(String::isNotBlank)
                ?: return@runCatching
            val size = arguments["size"]?.jsonPrimitive?.contentOrNull.orEmpty()
            val provider = providerPool.useProvider(fallback, null) { it } ?: return@runCatching
            if (!ComfyUiProtocol.supports(provider.profile)) {
                client.cancelImageByPrompt(provider.profile, provider.apiKey, scene, size)
            }
        }
    }

    companion object {
        const val IMAGE_GENERATION_MODEL = "image_generation"
        private const val PROVIDER_TASK_ID_KEY = "provider_task_id"
        private const val PROVIDER_TASK_PROVIDER_ID_KEY = "provider_task_provider_id"
        private const val MAX_WAKE_LOCK_MS = 60 * 60 * 1000L
        private const val MAX_IMAGE_CONTEXT_MESSAGES = 32
        val ImageLaneBusyException = IllegalStateException("Image lane is busy")
        private const val TAG = "TongpinImageTiming"
    }
}
