package com.aster.companion.agent.world

import com.aster.companion.data.CharacterEntity
import com.aster.companion.data.CharacterLivingStateEntity
import com.aster.companion.data.WorldLocationEntity
import com.aster.companion.data.WorldStateRowEntity
import com.aster.companion.data.WorldUserStateEntity

/** Public, first-person-safe world state for the current Compose UI and future clients. */
data class WorldSceneProjection(
    val worldTime: Long,
    val timePhase: String,
    val weather: String,
    val environment: String,
    val locationId: String,
    val locationName: String,
    val sceneNarration: String,
    val characters: List<WorldSceneCharacter>,
    val nearbyLocations: List<WorldSceneLocation> = emptyList(),
    val availableActions: List<WorldSceneAction>
)

data class WorldSceneCharacter(
    val characterId: String,
    val name: String,
    val locationId: String,
    val locationName: String,
    val activity: String
)

data class WorldSceneLocation(
    val locationId: String,
    val name: String
)

enum class WorldSceneAction {
    MOVE,
    OBSERVE,
    WAIT,
    REST,
    OPEN_PHONE,
    FREE_ACTION
}

object WorldSceneProjectionBuilder {
    private const val FALLBACK_LOCATION_ID = "home.unknown"
    private const val FALLBACK_LOCATION_NAME = "家中"

    fun build(
        world: WorldStateRowEntity,
        user: WorldUserStateEntity,
        locations: List<WorldLocationEntity>,
        characters: List<CharacterEntity>,
        livingStates: List<CharacterLivingStateEntity>
    ): WorldSceneProjection {
        val locationById = locations.associateBy { it.id }
        val userLocation = locationById[user.locationId]
        val locationId = userLocation?.id ?: FALLBACK_LOCATION_ID
        val locationName = userLocation?.displayName ?: FALLBACK_LOCATION_NAME
        val livingByCharacterId = livingStates.associateBy { it.characterId }
        val visibleCharacters = characters.map { character ->
            val living = livingByCharacterId[character.id]
            val characterLocation = locationById[living?.locationId]
            WorldSceneCharacter(
                characterId = character.id,
                name = character.name,
                locationId = characterLocation?.id ?: FALLBACK_LOCATION_ID,
                locationName = characterLocation?.displayName ?: FALLBACK_LOCATION_NAME,
                activity = living?.currentActivity?.ifBlank { "安静待着" } ?: "安静待着"
            )
        }
        val nearbyLocations = locations
            .filter {
                it.id != locationId &&
                    (it.id == WorldLocationCatalog.HOME_ID ||
                        it.parentId == WorldLocationCatalog.HOME_ID ||
                        it.id == "outside")
            }
            .sortedBy { it.id }
            .map { WorldSceneLocation(it.id, it.displayName) }
        return WorldSceneProjection(
            worldTime = world.worldTime,
            timePhase = world.timePhase.ifBlank { "此刻" },
            weather = world.weather,
            environment = world.environment,
            locationId = locationId,
            locationName = locationName,
            sceneNarration = sceneNarration(locationName, world.timePhase, world.environment),
            characters = visibleCharacters,
            nearbyLocations = nearbyLocations,
            availableActions = WorldSceneAction.entries
        )
    }

    private fun sceneNarration(locationName: String, timePhase: String, environment: String): String = buildString {
        append("你现在在")
        append(locationName)
        append("。")
        timePhase.takeIf { it.isNotBlank() }?.let { append(it).append("。") }
        environment.takeIf { it.isNotBlank() }?.let { append(it).append("。") }
    }
}
