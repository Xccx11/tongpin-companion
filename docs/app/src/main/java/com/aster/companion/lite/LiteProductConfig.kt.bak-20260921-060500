package com.aster.companion.lite

/**
 * Lite 产品变体的集中开关与常量。
 *
 * Lite 是「产品变薄」而不是完整版里勾选出来的开关组合：私聊 + 朋友圈 + 发照片/配图，
 * 提示词短、可吃满本地 4 并发，聊天与生图两条流水线分离。
 *
 * 这里只放配置与常量，不放业务逻辑，方便验收时按计划书 §4–§7 逐项核对。
 */
object LiteProductConfig {
    /** Lite 产品路径总开关。关闭时回退到完整版行为（世界页、群聊、设备能力全部保留）。 */
    const val ENABLED: Boolean = true

    // ---- 对话（计划书 §4）----

    /** Lite 私聊只发送最近 N 条历史（省 token、也避免小模型被长上下文带偏）。 */
    const val CHAT_HISTORY_LIMIT = 20

    /**
     * 非 Lite（带工具）路径的历史上限。
     *
     * 以前这条路径**把整条会话历史原样发给模型**（没有任何上限）——聊得越久越慢越贵，
     * 而且老话题被无节制回灌。网关其实只做 system 归并、**不做压缩**（那句"摘要由网关负责"是错的），
     * 所以上限必须由 App 自己把住。
     */
    const val CHAT_HISTORY_LIMIT_FULL = 40

    /** 人设截断上限（字符数）。 */
    const val PERSONALITY_LIMIT = 2000

    /** 关系设定截断上限（字符数）。 */
    const val RELATIONSHIP_LIMIT = 120

    /** 注入 system 的「记得的事」最多条数。 */
    const val REMEMBERED_FACTS_LIMIT = 5

    /** 嵌进 system 的最近聊天摘录行数（小模型更吃 system 里的上下文）。 */
    const val RECENT_TRANSCRIPT_LIMIT = 12

    // ---- 生图（计划书 §5）----

    /** 人物外观锚点截断上限（字符数）。 */
    const val APPEARANCE_LIMIT = 600

    /** Scene 取最近多少条对话做简报。24 条：脱衣/换场景这类转折常在更早几条里。 */
    const val SCENE_RECENT_MESSAGES = 24

    /** Scene 每条最近消息截断长度（太短接不住上下文）。 */
    const val SCENE_BRIEF_CHARS = Int.MAX_VALUE

    /** Scene 输出不合格时的自动重试次数，仍失败则交由状态卡手动重试。 */
    const val SCENE_MAX_ATTEMPTS = 2

    /**
     * Scene 递进细化的轮数：第 1 轮生成之后再细化这么多次（共 1 + N 轮）；任一轮失败即停。
     *
     * 设成 2 = 一共三轮。第 3 轮的规则（`image.sceneRule.wai.pass3`）专门盯
     * **肢体关节、布料褶皱与贴身程度、皮肤与眼神的质感** —— 而实测第 2 轮写出来的标签串
     * 恰恰在这几项上很笼统（一次只有 58 个 tag：表情 4 个笼统词、服饰 2 件且没有材质和状态）。
     *
     * 现在是 **0**：用户要求换回 9/13 的流程（一轮出图），细化轮整个不跑——
     * `ScenePromptCoordinator` 里也已经不再调用 `refine()`。远程规则与内置默认都还在，
     * 将来要重新打开，把这个值改回去并把那次 `refine()` 调用接回来即可。
     *
     * 代价：出图前多一次 LLM 调用，要和渲染抢同一张卡（见交接文档 §8.3）。
     */
    const val SCENE_REFINE_PASSES = 0

    /**
     * 默认出图尺寸：**竖幅 2:3**。
     *
     * 原来用 768x1024（3:4），全身人像塞进去仍然偏挤——模型会自己裁成头肩特写。
     * 832x1216 是 SDXL 系的标准竖幅，全身构图（从头顶到脚）才有地方站。
     *
     * 可以在设置里改。
     */
    const val IMAGE_SIZE = "832x1216"

    /**
     * 「图片提示词」这一步可以单独配模型（设置 → 模型 → 图片提示词）。
     *
     * 以前这一步固定用**对话模型**，所以"聊天用便宜的小模型、总结出图提示词用聪明的大模型"做不到。
     * 没配（或没启用 / 没 key）时**照旧沿用对话模型**，升级后行为不变。
     */
    const val IMAGE_PROMPT_MODEL = "image_prompt"

    /** 单个 tag 片段允许的最大词数，超过视为英文叙述句。 */
    const val TAG_MAX_WORDS = 8

    /**
     * Lite 底部导航保留的标签：消息 / 动态 / **日记** / 设置。
     *
     * 「日记」原来只在关系主页里有个入口，而关系主页要点进角色才到得了 —— 等于藏起来了。
     * `MainTab` 的声明顺序里 `Memory` 紧跟 `Moments`，所以放进底栏后它天然排在朋友圈旁边。
     */
    val BOTTOM_TABS: Set<String> = setOf("Chat", "Moments", "Memory", "Settings")
}
