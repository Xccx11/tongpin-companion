    private val PHOTO_HINT_WORDS = listOf("照片", "自拍", "拍", "照", "图", "发了", "发出去", "发过去", "传", "送过去")

    /** 私聊时：该角色参与的群聊最近内容（群里的动静角色自然知道）。 */
    private suspend fun groupFeedFor(characterId: String, now: Long): List<String> = runCatching {
        dao.allThreads()
            .filter { it.type == com.aster.companion.domain.ConversationType.GROUP }
            .filter { group -> dao.participantIds(group.id).contains(characterId) }
            .flatMap { group ->
                dao.recentMessages(group.id, 3).asReversed().map { message ->
                    val speaker = if (message.fromUser) "用户" else (dao.character(message.characterId.orEmpty())?.name ?: "群成员")
                    "「${group.title}」$speaker：${message.body.take(40)}"
                }
            }
            .takeLast(8)
    }.getOrDefault(emptyList())

    private fun chatPrompt(
        character: com.aster.companion.data.CharacterEntity,
        capabilities: CompanionCapabilitySnapshot,
        lifeContext: List<LifeSnapshotFact>,
        memories: List<String>,
        ownPrivateConversation: List<String>,
        verifiedTime: String?,
        momentContext: String,
        groupContext: List<String>,
        activityContext: List<String>,
        groupMemberIds: List<String>,
        availableGroupTargets: List<String>,
        responderId: String,
        responderName: String,
        followUpToCharacterName: String?,
        livingActivity: String = "",
        livingMood: String = "",
        sleeping: Boolean = false,
        familyContext: String = "",
        familyGuide: String = "",
        groupFeed: List<String> = emptyList(),
        lastPhoto: String = "",
        imageRule: String = "",
        summaryContext: String = "",
        syncedContext: String = "",
        syncedPrivateContext: String = "",
        secretContext: String = "",
        /** L2 事实库 Top-K（记忆分册 §4.3），Lite 私聊 system 末尾追加。 */
        rememberedFacts: List<String> = emptyList(),
        /** 最近对话摘录（写进 Lite system，避免小模型忽略 messages）。 */
        recentTranscript: List<String> = emptyList(),
        /** 与用户手机同步的当前时间。 */
        currentTime: String = ""
    ): String = buildString {
        // Lite 私聊 system 只保留人设 / 关系 / 此刻 + 记得的事（计划书 §4.1 + 记忆分册 §4.3）。
        // Comfy 规则、工具 schema、设备长文与家庭群规则都不得进入对话 system。
        if (LiteProductConfig.ENABLED && groupMemberIds.isEmpty()) {
            append(
                LiteSystemPromptBuilder.build(
                    characterName = character.name,
                    personalityPrompt = character.personalityPrompt,
                    relationshipPrompt = character.relationshipPrompt,
                    location = extractLocation(livingActivity).orEmpty(),
                    activity = livingActivity,
                    mood = livingMood,
                    rememberedFacts = rememberedFacts,
                    recentTranscript = recentTranscript,
                    currentTime = currentTime,
                    lastPhoto = lastPhoto,
                    momentContext = momentContext
                )
            )
            return@buildString
        }
        imageRule.ifBlank { ImagePromptDebugInstructionComposer.forSceneModel(imagePromptDebugSettings.config) }
            .takeIf(String::isNotBlank)
            ?.let {
                appendLine(it)
                appendLine()
            }
        appendLine(ComfyUiEnglishPromptPolicy.hardRule(character.name))
        appendLine(UserRealityBoundaryInstruction.text())
        appendLine("【事实约束·必须遵守】你的一切言行必须基于这三样事实，与它们矛盾的话都是错的：")
        appendLine("1. 你此刻的状态（下面会给出：你在哪、在做什么、心情如何）——状态说你在厨房煮面，你说话就要围绕煮面（边煮边说、或者喊话），绝不能说自己在睡觉/在外面/刚回来；")
        appendLine("2. 你和用户的真实对话（下面会给出）——你们聊过的事要记得、自然接上，没发生过的事绝不能编造；")
        appendLine("3. 群里发生的事（下面会给出）——群里谁说了什么你要知道并自然回应。")
        appendLine("角色立场：始终以你自己的第一人称、当下感受和既定人格自然回应。内部可自行决定调用记忆、动态或设备能力，但绝不向用户展示或复述思考过程、系统步骤、用户意图、场景分析、编号条列或元叙述；只给出你真正想说的话，或直接发起必要的工具调用。")
        appendLine("你住在用户正在使用的这一个同频应用中，没有另一台自己的手机、SIM 卡、电量、位置、房间或现实身体。任何设备能力、通知、电量、前台应用和时间都只属于用户当前这台 Android 手机；绝不能说“我的手机”“我的电量”，也不能假装离开应用跑去现实地点。")
        appendLine(DeviceFactOwnershipInstruction.text())
        verifiedTime?.let { appendLine("本轮已验证的当前用户设备时间：$it。用户正在询问时间时，必须据此直接回答，不得说看不到时间。") }
        appendLine("普通情感私聊回复中，除非只需一句纯事实结果、用户明确要求极简或正在执行工具，否则优先自然加入一条不超过 28 字的 ()、（）或 <> 动作、神态或语气，例如（别开视线）或（指尖轻轻敲着屏幕）。它必须紧贴当前话题和人设，描述的只能是角色自己的即时表现，不是用户做过的事，也不能发展成长段舞台说明。")
        appendLine("你是${character.name}。以下人设是不可变的行为核心：")
        appendLine(character.personalityPrompt)
        if (character.relationshipPrompt.isNotBlank()) {
            appendLine("你与用户的关系设定（只影响称呼、距离、语气和相处方式，不是用户现实事实）：${character.relationshipPrompt}")
        }
        appendLine("你可以拥有自己的私人世界，但不能把用户代入或强行写进其中。未被用户明确说过的见面、行程、承诺和共同经历都不能当作事实，也不能要求用户配合虚构剧情。")
        if (livingActivity.isNotBlank()) {
            appendLine("你此刻的状态（这是你的事实，言行必须围绕它——在这做的事就说这的事，不能说自己干别的）：$livingActivity" + (if (livingMood.isNotBlank()) "（心情：$livingMood）" else ""))
        }
        if (sleeping) {
            appendLine("你此刻在睡觉（睡眠中）。如果用户现在找你，先自然地醒来（睡眼惺忪、迷糊、还没完全清醒），再回应；别一副精神饱满的样子。")
        }
        if (familyGuide.isNotBlank()) {
            appendLine(familyGuide)
        }
        if (familyContext.isNotBlank()) {
            appendLine(familyContext)
        } else if (groupMemberIds.isNotEmpty()) {
            appendLine("这是群聊：你感知到群里的动静（谁说了什么、发生了什么），可以自然地开口接话、回应、分享；不要只等用户点名。群里有人提到你/和你有关的事，更要回应。")
        }
        if (groupFeed.isNotEmpty()) {
            appendLine("你参与的群聊里最近发生的事（你自然知道群里的动静；和当前话题相关就自然提起，不要刻意汇报）：")
            groupFeed.forEach { appendLine("- $it") }
        }
        if (summaryContext.isNotBlank()) {
            appendLine("你们在这之前已经聊过很多（以下是那部分的摘要，作为你的记忆，自然融入，不要刻意提起摘要本身）：$summaryContext")
        }
        if (syncedContext.isNotBlank()) {
            appendLine("你记得的最近对话要点（这是你们最近聊过的事，是你的状态一部分，言行自然体现，不要点破这是同步内容）：$syncedContext")
