    private fun normalizeGroupImageAction(
        action: AgentActionRequest,
        respondingCharacterId: String,
        currentMemberIds: List<String>,
        imageArguments: Map<String, String>
    ): AgentActionRequest? {
        val rawParticipants = action.arguments["participant_character_ids"]
        val selected = if (rawParticipants.isNullOrBlank()) {
            listOf(respondingCharacterId)
        } else {
            GroupImagePromptPolicy.parseParticipantIds(rawParticipants, currentMemberIds.toSet()) ?: return null
        }
        val mode = GroupImagePromptPolicy.resolveMode(action.arguments["group_image_mode"], selected)
            ?: GroupImagePromptPolicy.inferMode(imageArguments["scene"], selected)
            ?: selected.singleOrNull()?.let { GroupImageMode.SINGLE }
            ?: return null
        return action.copy(arguments = imageArguments + mapOf(
            "character_id" to (action.arguments["character_id"]?.takeIf { it in selected } ?: respondingCharacterId),
            "participant_character_ids" to selected.joinToString(","),
            "group_image_mode" to mode.name
        ))
    }

    private fun groupImageProposalAction(proposal: GroupImageActionPolicy.Proposal): AgentActionRequest = AgentActionRequest(
        capabilityId = "companion.propose_image",
        transport = ActionTransport.LOCAL,
        confirmation = ConfirmationRequirement.REQUIRED,
        arguments = mapOf(
            "character_id" to proposal.requestingCharacterId,
            "participant_character_ids" to proposal.participantCharacterIds.joinToString(","),
            "group_image_mode" to proposal.mode.name,
            "scene" to proposal.scene
        )
    )

