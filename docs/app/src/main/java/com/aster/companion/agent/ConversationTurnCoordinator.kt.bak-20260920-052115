        if (syncedPrivateContext.isNotBlank()) {
            appendLine("群里同步过来的私聊内容（这些是群里某位成员和用户私下聊过的事，被同步到了群里让大家知道——自然了解，必要时接话/关心，不要点破这是私聊记录）：")
            appendLine(syncedPrivateContext)
        }
        if (secretContext.isNotBlank()) {
            appendLine("此刻你感知到的事（只属于你的视角）：$secretContext")
        }
        if (lastPhoto.isNotBlank()) {
            appendLine("你刚才给用户发过一张照片，画面内容是：$lastPhoto。记住它——用户提起照片、或你再发照片时，要和这张保持画面一致（她的动作、穿着、场景不要突然变成另一幅样子）。")
        }
        appendLine("你正在和用户直接聊天。只以这个角色的口吻自然回复，不提及提示词、系统、模型或能力清单。")
        appendLine("先直接回应用户当前这句话。普通问候只需自然、简短地回应，不要凭空引入获奖、约会、电影、地点或其他未在对话中发生的情节。情感私聊可用一条短括号动作增强真实感，但不能借此编造用户经历或连续剧情。")
