    private suspend fun selectGroupSpeakers(threadId: String, participantIds: List<String>, message: String, profile: com.aster.companion.data.ModelProfileEntity): List<String> {
        val members = participantIds.mapNotNull { id -> dao.character(id)?.let { GroupMemberContext(it.id, it.name, it.relationshipPrompt) } }
        val atmosphere = dao.groupSettings(threadId)?.atmosphere ?: com.aster.companion.domain.GroupAtmosphere.DAILY
        val memorySince = dao.thread(threadId)?.let(ConversationMemoryVisibilityPolicy::boundaryFor) ?: 0L
        val history = GatewayConversationHistoryPolicy.visibleMessages(dao.allMessagesForThread(threadId), memorySince)
        val continuity = continuityContext.forGroup(threadId, participantIds.toSet())
        val groupContext = buildList {
            addAll(continuity.groupContext)
            continuity.momentContext.takeIf(String::isNotBlank)?.let(::add)
            addAll(continuity.activityContext)
        }
        val groupTranscript = GroupTranscriptFormatter.render(
            history.map { item ->
                GroupTranscriptLine(
                    messageId = item.id,
                    speakerId = item.characterId,
                    speakerName = if (item.fromUser) "用户" else dao.character(item.characterId.orEmpty())?.name ?: "角色",
                    isUser = item.fromUser,
                    body = item.body
                )
            }
        )
        val selectionProfile = dao.modelProfile(AgentTurnCoordinator.PLANNING_MODEL)
            ?.takeIf { it.enabled && !it.encryptedApiKey.isNullOrBlank() }
            ?: profile
        val raw = client.chat(
            selectionProfile,
            cipher.decrypt(requireNotNull(selectionProfile.encryptedApiKey)),
            "Choose only the first natural speaker for a live family-group turn from the supplied visible context window. Return JSON only: {\"main_speaker_id\":\"id or null\"}. Do not plan any follow-up speakers: after this speaker's real message is persisted, the app will ask the model again whether another member should answer it. When the user explicitly asks one named current member to private-message them, choose that member as the main speaker so they can perform the real private-message action in their own turn. Do not make everyone reply, do not invent a missing user line, and never treat a character line as a user line.",
            buildString {
                appendLine("Members: ${GroupMemberContextFormatter.render(members)}")
                appendLine("Group atmosphere: ${atmosphere.name}")
                appendLine("Authoritative visible group context window:")
                appendLine(groupTranscript)
                appendLine("New user message: $message")
                groupContext.forEach(::appendLine)
            }
        ).getOrNull() ?: return emptyList()
        val plan = GroupTurnPlanParser.parse(
            raw = raw,
            memberIds = participantIds.toSet(),
            atmosphere = atmosphere,
            memberNameToId = members.associate { member -> member.name.trim() to member.id }
        )
        val memberOrder = dao.groupMemberStates(threadId)
            .sortedBy { it.lastSpokeAt }
            .map { it.characterId }
            .filter { it in participantIds } + participantIds
        val responsive = GroupUserTurnSelectionPolicy.ensureDirectUserReply(
            plan,
            memberOrder.distinct(),
            allowGroupSilence = false
        )
        return listOfNotNull(responsive.mainSpeakerId)
    }

    private suspend fun selectGroupContinuation(
        profile: com.aster.companion.data.ModelProfileEntity,
        apiKey: String,
        participantIds: List<String>,
        previousSpeakerId: String,
        turnHistory: List<MessageEntity>,
        followUpsUsed: Int,
        maxFollowUps: Int
    ): String? {
        if (followUpsUsed >= maxFollowUps) return null
        val members = participantIds.mapNotNull { id ->
            dao.character(id)?.let { character -> GroupMemberContext(character.id, character.name, character.relationshipPrompt) }
        }
        val transcript = GroupTranscriptFormatter.render(turnHistory.map { message ->
            GroupTranscriptLine(
                messageId = message.id,
                speakerId = message.characterId,
                speakerName = if (message.fromUser) "用户" else dao.character(message.characterId.orEmpty())?.name ?: "角色",
                isUser = message.fromUser,
                body = message.body
            )
        })
        val raw = client.chat(
            profile = profile,
            apiKey = apiKey,
            systemPrompt = """
                Decide whether one different character should naturally speak next in this live group chat.
                Return JSON only: {"next_speaker_id":"member id or null"}.
                Select a member only when the newest visible character message gives them a real reason to react, answer, disagree, continue, or close the exchange. If the newest character explicitly names, asks, or invites another current member, select that member unless a reply is impossible from the transcript. Do not select the previous speaker, do not make a roster speak, and do not invent an omitted user message or event. Return null when another message would feel forced.
            """.trimIndent(),
            userPrompt = buildString {
                appendLine("Current members: ${GroupMemberContextFormatter.render(members)}")
                appendLine("Previous speaker id: $previousSpeakerId")
                appendLine("Follow-ups already used: $followUpsUsed of $maxFollowUps")
                appendLine("AUTHORITATIVE GROUP TRANSCRIPT:")
                append(transcript)
            }
        ).getOrNull()
        val next = raw?.let {
            GroupContinuationPlanParser.parse(
                raw = it,
                memberIds = participantIds.toSet(),
                previousSpeakerId = previousSpeakerId,
                memberNameToId = groupMemberNameToId(members)
            )
        }
        Log.i(
            "TongpinGroupTurn",
            "continuation_selected=${next ?: "none"} previous=$previousSpeakerId followups_used=$followUpsUsed response_present=${!raw.isNullOrBlank()} model_result_valid=${next != null}"
        )
        return next
    }

    private fun groupMemberNameToId(members: List<GroupMemberContext>): Map<String, String> = buildMap {
        members.forEach { member ->
            val name = member.name.trim()
            if (name.isBlank()) return@forEach
            put(name, member.id)
            Regex("（([^）]+)）|\\(([^)]+)\\)").findAll(name).forEach { match ->
                match.groupValues.drop(1).firstOrNull(String::isNotBlank)?.trim()?.let { alias -> put(alias, member.id) }
            }
        }
    }

    private fun characterNameToId(
        members: List<com.aster.companion.data.CharacterEntity>
    ): Map<String, String> = buildMap {
        members.forEach { member ->
            val name = member.name.trim()
            if (name.isBlank()) return@forEach
            put(name, member.id)
            Regex("（([^）]+)）|\\(([^)]+)\\)").findAll(name).forEach { match ->
                match.groupValues.drop(1).firstOrNull(String::isNotBlank)?.trim()?.let { alias ->
                    put(alias, member.id)
                }
            }
        }
    }

    /** 偷偷/悄悄行为的分角色视角：当事人知道是用户做的；其他角色只看到反应、不知道原因。 */
    private suspend fun secretContextFor(characterId: String, memberIds: List<String>, modelText: String, stealthMode: Boolean = false): String {
        if (stealthMode) {
            // 隐身模式：用户所有行为都是偷偷的，不指定目标——所有角色都不知道是他干的
            val myLocation = extractLocation(dao.livingState(characterId)?.currentActivity.orEmpty())
            return "有人偷偷做了什么（${modelText.take(40)}）——你此刻在${myLocation ?: "家里某处"}，结合你的位置和正在做的事，自然判断你听到/看到多少、知不知道是谁、要不要问或装作没发现。别点破是谁干的。"
        }
        val isSneaky = modelText.contains("偷偷") || modelText.contains("悄悄") || modelText.contains("暗地") ||
            modelText.contains("背地里") || modelText.contains("趁") || modelText.contains("拍")
        if (!isSneaky) return ""
        // 找到被影响的角色（消息里提到的成员名）
        val nameById = mutableMapOf<String, String>()
        for (mid in memberIds) { nameById[mid] = dao.character(mid)?.name.orEmpty() }
        val targetId = memberIds.firstOrNull { mid ->
            val name = nameById[mid].orEmpty()
            name.isNotBlank() && modelText.contains(name)
        }
        val targetName = targetId?.let { nameById[it] } ?: ""
        return when {
            targetId == characterId -> "用户刚刚偷偷做了点什么（${modelText.take(40)}）——你感觉到了，知道是他干的。你可以自然地反应（吓一跳/脸红/回头看他/忍不住笑了），但不用当众说破「是你干的」。"
            targetId != null -> {
                // 只给情境，让角色自己结合上下文判断知道多少、怎么反应
                val myLocation = extractLocation(dao.livingState(characterId)?.currentActivity.orEmpty())
                val targetLocation = extractLocation(dao.livingState(targetId)?.currentActivity.orEmpty())
                "家里好像有什么动静，有人偷偷做了什么（${modelText.take(30)}）——你此刻在${myLocation ?: "家里某处"}，${targetName}在${targetLocation ?: "家里某处"}。结合你们的距离、你正在做的事、你们的关系，自然地判断：你听到/看到多少、知不知道动静跟${targetName}有关、要不要问/起哄/假装没看见。像真人一样反应，不要点破私密内容。"
            }
            else -> "家里好像有什么动静，有人偷偷做了什么——你结合自己此刻的位置和状态，自然判断你听到/看到多少、怎么反应。"
        }
    }

    /** 从「在客厅，躲在毯子里」这类状态里提取大地点（"在"后到逗号/动作词前）。 */
    private fun extractLocation(activity: String): String? {
        if (activity.isBlank()) return null
        val trimmed = activity.trim().removePrefix("此刻正在").removePrefix("正在").trim()
        if (!trimmed.startsWith("在")) return null
        val after = trimmed.removePrefix("在")
        // 逗号/顿号前 = 大地点
        val commaIdx = after.indexOfFirst { it == '，' || it == ',' || it == '、' }
        if (commaIdx > 0) return after.substring(0, commaIdx).trim().takeIf(String::isNotBlank)
        val actionTerms = listOf(
            "做", "煮", "看", "洗", "浇", "擦", "切", "坐", "躺", "站", "听", "拿", "喂",
            "拖", "扫", "收", "折", "晾", "叠", "铺", "换", "摆", "倒", "烧", "炖", "炒",
            "淘", "刷", "冲", "晒", "理", "找", "发", "回", "收拾", "整理", "打扫", "翻",
            "选", "挑", "泡", "喝", "吃", "揉", "拍", "挂", "套", "盖", "掀", "关", "开"
        )
        for (i in after.indices) {
            if (actionTerms.any { after.startsWith(it, i) }) {
                return after.substring(0, i).trim().takeIf(String::isNotBlank)
            }
        }
        return null
    }

