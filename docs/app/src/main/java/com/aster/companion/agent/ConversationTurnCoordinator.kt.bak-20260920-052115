/** Handles user-initiated private and group turns using only the configured conversation model. */
@Singleton
class ConversationTurnCoordinator @Inject constructor(
    private val dao: CompanionDao,
    private val cipher: CompanionSecretCipher,
    private val client: OpenAiCompatibleClient,
    private val shizukuStatusProvider: ShizukuStatusProvider,
    private val shizukuRouter: ShizukuFixedActionRouter,
    private val actionCoordinator: CompanionActionCoordinator,
    private val timeline: CompanionTimelineRecorder,
    private val lifeSnapshotFactory: LifeSnapshotFactory,
    private val photoIntentClassifier: DeepSeekPhotoIntentClassifier,
    private val continuityContext: CompanionContinuityContextAssembler,
    private val semanticMemoryRetriever: SemanticMemoryRetriever,
    private val imagePromptDebugSettings: ImagePromptDebugSettings,
    private val imageRuleResolver: ImageGenerationRuleResolver,
    private val worldSimulation: WorldBatchSimulationCoordinator,
    private val liteMemorySelector: com.aster.companion.lite.memory.LiteMemorySelector,
    private val scenePromptCoordinator: ScenePromptCoordinator,
    private val liteScenePhotoBus: com.aster.companion.lite.LiteScenePhotoBus,
    private val liteMemoryRollup: com.aster.companion.lite.memory.MemoryRollupCoordinator,
    /**
     * 会话摘要（滚动压缩）：以前**全仓没人调用它**，`companion_thread_summaries` 永远是空表，
     * 于是"聊久了还记得前面的事"这件事从来没生效过。现在由回合结束后触发、并把摘要注入 Lite 的 system。
     */
    private val conversationSummarizer: ConversationSummarizer,
    private val backgroundIdle: com.aster.companion.lite.BackgroundIdleStore,
    private val deferredWork: com.aster.companion.lite.BackgroundDeferredWork,
    private val renderPromptBuilder: CharacterRenderPromptBuilder
) {
    private data class DeferredGroupImageRequest(
        val request: AgentActionRequest,
        val characterId: String
    )

    suspend fun send(
        threadId: String,
        userText: String,
        onActiveCharacterChanged: (String?) -> Unit = {}
    ): Result<Unit> =
        sendInternal(threadId, userText, userText, null, allowPhotoAction = true, onActiveCharacterChanged = onActiveCharacterChanged)

    /** Sends a visible image while using the vision model's private description as the dialogue context. */
    suspend fun respondToVisualContext(
        threadId: String,
        imageUri: String,
        visualDescription: String,
        persistUserImage: Boolean = true,
        onActiveCharacterChanged: (String?) -> Unit = {}
    ): Result<Unit> =
        sendInternal(
            threadId = threadId,
            modelText = "用户发来了一张图片。视觉模型客观描述如下：$visualDescription。请以当前角色的口吻自然回应这张图片。",
            displayBody = "",
            imageUri = imageUri,
            allowPhotoAction = false,
            persistUserMessage = persistUserImage,
            onActiveCharacterChanged = onActiveCharacterChanged
        )

    private suspend fun sendInternal(
        threadId: String,
        modelText: String,
        displayBody: String,
        imageUri: String?,
        allowPhotoAction: Boolean,
        persistUserMessage: Boolean = true,
        onActiveCharacterChanged: (String?) -> Unit = {}
    ): Result<Unit> = runCatching {
        require(modelText.isNotBlank()) { "Message cannot be empty" }
        val participantIds = dao.participantIds(threadId)
        require(participantIds.isNotEmpty()) { "Conversation has no characters" }
        val thread = requireNotNull(dao.thread(threadId)) { "Conversation was removed" }
        val threadType = thread.type
        val memorySince = ConversationMemoryVisibilityPolicy.boundaryFor(thread)
        val profile = requireNotNull(dao.modelProfile(AgentTurnCoordinator.CONVERSATION_MODEL)) { "Conversation model is not configured" }
        require(profile.enabled && !profile.encryptedApiKey.isNullOrBlank()) { "Conversation model is disabled" }
        val now = System.currentTimeMillis()
        val persistBeforeSpeakerSelection = ConversationTurnOrderPolicy.shouldPersistUserMessageBeforeSpeakerSelection(threadType, persistUserMessage)
        var currentUserMessageId: String? = null
        if (persistBeforeSpeakerSelection) {
            val message = MessageEntity(UUID.randomUUID().toString(), threadId, null, displayBody.trim(), imageUri, true, now)
            currentUserMessageId = message.id
            dao.insertMessage(message)
            timeline.recordMessage(message)
            dao.touchThread(threadId, now)
        }
        val respondingParticipantIds = if (threadType == com.aster.companion.domain.ConversationType.GROUP) {
            selectGroupSpeakers(threadId, participantIds, modelText, profile).take(1)
        } else participantIds
        val capabilitySnapshot = CapabilitySnapshotFactory.create(shizukuStatusProvider.current(shizukuRouter.isCommandChannelAlive))
        val lifeContext = if (threadType == com.aster.companion.domain.ConversationType.GROUP) emptyList() else lifeSnapshotFactory.capture(now)
        val verifiedTime = DeviceContextRequestPolicy.verifiedTimeContext(modelText, now)
        if (persistUserMessage && !persistBeforeSpeakerSelection) {
            val message = MessageEntity(UUID.randomUUID().toString(), threadId, null, displayBody.trim(), imageUri, true, now)
            currentUserMessageId = message.id
            dao.insertMessage(message)
            timeline.recordMessage(message)
            dao.touchThread(threadId, now)
        }
        val contextVersion = requireNotNull(dao.thread(threadId)) { "Conversation was removed" }.contextVersion
        val history = GatewayConversationHistoryPolicy.visibleMessages(
            messages = dao.allMessagesForThread(threadId),
            memorySince = memorySince
        )
        val precedingCompanionMessage = history.asReversed().firstOrNull { !it.fromUser }?.body
        val localPhotoIntent = ImageRequestPolicy.isPhotoGenerationRequest(modelText, precedingCompanionMessage)
        val semanticPhotoIntent = if (allowPhotoAction && participantIds.size == 1 && !localPhotoIntent) {
            photoIntentClassifier.wantsCharacterPhoto(
                modelText,
                history.takeLast(PHOTO_INTENT_CONTEXT_MESSAGE_LIMIT).map { message -> if (message.fromUser) "User: ${message.body}" else "Character: ${message.body}" }
            )
        } else false
        val directUserPhotoRequest = allowPhotoAction && participantIds.size == 1 &&
            ImageRequestPolicy.shouldStartCharacterPhotoGeneration(localPhotoIntent, semanticPhotoIntent)
        val photoGenerationRequested = directUserPhotoRequest
        val photoConversationContext = history.takeLast(PHOTO_SCENE_CONTEXT_MESSAGE_LIMIT).map { message ->
            if (message.fromUser) "用户：${message.body}" else "角色：${message.body}"
        }
        val deferredGroupImageRequests = mutableListOf<DeferredGroupImageRequest>()
        val completedSpeakerIds = mutableSetOf<String>()
        val turnHistory = history.toMutableList()
        val speakerQueue = ArrayDeque(respondingParticipantIds)
        val groupAtmosphere = dao.groupSettings(threadId)?.atmosphere ?: com.aster.companion.domain.GroupAtmosphere.DAILY
        var groupFollowUpsUsed = 0
        while (speakerQueue.isNotEmpty()) {
            val characterId = speakerQueue.removeFirst()
            val character = requireNotNull(dao.character(characterId)) { "Character unavailable" }
            val livingState = dao.livingState(characterId)
            val imageRule = imageRuleResolver.resolve()
            // 她要知道自己发过照片：内容是画面描述，带上时间，避免把几天前的照片当成"刚才"。
            val lastPhoto = dao.worldStates(characterId, "LAST_PHOTO").maxByOrNull { it.updatedAt }
                ?.let { state ->
                    "${state.content}（${com.aster.companion.lite.memory.LiteTimeFormat.stamp(state.updatedAt)}）"
                }
                .orEmpty()
            val familyGuide = if (threadType == com.aster.companion.domain.ConversationType.GROUP && dao.groupSettings(threadId)?.groupType == "FAMILY") {
                // 引导词随用户的第一句话一起发：切换后第一条用户消息才注入（引导写入时间 > 最近用户消息时间），之后不再重复。
                val guide = dao.worldStatesByThread(threadId, "FAMILY_GUIDE").maxByOrNull { it.updatedAt }
                val lastUserMsgAt = dao.recentMessages(threadId, 10).firstOrNull { it.fromUser }?.createdAt ?: 0L
                if (guide != null && guide.updatedAt > lastUserMsgAt) guide.content else ""
            } else ""
            val familyContext = if (threadType == com.aster.companion.domain.ConversationType.GROUP && dao.groupSettings(threadId)?.groupType == "FAMILY") {
                val groupThread = dao.thread(threadId)
                val memberIds = participantIds.filter { it != characterId }
                buildString {
                    appendLine("「${groupThread?.title ?: "咱们家"}」是你的家：${memberIds.mapNotNull { dao.character(it)?.name }.joinToString("、")}和你是一家人（真实亲情关系，比如姐妹/家人）。你们按家人相处：互相关心、记挂、会一起吃一起待着。")
                    appendLine("这不是远程群聊——你们在同一个家里，是一个真实的情景剧场：面对面说话，或者在别的房间就喊一声/走到一起说。说话方式要符合你此刻的状态（见上方生活状态）：你在厨房做饭就边做边说、你在卧室就隔着门喊话、你在客厅就正常面对面聊。")
                    appendLine("真实感规则（像真的一样）：你大致知道家里其他人此刻在哪个地方（比如姐姐在厨房、妹妹在客厅——同一个家里的人自然知道谁在哪边），但不知道她们具体在做什么——除非你听到动静、她们喊你、你路过看到、或者她们自己说起。就像真实生活：你知道姐姐在厨房，但不知道她在煮面还是洗碗。根据你听到/看到/被叫到的来反应，不要假装知道你没察觉的具体细节。")
                    val memberLocations = memberIds.mapNotNull { id ->
                        val member = dao.character(id) ?: return@mapNotNull null
                        val activity = dao.livingState(id)?.currentActivity.orEmpty()
                        member to extractLocation(activity)
                    }
                    if (memberLocations.isNotEmpty()) {
                        appendLine("你现在知道家里人大概在（同一屋檐下的自然感知）：")
                        memberLocations.forEach { (member, location) ->
                            appendLine("- ${member.name} 在${location ?: "家里某处"}")
                        }
                        appendLine("（只知道她们在哪，不知道具体在做什么——别假装知道细节。）")
                    }
                    appendLine("私密规则（双向）：用户可能小声对某位家人说话或偷偷做事；你也可以——想对某位家人单独说不想让别人听的话，用「（小声对XX说）内容」的格式；想偷偷做点什么，用「（偷偷）...」标注。规则：只有被说/被影响的那个人知道内容或原因；其他人只察觉有动静（听到小声嘀咕、看到有人脸红、有人鬼鬼祟祟），可以有自然的反应（好奇、起哄、追问），但绝不能说出私密内容、不能点破是谁干的或干了什么。当你看到带「（小声对XX说）」的消息时，说明那是她们之间的悄悄话——你只能感觉到有动静，听不清内容，不要假装知道。")
                }.toString()
            } else ""
            onActiveCharacterChanged(characterId)
            val groupTranscript = if (threadType == com.aster.companion.domain.ConversationType.GROUP) {
                GroupTranscriptFormatter.render(
                    turnHistory.map { message ->
                        GroupTranscriptLine(
                            messageId = message.id,
                            speakerId = message.characterId,
                            speakerName = if (message.fromUser) "用户" else dao.character(message.characterId.orEmpty())?.name ?: "角色",
                            isUser = message.fromUser,
                            body = message.body,
                            createdAt = message.createdAt
                        )
                    }
                )
            } else ""
            val followUpToCharacterName = if (threadType == com.aster.companion.domain.ConversationType.GROUP) {
                turnHistory.lastOrNull()
                    ?.takeIf { message -> !message.fromUser && message.characterId != character.id }
                    ?.characterId
                    ?.let { previousCharacterId -> dao.character(previousCharacterId)?.name }
            } else null
            val memories = when (threadType) {
                com.aster.companion.domain.ConversationType.PRIVATE -> directLongTermContext(
                    characterId = character.id,
                    threadId = threadId,
                    memorySince = memorySince,
                    recentHistory = turnHistory,
                    currentMessage = modelText,
                    lifeContext = lifeContext
                )
                com.aster.companion.domain.ConversationType.GROUP -> dao.trustedCharacterMemories(character.id, 12)
                    .filter { ConversationMemoryVisibilityPolicy.visibleMemory(it, memorySince) }
                    .map { "${it.kind.name}: ${it.content}" }
            }
            val ownPrivateConversation = if (threadType == com.aster.companion.domain.ConversationType.GROUP) {
                dao.latestPrivateThread(character.id)?.let { privateThread ->
                    GroupPrivateConversationContextPolicy.render(
                        ownerCharacterId = character.id,
                        lines = dao.recentMessages(privateThread.id, PRIVATE_GROUP_CONTEXT_LIMIT)
                            .asReversed()
                            .filter { message -> message.createdAt >= ConversationMemoryVisibilityPolicy.boundaryFor(privateThread) }
                            .map { message ->
                                GroupPrivateConversationContextPolicy.Line(
                                    characterId = message.characterId,
                                    fromUser = message.fromUser,
                                    body = message.body
                                )
                            }
                    )
                }.orEmpty()
            } else emptyList()
            val continuity = when (threadType) {
                com.aster.companion.domain.ConversationType.GROUP -> continuityContext.forGroup(
                    threadId = threadId,
                    memberIds = participantIds.toSet(),
                    now = now,
                    characterId = character.id
                )
                com.aster.companion.domain.ConversationType.PRIVATE -> continuityContext.forPrivateCharacter(character.id, threadId, now, memorySince)
            }
            val groupContext = continuity.groupContext
            val momentContext = continuity.momentContext
            val availableGroupTargets = if (threadType == com.aster.companion.domain.ConversationType.PRIVATE) {
                dao.allThreads()
                    .filter { group ->
                        group.type == com.aster.companion.domain.ConversationType.GROUP &&
                            character.id in dao.participantIds(group.id)
                    }
                    .map { group -> "group_thread_id=${group.id}; title=${group.title}" }
            } else emptyList()
            // 记忆分册 §4.3：有 Embedding 用向量 Top-K，否则回退关键词 + 重要度规则（都在 selector 内）。
            // 清空聊天/新窗口后：仅注入手动长期记忆（threadId=null）+ 本窗口边界后的记忆。
            val rememberedFacts = if (LiteProductConfig.ENABLED) {
                runCatching {
                    liteMemorySelector.select(
                        facts = dao.characterMemories(character.id, MEMORY_FACT_LIMIT)
                            .filter { ConversationMemoryVisibilityPolicy.visibleMemory(it, memorySince) }
                            .map { memory ->
                                com.aster.companion.lite.memory.LiteMemoryFact(
                                    id = memory.id,
                                    kind = memory.kind,
                                    content = memory.content,
                                    updatedAt = memory.updatedAt,
                                    blockedFromMention = memory.blockedFromMention
                                )
                            },
                        userText = modelText
                    )
                }.getOrDefault(emptyList())
            } else emptyList()
            val prompt = chatPrompt(
                character,
                capabilitySnapshot,
                lifeContext,
                memories,
                ownPrivateConversation,
                verifiedTime,
                momentContext,
                groupContext,
                continuity.activityContext,
                groupMemberIds = if (threadType == com.aster.companion.domain.ConversationType.GROUP) participantIds else emptyList(),
                availableGroupTargets = availableGroupTargets,
                responderId = character.id,
                responderName = character.name,
                followUpToCharacterName = followUpToCharacterName,
                livingActivity = livingState?.currentActivity.orEmpty(),
                livingMood = livingState?.mood.orEmpty(),
                sleeping = livingState != null && (livingState.sleepUntil?.let { now < it } == true),
                familyContext = familyContext,
                familyGuide = familyGuide,
                groupFeed = if (threadType == com.aster.companion.domain.ConversationType.PRIVATE) groupFeedFor(character.id, now) else emptyList(),
                lastPhoto = lastPhoto,
                imageRule = imageRule,
                summaryContext = buildString {
                    val recentMemories = runCatching {
                        dao.memoriesForThread(threadId)
                            .filter { ConversationMemoryVisibilityPolicy.visibleMemory(it, memorySince) }
                            .take(2)
                    }.getOrDefault(emptyList())
                    recentMemories.forEach { memory -> if (isNotBlank()) append("\n"); append("（过去的记忆：）${memory.content}") }
                }.trim(),
                syncedContext = if (threadType == com.aster.companion.domain.ConversationType.PRIVATE) {
                    dao.worldStates(character.id, "SYNCED_CONTEXT")
                        .filter { ConversationMemoryVisibilityPolicy.visibleWorldState(it, memorySince) }
                        .maxByOrNull { it.updatedAt }?.content.orEmpty()
                } else "",
                syncedPrivateContext = if (threadType == com.aster.companion.domain.ConversationType.GROUP) {
                    participantIds.mapNotNull { cid ->
                        dao.worldStates(cid, "GROUP_SYNCED_PRIVATE")
                            .filter { ConversationMemoryVisibilityPolicy.visibleWorldState(it, memorySince) }
                            .maxByOrNull { it.updatedAt }?.content
                    }
                        .joinToString("\n\n")
                } else "",
                secretContext = if (threadType == com.aster.companion.domain.ConversationType.GROUP &&
                    dao.groupSettings(threadId)?.groupType == "FAMILY"
                ) secretContextFor(character.id, participantIds, modelText, stealthMode = dao.worldStatesByThread(threadId, "STEALTH_MODE").firstOrNull()?.content == "ON") else "",
                rememberedFacts = rememberedFacts,
                recentTranscript = if (LiteProductConfig.ENABLED && threadType == com.aster.companion.domain.ConversationType.PRIVATE) {
                    buildList {
                        // 「更早之前聊过什么」= 滚动摘要。少了这一层，20 条以外的内容等于消失，
                        // 她就会"记得有这回事但细节对不上"。
                        dao.threadSummary(threadId)?.summary?.takeIf { it.isNotBlank() }?.let { summary ->
                            add("（更早之前聊过，摘要）$summary")
                        }
                        addAll(
                            turnHistory
                                .filter { it.id != currentUserMessageId && !it.id.startsWith("stream:") }
                                .takeLast(LiteProductConfig.RECENT_TRANSCRIPT_LIMIT)
                                .map { message ->
                                    val role = if (message.fromUser) "用户" else character.name
                                    val body = message.body.trim().replace(Regex("\\s+"), " ").take(160)
                                    val time = com.aster.companion.lite.memory.LiteTimeFormat.stamp(message.createdAt)
                                    "$role（$time）：$body"
                                }
                                .filter { it.isNotBlank() && !it.endsWith("：") }
                        )
                    }
                } else emptyList(),
                currentTime = if (LiteProductConfig.ENABLED) {
                    java.time.ZonedDateTime.now()
                        .format(java.time.format.DateTimeFormatter.ofPattern("yyyy年M月d日 EEEE HH:mm", java.util.Locale.CHINA))
                } else ""
            )
            val modelUserPrompt = if (threadType == com.aster.companion.domain.ConversationType.GROUP) {
                GroupTranscriptFormatter.replyRequest(
                    responderId = character.id,
                    responderName = character.name,
                    userText = modelText.trim(),
                    transcript = groupTranscript,
                    followUpToCharacterName = followUpToCharacterName,
                    includeTranscript = false
                )
            } else modelText.trim()
            val requestHistory = turnHistory
                .filter { it.id != currentUserMessageId && !it.id.startsWith("stream:") }
                .map { message ->
                    val content = if (threadType == com.aster.companion.domain.ConversationType.GROUP && !message.fromUser) {
                        val speakerName = dao.character(message.characterId.orEmpty())?.name?.trim().orEmpty().ifBlank { "角色" }
                        "$speakerName：${message.body}"
                    } else {
                        message.body
                    }
                    ConversationRequestPolicy.Message(
                        role = if (message.fromUser) "user" else "assistant",
                        content = content
                    )
                }
            val apiKey = cipher.decrypt(requireNotNull(profile.encryptedApiKey))
            var streamingMessageId: String? = null
            var streamedText = ""
            var streamVisibility: Boolean? = null
            // Lite 私聊：一轮用户消息 = 1 次纯文本 chat，不带 tools（计划书 §4.2），历史截断到短窗口。
            val useLiteChat = LiteProductConfig.ENABLED &&
                threadType == com.aster.companion.domain.ConversationType.PRIVATE
            // Lite 私聊：最新 12 条已经以**带时间戳**的形式进了 system（recentTranscript），
            // 这里再整段发一遍就是**重复**——而且两份一边截断一边完整，模型有时会答那半句。
            // 所以 messages 只带更早的那一段，两处合起来正好是 CHAT_HISTORY_LIMIT 条。
            val requestHistoryForSend = requestHistory
                .takeLast(
                    if (useLiteChat) LiteProductConfig.CHAT_HISTORY_LIMIT
                    else LiteProductConfig.CHAT_HISTORY_LIMIT_FULL
                )
                .let { recent ->
                    if (useLiteChat) recent.dropLast(LiteProductConfig.RECENT_TRANSCRIPT_LIMIT) else recent
                }
            suspend fun reportModelFailure(failure: Throwable): Nothing {
                val failureMessage = MessageEntity(
                    UUID.randomUUID().toString(),
                    threadId,
                    null,
                    "模型调用失败：${failure.message ?: "请检查模型设置后重试"}",
                    null,
                    false,
                    System.currentTimeMillis()
                )
                dao.insertMessage(failureMessage)
                timeline.recordMessage(failureMessage)
                throw failure
            }
            suspend fun renderStreamDelta(text: String) {
                streamedText += text
                if (streamVisibility == null) {
                    val firstVisible = streamedText.trimStart().firstOrNull()
                    if (firstVisible != null) streamVisibility = firstVisible != '{' && firstVisible != '`'
                }
                if (streamVisibility == true) {
                    val placeholderId = streamingMessageId ?: "stream:${UUID.randomUUID()}".also { id ->
                        streamingMessageId = id
                        dao.insertMessage(MessageEntity(id, threadId, character.id, "", null, false, System.currentTimeMillis()))
                    }
                    dao.updateMessageBody(placeholderId, streamedText)
                    dao.touchThread(threadId, System.currentTimeMillis())
                }
            }
            val completion: ToolChatResponse = try {
                var completed: ToolChatResponse? = null
                if (useLiteChat) {
                    val accumulated = StringBuilder()
                    client.chatStream(profile, apiKey, prompt, modelUserPrompt, requestHistoryForSend)
                        .collect { delta ->
                            accumulated.append(delta)
                            renderStreamDelta(delta)
                        }
                    val streamed = accumulated.toString().replace(Regex("(?i)\\bnull\\b"), "").trim()
                    completed = ToolChatResponse(streamed.ifBlank { null }, emptyList())
                } else {
                    client.chatWithToolsStream(
                        profile = profile,
                        apiKey = apiKey,
                        systemPrompt = prompt,
                        userPrompt = modelUserPrompt,
                        capabilities = capabilitySnapshot.capabilities,
                        history = requestHistory
                    )
                        .collect { event ->
                            when (event) {
                                is ToolChatStreamEvent.Delta -> renderStreamDelta(event.text)
                                is ToolChatStreamEvent.Complete -> completed = event.response
                            }
                        }
                }
                requireNotNull(completed) { "Stream ended without a completion" }

            } catch (_: Throwable) {
                val incompleteMessageId = streamingMessageId
                if (incompleteMessageId != null) dao.deleteMessage(incompleteMessageId)
                streamingMessageId = null
                if (useLiteChat) {
                    client.chat(profile, apiKey, prompt, modelUserPrompt, history = requestHistoryForSend)
                        .map { reply -> ToolChatResponse(reply, emptyList()) }
                        .getOrElse { failure -> reportModelFailure(failure) }
                } else {
                    client.chatWithTools(
                        profile = profile,
                        apiKey = apiKey,
                        systemPrompt = prompt,
                        userPrompt = modelUserPrompt,
                        capabilities = capabilitySnapshot.capabilities,
                        history = requestHistory
                    )
                        .getOrElse {
                            client.chat(
                                profile = profile,
                                apiKey = apiKey,
                                systemPrompt = prompt,
                                userPrompt = modelUserPrompt,
                                history = requestHistory
                            )
                                .map { reply -> ToolChatResponse(reply, emptyList()) }
                                .getOrElse { failure -> reportModelFailure(failure) }
                        }
                }
            }
            val candidate = completion.content?.trim()?.replace(Regex("(?i)\\bnull\\b"), "")?.trim().orEmpty()
            val plannedReply = candidate.takeIf(String::isNotEmpty)?.let(CompanionReplyPlanParser::parse)
            val modelActions = (completion.actions + plannedReply?.actions.orEmpty())
                .map { action ->
                if (action.capabilityId == "companion.generate_image" || action.capabilityId == "companion.propose_image") {
                    val requirement = ImageConsentPolicy.requirementForModelChoice(directUserPhotoRequest)
                    action.copy(
                        capabilityId = if (requirement == ConfirmationRequirement.REQUIRED) "companion.propose_image" else "companion.generate_image",
                        confirmation = requirement
                    )
                } else action
            }
            val fallbackDeviceAction = (DeviceActionRequestParser.parse(modelText) ?: DeviceContextRequestPolicy.fallbackAction(modelText))
                ?.takeIf { threadType == com.aster.companion.domain.ConversationType.PRIVATE }
                ?.takeIf { requested -> capabilitySnapshot.capabilities.any { available ->
                    available.id == requested.capabilityId && available.transport == requested.transport && available.confirmation == requested.confirmation
                } }
            val validModelActions = modelActions.filter { action ->
                capabilitySnapshot.capabilities.any { capability ->
                    capability.id == action.capabilityId && capability.transport == action.transport && capability.confirmation == action.confirmation
                } && ActionRequestValidator.errorFor(action.capabilityId, action.arguments) == null
            }
            // Image intent and its final English prompt belong to the role model. App fallbacks
            // must never turn a user sentence or a character reply into a renderer prompt.
            val allActions = (validModelActions + listOfNotNull(fallbackDeviceAction)).distinctBy { action ->
                "${action.capabilityId}:${action.transport}:${action.arguments}"
            }
            val validActions = allActions.filter { action ->
                capabilitySnapshot.capabilities.any { capability ->
                    capability.id == action.capabilityId && capability.transport == action.transport && capability.confirmation == action.confirmation
                } && !(threadType == com.aster.companion.domain.ConversationType.GROUP &&
                    (action.capabilityId == "companion.generate_image" || action.capabilityId == "companion.propose_image") &&
                    action.arguments["participant_character_ids"] != null &&
                    GroupImagePromptPolicy.parseParticipantIds(action.arguments["participant_character_ids"], participantIds.toSet()) == null)
            }
            // 图片动作合并：同一轮只保留一个（工具调用动作可能和文本检测动作重复，避免双确认卡）。
            val photoActionsInTurn = validActions.filter {
                it.capabilityId == "companion.generate_image" || it.capabilityId == "companion.propose_image"
            }
            val mergedValidActions = if (photoActionsInTurn.size > 1) {
                val kept = photoActionsInTurn.firstOrNull { !it.arguments["scene"].isNullOrBlank() }
                    ?: photoActionsInTurn.first()
                validActions.filterNot { it.capabilityId == "companion.generate_image" || it.capabilityId == "companion.propose_image" } + kept
            } else validActions
            val needsConfirmation = validActions.firstOrNull { it.confirmation == ConfirmationRequirement.REQUIRED }
            val crossConversationAction = validActions.firstOrNull { action ->
                action.capabilityId == "companion.send_private_message" ||
                    action.capabilityId == "companion.send_group_message"
            }
            val canReadBattery = capabilitySnapshot.capabilities.any { it.id == "device.read_battery" && it.transport == ActionTransport.SHIZUKU }
            val naturalImageReply = if (directUserPhotoRequest || needsConfirmation?.capabilityId == "companion.propose_image") {
                ImageGenerationVisibleReplyPolicy.visibleModelReply(candidate, character.name)
                    ?: naturalImageAcknowledgement(profile, apiKey, character, modelText, photoConversationContext)
            } else null
            val naturalCrossConversationReply = crossConversationAction?.let { action ->
                naturalCrossConversationAcknowledgement(
                    profile = profile,
                    apiKey = apiKey,
                    character = character,
                    currentUserRequest = modelText,
                    recentConversation = photoConversationContext,
                    capabilityId = action.capabilityId
                )
            }
            val rawAnswer = if (DeviceContextRequestPolicy.requestsBattery(modelText) && fallbackDeviceAction != null && canReadBattery) {
                "我看一下你这台手机的真实电量。"
            } else if (directUserPhotoRequest || needsConfirmation?.capabilityId == "companion.propose_image") {
                // 不换掉角色自己这句话：以前 Lite 会另起一次模型调用重写一句"我在整理照片"，
                // 于是同一个位置先说 A、弹出生图卡之后又变成 B（措辞完全不一样）。
                // 现在直接用她这一轮自己说的话（人设和上下文都连贯），
                // 只有它不可用（空白、提到生成/工具/工作流这类内部词）时才退回兜底台词。
                naturalImageReply
                    ?: if (useLiteChat) "好呀，我这就整理一张。" else ImageGenerationVisibleReplyPolicy.FALLBACK_REPLY
            } else if (needsConfirmation != null) {
                pendingActionReply(needsConfirmation)
            } else {
                val visibleCandidate = if (photoGenerationRequested) ImageReplySanitizer.visibleReply(candidate, character.name) else CompanionReplyPlanParser.visibleReply(candidate)
                val crossConversationFallback = crossConversationAction?.let { action ->
                    naturalCrossConversationReply ?: CrossConversationVisibleReplyPolicy.fallback(action.capabilityId)
                }
                plannedReply?.message?.trim()?.takeIf(String::isNotEmpty) ?: visibleCandidate.ifBlank {
                    crossConversationFallback ?: 
                    when {
                        photoGenerationRequested -> "等我一下，拍好就发你。"
                        else -> "这次没有拿到能正常发出的回复。你再发一句，我从这里重新接上。"
                    }
                }
            }
            val answer = RoleplayResponseSanitizer.clean(rawAnswer)
            require(answer.isNotBlank()) { "Model returned an empty reply" }
            val currentThread = dao.thread(threadId)
            if (!ProactiveDeliveryGuard.canDeliver(dao.character(character.id) != null, currentThread != null) ||
                !ConversationContextVersion.isCurrent(contextVersion, currentThread?.contextVersion ?: -1)
            ) continue
            val companionMessage = MessageEntity(UUID.randomUUID().toString(), threadId, character.id, answer, null, false, System.currentTimeMillis())
            streamingMessageId?.let { dao.finalizeStreamingMessage(it, companionMessage) } ?: dao.insertMessage(companionMessage)
            timeline.recordMessage(companionMessage)
            dao.touchThread(threadId, System.currentTimeMillis())
            if (threadType == com.aster.companion.domain.ConversationType.GROUP) {
                turnHistory += companionMessage
                completedSpeakerIds += character.id
            }
            if (threadType == com.aster.companion.domain.ConversationType.GROUP) {
                dao.groupMemberStates(threadId).firstOrNull { it.characterId == character.id }?.let { state ->
                    dao.upsertGroupMemberState(
                        state.copy(
                            attention = (state.attention + 1).coerceAtMost(100),
                            lastSpokeAt = System.currentTimeMillis()
                        )
                    )
                }
            }
            mergedValidActions
                .filter { action -> capabilitySnapshot.capabilities.any { capability ->
                    capability.id == action.capabilityId && capability.transport == action.transport && capability.confirmation == action.confirmation
                } }
                .forEach { action ->
                    val isImageAction = action.capabilityId == "companion.generate_image" || action.capabilityId == "companion.propose_image"
                    val request = if (action.capabilityId == "companion.generate_image" || action.capabilityId == "companion.propose_image") {
                        val imageArguments = action.arguments + mapOf(
                            "character_id" to character.id,
                            "consent_note" to answer,
                            "scene" to PhotoGenerationActionPolicy.contextualizeModelScene(action.arguments["scene"].orEmpty(), emptyList())
                        )
                        action.copy(arguments = if (threadType == com.aster.companion.domain.ConversationType.GROUP) {
                            normalizeGroupImageAction(action, character.id, participantIds, imageArguments)
                                ?.arguments ?: emptyMap()
                        } else imageArguments)
                    } else action
                    if (isImageAction && request.arguments.isEmpty()) return@forEach
                    if (isImageAction) {
                        // 记录角色发的照片内容（角色要知道自己发过什么，避免上下图/对话不一致）
                        val sceneText = request.arguments["scene"]?.trim()?.take(200)
                        if (!sceneText.isNullOrBlank()) {
                            dao.upsertWorldState(
                                com.aster.companion.data.WorldStateEntity(
                                    id = "last-photo:${character.id}",
                                    characterId = character.id,
                                    threadId = threadId,
                                    scope = "LAST_PHOTO",
                                    content = sceneText,
                                    updatedAt = System.currentTimeMillis()
                                )
                            )
                        }
                    }
                    if (isImageAction && threadType == com.aster.companion.domain.ConversationType.GROUP) {
                        deferredGroupImageRequests += DeferredGroupImageRequest(request, character.id)
                    } else {
                        actionCoordinator.submit(null, threadId, request)
                    }
                }
            // Lite：用户要图，或角色自己说要发照片时，弹预览卡（不靠 tools）。
            val companionOffersPhoto = useLiteChat && !directUserPhotoRequest && companionMentionsSendingPhoto(answer)
            // 常开日志：万一漏判，logcat 里能直接看到她**完整**原话和判定结果。
            // 换行要转义，否则 logcat 会把多行回复截成一行，后面几行看不到。
            run {
                val flat = answer.replace("\n", "\\n").take(300)
                val looksLikePhoto = PHOTO_HINT_WORDS.any { answer.contains(it) }
                Log.i(
                    "TongpinLitePhoto",
                    "scan thread=$threadId lite=$useLiteChat direct=$directUserPhotoRequest " +
                        "offers=$companionOffersPhoto hint=$looksLikePhoto text=$flat"
                )
                if (!companionOffersPhoto && looksLikePhoto) {
                    Log.w("TongpinLitePhoto", "near-miss: 像要发图但没命中 -> $flat")
                }
            }
            if (useLiteChat &&
                threadType == com.aster.companion.domain.ConversationType.PRIVATE &&
                (directUserPhotoRequest || companionOffersPhoto) &&
                mergedValidActions.none {
                    it.capabilityId == "companion.generate_image" || it.capabilityId == "companion.propose_image"
                }
            ) {
                // 照片是**她**发的，所以「发什么」由她刚说的那句说了算；用户那句只是起因。
                //
                // 只认用户的话会出这种事故：她明明说了「把刚才那张白金色的长发照片再重新传一遍」，
                // 出图却按用户那句「夸你也要有照片才行」重编一张完全不同的画面 ——
                // 于是「她在对话里说要发的图」和「实际生成的提示词」对不上。
                val herWord = answer.trim().take(200)
                val userWord = modelText.trim().take(120)
                val sceneIntent = when {
                    herWord.isNotEmpty() && directUserPhotoRequest -> "$herWord\n（他想看的是：$userWord）"
                    herWord.isNotEmpty() -> herWord
                    else -> userWord
                }
                Log.i(
                    "TongpinLitePhoto",
                    "detect thread=$threadId character=${character.id} direct=$directUserPhotoRequest " +
                        "offers=$companionOffersPhoto intent=$sceneIntent"
                )
                liteScenePhotoBus.publish(
                    com.aster.companion.lite.ScenePhotoRequest(
                        threadId = threadId,
                        characterId = character.id,
                        intent = sceneIntent,
                        stage = com.aster.companion.lite.ScenePhotoStage.PLANNING
                    )
                )
                // Scene 流水线接手了这次出图：清掉更早那条还挂着「同意/拒绝」的图片动作，
                // 否则一张照片会同时挂两张确认卡。
                runCatching {
                    dao.pendingActionsForThread(threadId)
                        .filter { action ->
                            action.state == "PENDING" &&
                                (action.capabilityId == "companion.propose_image" ||
                                    action.capabilityId == "companion.generate_image")
                        }
                        .forEach { dao.deletePendingAction(it.id) }
                }
                runCatching {
                    // 操作入口只取一次：角色行、对话模型 profile、提示词形态；下游不再各自回查数据库。
                    val sceneInputs = ScenePromptCoordinator.ScenePromptInputs(
                        character = character,
                        conversationProfile = dao.modelProfile(AgentTurnCoordinator.CONVERSATION_MODEL),
                        format = renderPromptBuilder.format()
                    )
                    // 第一步：拍什么由她自己决定（她此刻的状态为主，聊天只作参考）。
                    val shot = scenePromptCoordinator.decideShot(
                        threadId = threadId,
                        characterId = character.id,
                        herOwnWords = sceneIntent,
                        inputs = sceneInputs
                    )
                    Log.i("TongpinLitePhoto", "shot thread=$threadId shot=${shot?.shot} why=${shot?.why}")
                    // 第二步：把她的决定（没决定出来就按她的视角）转成 ComfyUI tag 串。
                    val draft = scenePromptCoordinator.buildTagPromptForThread(
                        threadId = threadId,
                        characterId = character.id,
                        intent = sceneIntent,
                        useBackgroundGate = false,
                        viewpoint = true,
                        wantReason = companionOffersPhoto && shot?.why == null,
                        shot = shot,
                        inputs = sceneInputs
                    ).getOrThrow()
                    val rawAppearance = character.appearancePrompt
                    val sceneFormat = sceneInputs.format
                    val fullPrompt = renderPromptBuilder.compose(draft.prompt, sceneFormat)
                    val anchorWarning = ImageGenerationPromptPolicy.anchorWarning(rawAppearance, sceneFormat)
                    Log.i(
                        "TongpinLitePhoto",
                        "ready thread=$threadId appearance_len=${rawAppearance.length} " +
                            "scene_len=${draft.prompt.length} final_len=${fullPrompt.length} " +
                            "shot=${draft.shot} reason=${draft.reason}"
                    )
                    liteScenePhotoBus.publish(
                        com.aster.companion.lite.ScenePhotoRequest(
                            threadId = threadId,
                            characterId = character.id,
                            intent = sceneIntent,
                            sceneText = draft.prompt,
                            prompt = fullPrompt,
                            shot = draft.shot,
                            reason = draft.reason,
                            stage = com.aster.companion.lite.ScenePhotoStage.READY,
                            attempts = draft.attempts,
                            notes = draft.notes + listOfNotNull(
                                anchorWarning,
                                CharacterIdentityPromptPolicy.identityNote(rawAppearance)
                            )
                        )
                    )
                }.onFailure { error ->
                    Log.w("TongpinLitePhoto", "Lite photo scene failed after chat", error)
                    liteScenePhotoBus.publish(
                        com.aster.companion.lite.ScenePhotoRequest(
                            threadId = threadId,
                            characterId = character.id,
                            intent = sceneIntent,
                            stage = com.aster.companion.lite.ScenePhotoStage.FAILED,
                            error = error.message ?: "画面没整理好"
                        )
                    )
                }
            }
            if (threadType == com.aster.companion.domain.ConversationType.GROUP &&
                groupFollowUpsUsed < groupAtmosphere.maxFollowUps
            ) {
                val nextSpeakerId = selectGroupContinuation(
                    profile = profile,
                    apiKey = apiKey,
                    participantIds = participantIds,
                    previousSpeakerId = character.id,
                    turnHistory = turnHistory,
                    followUpsUsed = groupFollowUpsUsed,
                    maxFollowUps = groupAtmosphere.maxFollowUps
                )
                if (nextSpeakerId != null) {
                    speakerQueue.addLast(nextSpeakerId)
                    groupFollowUpsUsed += 1
                }
            }
        }
        if (threadType == com.aster.companion.domain.ConversationType.GROUP &&
            completedSpeakerIds.isNotEmpty()
        ) {
            val finalImageRequests = groupImageActions(deferredGroupImageRequests, participantIds)
            finalImageRequests.forEach { request ->
                actionCoordinator.submit(null, threadId, request)
            }
        }
        // Short-term history is sent to the gateway as messages. The gateway owns
        // compression, so the app does not create a second generic thread summary.
        // Lite：私聊结束后后台做 L1 压缩（不阻塞本轮回复）。
        if (LiteProductConfig.ENABLED && threadType == com.aster.companion.domain.ConversationType.PRIVATE) {
            val memoryThread = threadId
            GlobalScope.launch(Dispatchers.IO) {
                runCatching { liteMemoryRollup.rollUp(memoryThread) }
                // 会话摘要（滚动压缩）：同一个后台任务里跑，不阻塞回复。
                // 它自带触发门槛（累积够多消息才做），并写进 `companion_thread_summaries`，
                // 下一轮的 Lite system 就会带上这份"更早之前聊过什么"。
                runCatching { conversationSummarizer.summarizeIfNeeded(memoryThread) }
            }
        }
        // 状态同步：世界引擎下线后，改由**本地规则**（不叫模型、零成本、同步完成）把她说过的
        // 状态立刻写进胶囊 —— 你聊天里说的状态，胶囊马上就一致。
        // 原先这里是"对话后世界推演"：它既和自主生活 tick 抢写，又会被空闲让路延后，所以对不上。
        runCatching { syncLivingStateFromConversation(threadId) }
    }

    /**
     * 把"她刚说过的话"里的状态立刻写进时间胶囊。
     *
     * 只认明确说法（"我在浴室，洗澡呢" / "我要睡了"），且**只改该改的字段**：
     * 作息表 `scheduleJson`、她没提到的地点/心情都保持原样。
     */
    private suspend fun syncLivingStateFromConversation(threadId: String) {
        if (!LiteProductConfig.ENABLED) return
        val thread = dao.thread(threadId) ?: return
        if (thread.type != com.aster.companion.domain.ConversationType.PRIVATE) return
        // recentMessages 是**新到旧**：第一条非用户消息就是她刚才那句。
        val lastReply = dao.recentMessages(threadId, 6).firstOrNull { !it.fromUser } ?: return
        val policy = com.aster.companion.agent.life.LifeConversationSyncPolicy
        val hint = policy.parse(lastReply.body) ?: return
        val characterId = lastReply.characterId ?: return
        val previous = dao.livingState(characterId)
        val head = hint.location ?: policy.locationHeadOf(previous?.currentActivity.orEmpty())
        val activity = policy.composeActivity(head, hint.action)
        if (activity == null && hint.mood == null) return
        val now = System.currentTimeMillis()
        dao.upsertLivingState(
            com.aster.companion.data.CharacterLivingStateEntity(
                characterId = characterId,
                mood = hint.mood ?: previous?.mood ?: "平静",
                currentActivity = activity ?: previous?.currentActivity.orEmpty(),
                activityStartedAt = if (activity != null && previous?.currentActivity != activity) {
                    now
                } else {
                    previous?.activityStartedAt?.takeIf { it > 0 } ?: now
                },
                // 她说"要睡了"就给一个 6 小时的睡眠窗口；否则不碰她原有的睡眠状态。
                sleepUntil = if (hint.sleepNow) now + 6 * 60 * 60 * 1000L else previous?.sleepUntil,
                scheduleJson = previous?.scheduleJson.orEmpty(),
                updatedAt = now,
                locationId = previous?.locationId ?: "home.unknown",
                // 依据 = 她的原话：胶囊展开时能看到"这个状态是从哪句话来的"，不再靠猜。
                evidence = lastReply.body.trim().take(60)
            )
        )
        Log.i("TongpinLife", "对话对齐胶囊：$characterId → ${activity.orEmpty()}")
    }

    private fun groupImageActions(
        requests: List<DeferredGroupImageRequest>,
        currentMemberIds: List<String>
    ): List<AgentActionRequest> = GroupImageActionPolicy.normalize(
        requests.mapNotNull { deferred ->
            val arguments = deferred.request.arguments
            val selected = GroupImagePromptPolicy.parseParticipantIds(
                arguments["participant_character_ids"],
                currentMemberIds.toSet()
            ) ?: return@mapNotNull null
            val mode = GroupImagePromptPolicy.resolveMode(arguments["group_image_mode"], selected) ?: return@mapNotNull null
            GroupImageActionPolicy.Proposal(
                requestingCharacterId = arguments["character_id"] ?: deferred.characterId,
                participantCharacterIds = selected,
                mode = mode,
                scene = arguments["scene"].orEmpty()
            )
        },
        currentMemberIds.toSet()
    ).map { proposal ->
        AgentActionRequest(
            capabilityId = "companion.propose_image",
            transport = ActionTransport.LOCAL,
            confirmation = ConfirmationRequirement.REQUIRED,
            arguments = mapOf(
                "character_id" to proposal.requestingCharacterId,
                "participant_character_ids" to proposal.participantCharacterIds.joinToString(","),
                "group_image_mode" to proposal.mode.name,
                "scene" to proposal.scene
            )
        )
    }

    /**
     * A user group turn is deliberately planned in one model request. The model sees every member,
     * the authoritative transcript, and each member's permitted private continuity before it decides
     * who speaks and how the short exchange develops. Persisting the returned plan never causes a
     * second speaker-selection or continuation request.
     */
    private suspend fun handleGroupUserTurn(
        threadId: String,
        participantIds: List<String>,
        profile: com.aster.companion.data.ModelProfileEntity,
        modelText: String,
        capabilitySnapshot: CompanionCapabilitySnapshot,
        now: Long,
        onActiveCharacterChanged: (String?) -> Unit
    ) {
        onActiveCharacterChanged(null)
        val atmosphere = dao.groupSettings(threadId)?.atmosphere ?: com.aster.companion.domain.GroupAtmosphere.DAILY
        val history = dao.recentMessages(threadId, GroupConversationWindow.DEFAULT_MAX_MESSAGES).asReversed()
        val transcript = GroupConversationWindow.forModel(
            history.map { message ->
                GroupTranscriptLine(
                    messageId = message.id,
                    speakerId = message.characterId,
                    speakerName = if (message.fromUser) "User" else dao.character(message.characterId.orEmpty())?.name ?: "Character",
                    isUser = message.fromUser,
                    body = message.body,
                    createdAt = message.createdAt
                )
            }
        ).renderedTranscript
        val members = participantIds.mapNotNull { id -> dao.character(id) }
        require(members.isNotEmpty()) { "Group has no available characters" }
        val continuity = continuityContext.forGroup(threadId, participantIds.toSet(), now)
        val privateContinuity = members.associate { character ->
            character.id to dao.latestPrivateThread(character.id)
                ?.let { privateThread ->
                    GroupPrivateConversationContextPolicy.render(
                        ownerCharacterId = character.id,
                        lines = dao.recentMessages(privateThread.id, PRIVATE_GROUP_CONTEXT_LIMIT)
                            .asReversed()
                            .map { message ->
                                GroupPrivateConversationContextPolicy.Line(
                                    characterId = message.characterId,
                                    fromUser = message.fromUser,
                                    body = message.body
                                )
                            }
                    )
                }
                .orEmpty()
        }
        val apiKey = cipher.decrypt(requireNotNull(profile.encryptedApiKey))
        val planningSystemPrompt = groupBatchPrompt(
                members = members,
                atmosphere = atmosphere,
                capabilitySnapshot = capabilitySnapshot,
                transcript = transcript,
                privateContinuity = privateContinuity,
                continuity = continuity
            )
        val planningUserPrompt = buildString {
                appendLine("Plan the next visible exchange after the latest user message.")
                appendLine("The transcript is authoritative. Do not invent any user or character line.")
                appendLine("AUTHORITATIVE GROUP TRANSCRIPT:")
                append(transcript)
            }
        val rawPlan = client.chat(
            profile = profile,
            apiKey = apiKey,
            systemPrompt = planningSystemPrompt,
            userPrompt = planningUserPrompt
        ).recoverCatching { firstError ->
            Log.w("TongpinGroupTurn", "group_batch_plan_retrying", firstError)
            client.chat(profile, apiKey, planningSystemPrompt, planningUserPrompt).getOrThrow()
        }.getOrElse { error ->
            Log.e("TongpinGroupTurn", "group_batch_plan_failed", error)
            throw IllegalStateException("群聊回复暂时没有生成成功，请再发一次。", error)
        }
        val memberNameToId = characterNameToId(members)
        val fallbackCharacterId = GroupDirectAddressPolicy.questionedMemberId(
            body = modelText,
            previousSpeakerId = "",
            members = members.map { member -> GroupMemberContext(member.id, member.name, member.relationshipPrompt) }
        ) ?: dao.groupMemberStates(threadId)
            .sortedBy { it.lastSpokeAt }
            .map { it.characterId }
            .firstOrNull { it in participantIds }
            ?: participantIds.firstOrNull()
        var plan = GroupBatchReplyPlanParser.parse(
            raw = rawPlan,
            memberIds = participantIds.toSet(),
            atmosphere = atmosphere,
            memberNameToId = memberNameToId,
            fallbackCharacterId = fallbackCharacterId,
            fallbackCharacterIds = participantIds
        )
        if (plan.turns.isEmpty() && fallbackCharacterId != null) {
            plan = GroupBatchReplyPlanParser.plainTextFallback(rawPlan, fallbackCharacterId, atmosphere)
        }
        Log.i(
            "TongpinGroupTurn",
            "user_batch_plan raw_length=${rawPlan.length} turns=${plan.turns.size} speakers=${plan.turns.joinToString(",") { it.characterId }} fallback=${fallbackCharacterId ?: "none"}"
        )
        require(plan.turns.isNotEmpty()) { "Group model returned no valid batch reply plan" }

        val deferredGroupImages = mutableListOf<DeferredGroupImageRequest>()
        val isFamilyGroupTurn = dao.groupSettings(threadId)?.groupType == "FAMILY"
        plan.turns.forEach { turn ->
            val character = requireNotNull(dao.character(turn.characterId)) { "Group member disappeared" }
            onActiveCharacterChanged(character.id)
            val message = RoleplayResponseSanitizer.clean(turn.message)
            if (message.isBlank()) return@forEach
            // 家庭模式禁止角色私聊：大家当面都在，delivery=PRIVATE 一律转为群消息（直接说话）。
            if (turn.delivery == GroupReplyDelivery.PRIVATE && !isFamilyGroupTurn) {
                actionCoordinator.submit(
                    eventId = null,
                    threadId = threadId,
                    request = AgentActionRequest(
                        capabilityId = "companion.send_private_message",
                        transport = ActionTransport.LOCAL,
                        confirmation = ConfirmationRequirement.NONE,
                        arguments = mapOf("character_id" to character.id, "message" to message)
                    )
                )
            } else if (!isRecentPrivateDuplicate(character.id, message)) {
                val companionMessage = MessageEntity(
                    UUID.randomUUID().toString(),
                    threadId,
                    character.id,
                    message,
                    null,
                    false,
                    System.currentTimeMillis()
                )
                dao.insertMessage(companionMessage)
                timeline.recordMessage(companionMessage)
                dao.touchThread(threadId, companionMessage.createdAt)
                dao.groupMemberStates(threadId).firstOrNull { it.characterId == character.id }?.let { state ->
                    dao.upsertGroupMemberState(state.copy(attention = (state.attention + 1).coerceAtMost(100), lastSpokeAt = companionMessage.createdAt))
                }
            } else {
                Log.i("TongpinGroupTurn", "suppressed_group_echo_of_private character=${character.id}")
                return@forEach
            }

            var hasUsablePhotoAction = false
            turn.actions.mapNotNull { planned ->
                if (turn.delivery == GroupReplyDelivery.PRIVATE && planned.capabilityId == "companion.send_private_message") {
                    return@mapNotNull null
                }
                val capability = capabilitySnapshot.capabilities.firstOrNull { it.id == planned.capabilityId } ?: return@mapNotNull null
                val requestedCharacterId = planned.arguments["character_id"]
                    ?.takeIf { it in participantIds }
                    ?: character.id
                AgentActionRequest(
                    capabilityId = capability.id,
                    transport = capability.transport,
                    confirmation = capability.confirmation,
                    arguments = planned.arguments + mapOf("character_id" to requestedCharacterId)
                )
            }.forEach { action ->
                when (action.capabilityId) {
                    "companion.generate_image", "companion.propose_image" -> {
                        val groupAction = normalizeGroupImageAction(
                            action.copy(capabilityId = "companion.propose_image", confirmation = ConfirmationRequirement.REQUIRED),
                            character.id,
                            participantIds,
                            action.arguments + mapOf("scene" to action.arguments["scene"].orEmpty())
                        ) ?: return@forEach
                        deferredGroupImages += DeferredGroupImageRequest(groupAction, character.id)
                        hasUsablePhotoAction = true
                    }
                    "companion.propose_private_image" -> {
                        if (!action.arguments["scene"].isNullOrBlank()) {
                            hasUsablePhotoAction = true
                            actionCoordinator.submit(null, threadId, action)
                        }
                    }
                    else -> actionCoordinator.submit(null, threadId, action)
                }
            }
            if (!hasUsablePhotoAction) {
                val textualProposal = ImageProposalIntentPolicy.fromGroupText(
                    characterId = character.id,
                    characterName = character.name,
                    text = message,
                    members = members.map { member -> GroupImageActionPolicy.MemberRef(member.id, member.name) },
                    contextualScene = "I am ${character.name}. In this current group exchange, I want to send the user the photo I just offered. Current visible offer: ${message.take(520)}"
                )
                textualProposal?.let {
                    deferredGroupImages += DeferredGroupImageRequest(groupImageProposalAction(it), character.id)
                    hasUsablePhotoAction = true
                }
            }
        }
        if (deferredGroupImages.isEmpty()) {
            GroupImageActionPolicy.explicitUserRequest(
                userText = modelText,
                members = members.map { member -> GroupImageActionPolicy.MemberRef(member.id, member.name) },
                fallbackCharacterId = plan.turns.firstOrNull()?.characterId ?: participantIds.firstOrNull()
            )?.let { proposal ->
                deferredGroupImages += DeferredGroupImageRequest(groupImageProposalAction(proposal), proposal.requestingCharacterId)
            }
        }
        groupImageActions(deferredGroupImages, participantIds).forEach { request ->
            actionCoordinator.submit(null, threadId, request)
        }
        onActiveCharacterChanged(null)
    }

    private suspend fun isRecentPrivateDuplicate(characterId: String, groupCandidate: String): Boolean {
        val privateThread = dao.latestPrivateThread(characterId) ?: return false
        val cutoff = System.currentTimeMillis() - PRIVATE_ECHO_DEDUP_WINDOW_MS
        val recentBodies = dao.recentMessages(privateThread.id, PRIVATE_ECHO_DEDUP_MESSAGE_LIMIT)
            .filter { !it.fromUser && it.characterId == characterId && it.createdAt >= cutoff }
            .map { it.body }
        return CrossChatDuplicatePolicy.isRecentDuplicate(groupCandidate, recentBodies)
    }

