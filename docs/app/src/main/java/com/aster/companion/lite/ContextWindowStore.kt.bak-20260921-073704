package com.aster.companion.lite

import android.content.Context
import com.aster.companion.agent.ConversationContextWindowPolicy
import dagger.hilt.android.qualifiers.ApplicationContext
import javax.inject.Inject
import javax.inject.Singleton
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow

/**
 * 「我用的模型上下文有多长」的持久化（默认 16K）。
 *
 * 为什么要有这个开关：App 每轮都是**重新拼一个固定大小的请求**（人设 + 状态 + 最近若干条 + 当前消息），
 * 拼多大必须知道模型能吃多少。用户会在 16K / 32K / 64K 之间换模型，写死任何一个档位都不对：
 * - 写 64K：换成 16K 的本地小模型时直接超上下文（服务端从中间截，砍掉的正好是记忆）；
 * - 写 16K：换成 64K 的模型时白白浪费一大截窗口、她记不住更早的对话。
 *
 * 只存 token 数，预算（字符）由 [ConversationContextWindowPolicy] 算。
 */
@Singleton
class ContextWindowStore @Inject constructor(@ApplicationContext context: Context) {
    private val preferences = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)

    private val _contextTokens = MutableStateFlow(read())

    val contextTokens: StateFlow<Int> = _contextTokens

    fun set(contextTokens: Int) {
        val normalized = ConversationContextWindowPolicy.normalize(contextTokens)
        preferences.edit().putInt(KEY, normalized).apply()
        _contextTokens.value = normalized
    }

    private fun read(): Int =
        ConversationContextWindowPolicy.normalize(
            preferences.getInt(KEY, ConversationContextWindowPolicy.DEFAULT_CONTEXT_TOKENS)
        )

    private companion object {
        const val PREFS = "tongpin_context_window"
        const val KEY = "context_tokens"
    }
}
